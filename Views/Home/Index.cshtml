@{
    ViewBag.Title = "Trang chủ - TourWorld";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;500;800&family=Playfair+Display:ital,wght@1,600&family=Nunito:wght@400;600;800&family=Quicksand:wght@500;700&display=swap" rel="stylesheet">

<style>
    /* === GLOBAL VARIABLES === */
    :root {
        --bg-main: #F9F7F2;
        --text-color: #4E342E;
        --prim-color: #2E7D32;   /* Xanh lá chủ đạo */
        --kruskal-color: #D84315; /* Cam đất */
        --accent-gold: #FBC02D;   /* Vàng */
        --glass-white: rgba(255, 255, 255, 0.85);
        --shadow-soft: 0 15px 40px rgba(78, 52, 46, 0.08);
        --border-radius-lg: 24px;
    }

    body {
        font-family: 'Nunito', sans-serif;
        color: var(--text-color);
        background-color: var(--bg-main);
        overflow-x: hidden;
    }

    /* === 1. HERO SECTION ĐỘT PHÁ (INTERACTIVE NETWORK) === */
    .hero-breakthrough {
        position: relative;
        height: 100vh;
        width: 100%;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #000;
    }

    .hero-bg-video {
        position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        object-fit: cover;
        opacity: 0.6; /* Làm tối nền để nổi bật mạng lưới */
        z-index: 1;
    }

    #networkCanvas {
        position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        z-index: 2; /* Nằm trên video */
        pointer-events: none; /* Để chuột vẫn click được nút */
    }

    .hero-content-box {
        position: relative; z-index: 3;
        text-align: center; color: #fff;
        max-width: 1000px;
        padding: 60px 40px;
        background: rgba(255, 255, 255, 0.05); /* Kính mờ siêu nhẹ */
        backdrop-filter: blur(5px);
        border-radius: 30px;
        border: 1px solid rgba(255,255,255,0.1);
        box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    }

    .hero-big-text {
        font-family: 'Outfit', sans-serif;
        font-size: clamp(2.5rem, 5vw, 5rem);
        font-weight: 800; line-height: 1.1;
        margin-bottom: 20px; text-transform: uppercase; letter-spacing: -2px;
        color: white;
    }

    .hero-highlight {
        font-family: 'Playfair Display', serif; font-style: italic;
        color: #4CAF50; /* Màu xanh nổi bật */
        font-weight: 400;
    }

    .hero-desc {
        font-size: 1.2rem; color: rgba(255,255,255,0.9);
        margin-bottom: 40px; font-weight: 300; letter-spacing: 0.5px;
    }

    .btn-hero-tech {
        padding: 18px 45px; font-size: 1rem; font-weight: 700; color: #fff;
        background: transparent; border: 1px solid rgba(255,255,255,0.3);
        border-radius: 100px; cursor: pointer; position: relative; overflow: hidden;
        transition: 0.4s; text-decoration: none; display: inline-flex; align-items: center; gap: 10px;
        text-transform: uppercase; letter-spacing: 2px;
    }
    .btn-hero-tech::before {
        content: ''; position: absolute; top: 0; left: 0; width: 0%; height: 100%;
        background: var(--prim-color); transition: 0.4s cubic-bezier(0.19, 1, 0.22, 1); z-index: -1;
    }
    .btn-hero-tech:hover { border-color: var(--prim-color); color: white; }
    .btn-hero-tech:hover::before { width: 100%; }

    /* Hiệu ứng cuộn chuột */
    .mouse-scroll {
        position: absolute; bottom: 30px; left: 50%; transform: translateX(-50%); z-index: 3;
        width: 30px; height: 50px; border: 2px solid rgba(255,255,255,0.3); border-radius: 20px;
    }
    .mouse-scroll::before {
        content: ''; position: absolute; top: 10px; left: 50%; transform: translateX(-50%);
        width: 6px; height: 6px; background: #fff; border-radius: 50%; animation: scrollWheel 2s infinite;
    }
    @@keyframes scrollWheel { 0% {top: 10px; opacity: 1;} 100% {top: 30px; opacity: 0;} }


    /* === 2. CÁC STYLE KHÁC (GIỮ NGUYÊN TỪ BẢN ĐẸP) === */
    .section-header { text-align: center; margin-bottom: 60px; }
    .section-subtitle { font-family: 'Playfair Display', serif; font-style: italic; font-size: 1.5rem; color: var(--kruskal-color); margin-bottom: 10px; display: block; }
    .section-title {
        font-family: 'Quicksand', sans-serif; font-weight: 800; font-size: 2.5rem;
        color: var(--text-color); position: relative; display: inline-block;
    }
    .section-title::after {
        content: ''; display: block; width: 80px; height: 6px; background: var(--prim-color);
        margin: 15px auto 0; border-radius: 10px;
    }

    /* Process Steps */
    .process-section { padding: 80px 0; background: white; }
    .step-card {
        text-align: center; padding: 30px; border-radius: var(--border-radius-lg);
        background: var(--bg-main); transition: 0.3s; height: 100%; border: 1px dashed #ccc;
    }
    .step-card:hover { transform: translateY(-10px); border-style: solid; border-color: var(--prim-color); box-shadow: var(--shadow-soft); }
    .step-number {
        width: 50px; height: 50px; line-height: 50px; background: var(--prim-color); color: white;
        border-radius: 50%; font-weight: bold; font-size: 1.2rem; margin: 0 auto 20px;
    }
    .step-icon { font-size: 3rem; color: var(--kruskal-color); margin-bottom: 15px; }

    /* Intro Cards */
    .intro-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 30px; }
    .intro-card {
        background: var(--glass-white); backdrop-filter: blur(10px);
        border-radius: var(--border-radius-lg); padding: 30px;
        box-shadow: var(--shadow-soft); border: 1px solid rgba(255,255,255,0.6); transition: 0.4s;
    }
    .intro-card:hover { transform: translateY(-10px); border-color: var(--prim-color); background: white; }
    .intro-card img { width: 100%; height: 220px; object-fit: cover; border-radius: 15px; margin-bottom: 20px; }
    .btn-card { display: inline-block; padding: 10px 25px; border-radius: 30px; font-weight: 700; margin-top: 15px; text-decoration: none; transition: 0.3s; }
    .btn-prim { background: #E8F5E9; color: var(--prim-color); } .btn-prim:hover { background: var(--prim-color); color: white; }
    .btn-kruskal { background: #FBE9E7; color: var(--kruskal-color); } .btn-kruskal:hover { background: var(--kruskal-color); color: white; }
    .btn-app { background: #E3F2FD; color: #1565C0; } .btn-app:hover { background: #1565C0; color: white; }

    /* Gallery */
    .gallery-section { padding: 80px 0; }
    .gallery-grid { display: grid; grid-template-columns: repeat(4, 1fr); grid-template-rows: repeat(2, 200px); gap: 15px; }
    .gallery-item { position: relative; overflow: hidden; border-radius: 15px; cursor: pointer; }
    .gallery-item img { width: 100%; height: 100%; object-fit: cover; transition: 0.5s; }
    .gallery-item:hover img { transform: scale(1.1); }
    .g-item-1 { grid-column: 1 / 3; grid-row: 1 / 3; height: 100%; }
    .g-item-2 { grid-column: 3 / 4; grid-row: 1 / 2; }
    .g-item-3 { grid-column: 4 / 5; grid-row: 1 / 2; }
    .g-item-4 { grid-column: 3 / 5; grid-row: 2 / 3; }
    @@media (max-width: 768px) { .gallery-grid { grid-template-columns: 1fr 1fr; grid-template-rows: auto; } .g-item-1, .g-item-2, .g-item-3, .g-item-4 { grid-column: auto; grid-row: auto; height: 250px; } }

    /* Testimonials & Newsletter */
    .testimonials { background: #F1F8E9; padding: 80px 0; }
    .testi-card { background: white; padding: 30px; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); position: relative; }
    .testi-card::before { content: '\201C'; font-size: 4rem; color: var(--prim-color); opacity: 0.2; position: absolute; top: 10px; left: 20px; font-family: serif; }
    .user-avatar { width: 60px; height: 60px; border-radius: 50%; object-fit: cover; margin-right: 15px; }
    .newsletter { background: linear-gradient(135deg, var(--text-color), #2d1e1a); color: white; padding: 60px 0; border-radius: 30px; margin: 50px auto; width: 90%; }
    .input-newsletter { border-radius: 50px 0 0 50px; border: none; padding: 15px 25px; outline: none; width: 60%; }
    .btn-newsletter { border-radius: 0 50px 50px 0; background: var(--accent-gold); border: none; padding: 15px 30px; color: var(--text-color); font-weight: bold; }
</style>

<section class="hero-breakthrough" id="homeHero">
