@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TourWorld - The Essence of Nature</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,600;1,600&family=Montserrat:wght@200;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* =========================================
           1. CẤU HÌNH CƠ BẢN
           ========================================= */
        :root {
            --text-primary: #F2F0E9;
            --accent-gold: #D4AF37;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            height: 100vh; width: 100vw; overflow: hidden;
            background-color: #0a0a0a;
            font-family: 'Montserrat', sans-serif;
            color: var(--text-primary);
            cursor: default; /* Trả lại chuột bình thường cho dễ dùng */
        }

        /* =========================================
           2. CÁC LỚP NỀN (LAYERS)
           ========================================= */
        .wrapper {
            position: relative; width: 100%; height: 100%;
            overflow: hidden;
            perspective: 1000px;
        }

        /* Lớp nhiễu hạt (Noise) - Giữ lại để tạo độ "phim" */
        .noise-overlay {
            position: fixed; inset: 0; pointer-events: none; z-index: 999; opacity: 0.06;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
        }

        /* Ảnh nền */
        .bg-layer {
            position: absolute; top: -10%; left: -10%; width: 120%; height: 120%;
            /* Ảnh rừng thông Đà Lạt chill hơn */
            background: url('https://images.unsplash.com/photo-1542273917363-3b1817f69a2d?q=80&w=2074&auto=format&fit=crop') no-repeat center center/cover;
            /* Chỉnh độ sáng: 0.7 là vừa (không quá tối, không quá chói) */
            filter: brightness(0.7) contrast(1.1);
            will-change: transform;
        }

        /* Vignette tĩnh: Chỉ tối 4 góc để tập trung vào giữa, không tối thui */
        .vignette {
            position: absolute; inset: 0;
            background: radial-gradient(circle, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.8) 100%);
            z-index: 2; pointer-events: none;
        }

        /* Canvas hạt bụi vàng */
        #nature-canvas {
            position: absolute; inset: 0; z-index: 3; pointer-events: none;
        }

        /* =========================================
           3. GIAO DIỆN (UI)
           ========================================= */
        .content-wrapper {
            position: absolute; top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            z-index: 10; text-align: center;
            width: 100%; max-width: 1200px;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            will-change: transform;
            /* Text Shadow nhẹ để chữ nổi trên nền */
            text-shadow: 0 4px 20px rgba(0,0,0,0.5);
        }

        .brand-logo {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(4rem, 8vw, 9rem);
            font-weight: 600; line-height: 0.9;
            color: var(--text-primary); margin-bottom: 1rem;
            position: relative; overflow: hidden;
        }

        .brand-logo .char { display: inline-block; transform: translateY(100%); opacity: 0; }
        .brand-logo span.italic { font-style: italic; color: #A8C69F; font-weight: 300; }

        .slogan {
            font-size: clamp(0.8rem, 1.5vw, 1.2rem); letter-spacing: 0.3em;
            text-transform: uppercase; color: rgba(242, 240, 233, 0.9);
            margin-bottom: 4rem; opacity: 0;
        }

        /* Nút bấm (Giữ hiệu ứng nam châm vì nó đẹp) */
        .btn-container {
            position: relative; display: inline-block; opacity: 0;
        }

        .explore-btn {
            position: relative; display: inline-flex; align-items: center; justify-content: center;
            padding: 20px 60px; border: 1px solid rgba(255,255,255,0.4);
            border-radius: 100px; color: #fff; text-decoration: none;
            font-size: 0.85rem; font-weight: 600; letter-spacing: 2px;
            text-transform: uppercase; background: rgba(255,255,255,0.1);
            backdrop-filter: blur(5px); overflow: hidden;
            transition: all 0.4s ease;
        }

        .explore-btn:hover { background: #fff; color: #000; border-color: #fff; box-shadow: 0 0 30px rgba(255,255,255,0.3); }
        .explore-btn .icon { margin-left: 10px; transition: transform 0.3s; }
        .explore-btn:hover .icon { transform: translateX(5px); }

        /* Màn hình loading & Chuyển trang */
        .loader {
            position: fixed; bottom: 40px; right: 40px;
            display: flex; align-items: center; gap: 10px;
            font-family: 'Montserrat', sans-serif;
            font-size: 0.7rem; letter-spacing: 2px; color: rgba(255,255,255,0.6);
            z-index: 20;
        }
        .loader-line {
            width: 40px; height: 1px; background: rgba(255,255,255,0.2);
            position: relative; overflow: hidden;
        }
        .loader-line::after {
            content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: #fff; animation: loading 2s ease-in-out infinite;
        }
        @@keyframes loading { 0% { transform: translateX(-100%); } 50% { transform: translateX(100%); } 100% { transform: translateX(100%); } }

        .transition-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: #000; z-index: 9999; transform: scaleY(0); transform-origin: bottom; pointer-events: none;
        }

        /* Thông báo nhỏ về âm thanh */
        .click-hint {
            position: fixed; bottom: 40px; left: 50%; transform: translateX(-50%);
            font-size: 0.7rem; color: rgba(255,255,255,0.4); letter-spacing: 1px;
            animation: pulse 2s infinite; pointer-events: none;
        }
        @@keyframes pulse { 0%, 100% { opacity: 0.4; } 50% { opacity: 0.8; } }

    </style>
</head>
<body>

    <audio id="bgMusic" loop>
        <source src="https://cdn.pixabay.com/download/audio/2022/05/27/audio_1808fbf07a.mp3" type="audio/mpeg">
    </audio>

    <div class="noise-overlay"></div>
    <div class="transition-overlay"></div>
    <div class="vignette"></div>

    <div class="wrapper" id="sceneWrapper">
        <div class="bg-layer" id="bgLayer"></div>
        <canvas id="nature-canvas"></canvas>

        <div class="content-wrapper" id="tiltCard">
            <h1 class="brand-logo" id="logoText">
                Tour<span class="italic">World</span>
            </h1>
            <p class="slogan">The Essence of Nature</p>

            <div class="btn-container" id="magneticBtn">
                <a href="#" class="explore-btn" id="enterLink">
                    Khám phá ngay <i class="fa-solid fa-arrow-right icon"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="click-hint">CLICK BẤT KỲ ĐÂU ĐỂ BẬT NHẠC</div>

    <div class="loader">
        <span>LOADING SCENE</span>
        <div class="loader-line"></div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>

    <script>
        /* =========================================
           1. XỬ LÝ NHẠC (QUAN TRỌNG)
           ========================================= */
        const audio = document.getElementById('bgMusic');
        const hint = document.querySelector('.click-hint');

        // Hàm thử phát nhạc
        function tryPlayMusic() {
            audio.volume = 0.5;
            const playPromise = audio.play();

            if (playPromise !== undefined) {
                playPromise.then(_ => {
                    // Nếu phát thành công -> Ẩn dòng chữ nhắc nhở
                    gsap.to(hint, { opacity: 0, duration: 0.5 });
                })
                .catch(error => {
                    // Nếu trình duyệt chặn -> Chờ click đầu tiên
                    console.log("Auto-play blocked by browser. Waiting for interaction.");
                });
            }
        }

        // Kích hoạt ngay khi tải
        window.addEventListener('load', tryPlayMusic);

        // Kích hoạt chắc chắn khi người dùng click bất kỳ đâu
        document.addEventListener('click', () => {
            audio.play();
            gsap.to(hint, { opacity: 0, duration: 0.5 });
        }, { once: true }); // Chỉ chạy 1 lần

        /* =========================================
           2. ANIMATION CHỮ & INTRO
           ========================================= */
        const logo = document.getElementById('logoText');

        // Tách chữ để diễn hoạt
        const splitText = (element) => {
            element.innerHTML = `<span class="char-wrapper" style="display:inline-block; overflow:hidden"><span class="char">T</span></span>` +
                                `<span class="char-wrapper" style="display:inline-block; overflow:hidden"><span class="char">o</span></span>` +
                                `<span class="char-wrapper" style="display:inline-block; overflow:hidden"><span class="char">u</span></span>` +
                                `<span class="char-wrapper" style="display:inline-block; overflow:hidden"><span class="char">r</span></span>` +
                                `<span class="italic" style="display:inline-block; overflow:hidden"><span class="char" style="display:inline-block">W</span><span class="char" style="display:inline-block">o</span><span class="char" style="display:inline-block">r</span><span class="char" style="display:inline-block">l</span><span class="char" style="display:inline-block">d</span></span>`;
        };
        splitText(logo);

        window.onload = () => {
            const tl = gsap.timeline();

            // Text trồi lên
            tl.to('.char', {
                y: 0, opacity: 1, duration: 1.5, stagger: 0.05, ease: "power4.out"
            })
            // Slogan hiện ra
            .to('.slogan', {
                y: 0, opacity: 1, duration: 1, ease: "power2.out"
            }, "-=1")
            // Nút hiện ra
            .to('.btn-container', {
                y: 0, opacity: 1, duration: 1, ease: "power2.out"
            }, "-=0.8")
            // Background zoom nhẹ
            .fromTo('#bgLayer',
                { scale: 1.1 },
                { scale: 1, duration: 3, ease: "power2.out" },
                "<"
            );

            // Gọi lại hàm nhạc lần nữa cho chắc
            tryPlayMusic();
        };

        /* =========================================
           3. PARALLAX (Hiệu ứng di chuyển nền)
           ========================================= */
        const bg = document.getElementById('bgLayer');
        const card = document.getElementById('tiltCard');

        let mouse = { x: 0, y: 0 };
        let current = { x: 0, y: 0 };

        window.addEventListener('mousemove', (e) => {
            mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
            mouse.y = (e.clientY / window.innerHeight) * 2 - 1;
        });

        const tick = () => {
            // Làm mượt chuyển động
            current.x += (mouse.x - current.x) * 0.05;
            current.y += (mouse.y - current.y) * 0.05;

            // Di chuyển nền ngược chiều chuột
            bg.style.transform = `translate(${current.x * -20}px, ${current.y * -20}px)`;

            // Nghiêng chữ 3D nhẹ
            card.style.transform = `translate(-50%, -50%) perspective(1000px) rotateY(${current.x * 5}deg) rotateX(${current.y * -5}deg)`;

            requestAnimationFrame(tick);
        };
        tick();

        /* =========================================
           4. NÚT NAM CHÂM (MAGNETIC BUTTON)
           ========================================= */
        const btnContainer = document.getElementById('magneticBtn');
        const btn = btnContainer.querySelector('.explore-btn');

        btnContainer.addEventListener('mousemove', (e) => {
            const rect = btnContainer.getBoundingClientRect();
            const x = e.clientX - rect.left - rect.width / 2;
            const y = e.clientY - rect.top - rect.height / 2;

            gsap.to(btn, { x: x * 0.3, y: y * 0.3, duration: 0.3, ease: "power2.out" });
        });

        btnContainer.addEventListener('mouseleave', () => {
            gsap.to(btn, { x: 0, y: 0, duration: 0.5, ease: "elastic.out(1, 0.3)" });
        });

        /* =========================================
           5. HẠT BỤI VÀNG (PARTICLES)
           ========================================= */
        const canvas = document.getElementById('nature-canvas');
        const ctx = canvas.getContext('2d');
        let width, height;

        const resize = () => { width = window.innerWidth; height = window.innerHeight; canvas.width = width; canvas.height = height; };
        window.addEventListener('resize', resize);
        resize();

        class Particle {
            constructor() { this.init(); }
            init() {
                this.x = Math.random() * width; this.y = Math.random() * height;
                this.size = Math.random() * 2; this.speedY = Math.random() * 0.5 + 0.2;
                this.opacity = Math.random() * 0.5 + 0.2; this.fadeDir = 0.005;
            }
            update() {
                this.y -= this.speedY; this.opacity += this.fadeDir;
                if(this.opacity > 0.8 || this.opacity < 0.1) this.fadeDir = -this.fadeDir;
                this.x += (current.x * 2); // Parallax theo chuột
                if(this.y < 0) this.init();
            }
            draw() {
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fillStyle = `rgba(255, 230, 150, ${this.opacity})`; // Màu vàng ấm hơn
                ctx.fill();
            }
        }
        const particles = Array.from({ length: 40 }, () => new Particle());
        const animateCanvas = () => {
            ctx.clearRect(0, 0, width, height);
            particles.forEach(p => { p.update(); p.draw(); });
            requestAnimationFrame(animateCanvas);
        };
        animateCanvas();

        /* =========================================
           6. CHUYỂN TRANG
           ========================================= */
        document.getElementById('enterLink').addEventListener('click', (e) => {
            e.preventDefault();

            // Fade out nhạc
            gsap.to(audio, { volume: 0, duration: 1 });

            // Màn trập đen kéo lên
            gsap.to('.transition-overlay', {
                scaleY: 1, transformOrigin: 'bottom', duration: 0.8, ease: "power4.inOut",
                onComplete: () => { window.location.href = '@Url.Action("Index", "Home")'; }
            });
        });

    </script>
</body>
</html>