@{
    ViewBag.Title = "Algorithm Arena - Academic Mode";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500;600&family=Fira+Code:wght@500&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

<style>
    :root {
        /* EARTH TONES PALETTE */
        --bg-body: #F9F7F2; /* Trắng gạo / Rice White */
        --card-bg: #FFFFFF; /* Trắng tinh */
        --text-primary: #3E2723; /* Nâu đậm / Espresso */
        --text-secondary: #795548; /* Nâu nhạt / Earth */
        --accent-1: #D84315; /* Đỏ gạch / Terracotta (Đại diện Pathfinding) */
        --accent-2: #2E7D32; /* Xanh rêu / Sage Green (Đại diện MST) */
        --accent-3: #F9A825; /* Vàng nghệ / Gold (Highlight) */
        --border-color: #D7CCC8; /* Viền nâu nhạt */
        --shadow: 0 4px 20px rgba(62, 39, 35, 0.08);
    }

    body {
        background-color: var(--bg-body);
        color: var(--text-primary);
        font-family: 'Inter', sans-serif;
        margin: 0;
        padding: 0;
    }

    /* === HEADER === */
    .arena-header {
        text-align: center;
        padding: 40px 0 20px 0;
    }

    .brand-title {
        font-family: 'Playfair Display', serif;
        font-size: 2.5rem;
        color: var(--text-primary);
        letter-spacing: -0.5px;
    }

    .brand-subtitle {
        color: var(--text-secondary);
        font-size: 0.9rem;
        margin-top: 5px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* === MAIN LAYOUT === */
    .arena-container {
        display: grid;
        grid-template-columns: 1fr 1fr; /* Chia đôi màn hình */
        gap: 30px;
        max-width: 1600px;
        margin: 0 auto;
        padding: 0 40px 120px 40px;
    }

    /* === ALGO CARD === */
    .algo-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 20px;
        box-shadow: var(--shadow);
        transition: transform 0.3s ease;
        position: relative;
    }

    .card-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
        border-bottom: 2px solid var(--bg-body);
        padding-bottom: 15px;
    }

    .algo-select {
        border: 1px solid var(--border-color);
        padding: 8px 12px;
        border-radius: 8px;
        font-family: 'Inter';
        font-weight: 600;
        color: var(--text-primary);
        background: var(--bg-body);
        cursor: pointer;
        min-width: 200px;
    }

    /* CANVAS MONITOR */
    .monitor-frame {
        background: #F0F0F0;
        border-radius: 12px;
        overflow: hidden;
        aspect-ratio: 1;
        position: relative;
        border: 1px solid var(--border-color);
    }

    canvas {
        width: 100%;
        height: 100%;
        display: block;
        image-rendering: pixelated;
    }

    /* STATS & INFO */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        margin-top: 15px;
    }

    .stat-item {
        background: var(--bg-body);
        padding: 10px;
        border-radius: 8px;
        text-align: center;
    }

    .stat-val {
        font-family: 'Fira Code', monospace;
        font-weight: 700;
        color: var(--text-primary);
    }

    .stat-lbl {
        font-size: 0.7rem;
        color: var(--text-secondary);
        text-transform: uppercase;
        margin-top: 4px;
    }

    /* ACADEMIC INFO PANEL (NEW) */
    .academic-panel {
        margin-top: 15px;
        background: #FAF8F5; /* Paper color */
        padding: 15px;
        border-radius: 8px;
        border-left: 4px solid var(--text-secondary);
        font-size: 0.85rem;
        height: 300px;
        overflow-y: auto;
        line-height: 1.6;
    }

        .academic-panel h4 {
            margin: 0 0 5px 0;
            color: var(--accent-1);
            font-family: 'Playfair Display';
        }

        .academic-panel table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        .academic-panel th {
            text-align: left;
            border-bottom: 1px solid var(--border-color);
            color: var(--text-primary);
            font-size: 0.75rem;
        }

        .academic-panel td {
            padding: 4px 0;
            color: var(--text-secondary);
        }

    /* === CONTROL BAR === */
    .control-bar {
        position: fixed;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        padding: 15px 40px;
        border-radius: 50px;
        box-shadow: 0 10px 40px rgba(62, 39, 35, 0.15);
        border: 1px solid var(--border-color);
        display: flex;
        gap: 40px;
        align-items: center;
        z-index: 100;
    }

    .btn-earth {
        background: var(--text-primary);
        color: white;
        border: none;
        padding: 14px 40px;
        border-radius: 30px;
        font-weight: 600;
        letter-spacing: 1px;
        cursor: pointer;
        transition: 0.2s;
        box-shadow: 0 4px 15px rgba(62, 39, 35, 0.3);
    }

        .btn-earth:hover {
            transform: translateY(-2px);
            background: #5D4037;
        }

        .btn-earth:disabled {
            background: #BCAAA4;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

    /* WINNER BADGE */
    .win-badge {
        position: absolute;
        top: 20px;
        right: 20px;
        background: var(--accent-3);
        color: var(--text-primary);
        padding: 5px 15px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.8rem;
        opacity: 0;
        transform: scale(0.8);
        transition: 0.4s;
    }

    .winner .win-badge {
        opacity: 1;
        transform: scale(1);
    }

    .winner {
        border-color: var(--accent-3);
        box-shadow: 0 0 0 2px var(--accent-3);
    }
</style>

<div class="arena-header">
    <div class="brand-title">Thuật Toán Đối Kháng</div>
    <div class="brand-subtitle">Phân tích Hiệu năng & Đặc tính Kỹ thuật</div>
</div>

<div class="arena-container">
    <div class="algo-card" id="cardLeft">
        <div class="win-badge">CHIẾN THẮNG</div>
        <div class="card-head">
            <span style="font-weight:700; color:var(--text-secondary)">ĐẤU THỦ 1</span>
            <select id="leftAlgo" class="algo-select" onchange="updateInfo('left')">
                <optgroup label="Cây khung (MST)">
                    <option value="Prim">Prim (Dense)</option>
                    <option value="Kruskal">Kruskal (Sparse)</option>
                </optgroup>
                <optgroup label="Tìm đường (Pathfinding)">
                    <option value="Dijkstra">Dijkstra (Uniform Cost)</option>
                    <option value="AStar">A* (Heuristic)</option>
                </optgroup>
                <optgroup label="Tham lam (Greedy Variants)">
                    <option value="GreedyBestFirst">Greedy Best-First (Euclidean)</option>
                    <option value="GreedyManhattan">Greedy Best-First (Manhattan)</option>
                    <option value="GreedyChebyshev">Greedy (Chebyshev)</option>
                </optgroup>
            </select>
        </div>

        <div class="monitor-frame">
            <canvas id="canvasLeft"></canvas>
        </div>

        <div class="stats-grid">
            <div class="stat-item"><div class="stat-val" id="visLeft">0</div><div class="stat-lbl">Đỉnh đã duyệt</div></div>
            <div class="stat-item"><div class="stat-val" id="costLeft">0</div><div class="stat-lbl">Chi phí (Cost)</div></div>
            <div class="stat-item"><div class="stat-val" id="timeLeft" style="color:var(--accent-1)">0ms</div><div class="stat-lbl">Thời gian thực</div></div>
        </div>

        <div class="academic-panel markdown-body" id="descLeft">
        </div>
    </div>

    <div class="algo-card" id="cardRight">
        <div class="win-badge">CHIẾN THẮNG</div>
        <div class="card-head">
            <span style="font-weight:700; color:var(--text-secondary)">ĐẤU THỦ 2</span>
            <select id="rightAlgo" class="algo-select" onchange="updateInfo('right')">
                <option value="AStar" selected>A* (Heuristic)</option>
                <option value="Dijkstra">Dijkstra</option>
                <option value="Prim">Prim</option>
                <option value="Kruskal">Kruskal</option>
                <option value="GreedyBestFirst">Greedy Best-First</option>
                <option value="GreedyManhattan">Greedy (Manhattan)</option>
                <option value="GreedyChebyshev">Greedy (Chebyshev)</option>
            </select>
        </div>

        <div class="monitor-frame">
            <canvas id="canvasRight"></canvas>
        </div>

        <div class="stats-grid">
            <div class="stat-item"><div class="stat-val" id="visRight">0</div><div class="stat-lbl">Đỉnh đã duyệt</div></div>
            <div class="stat-item"><div class="stat-val" id="costRight">0</div><div class="stat-lbl">Chi phí (Cost)</div></div>
            <div class="stat-item"><div class="stat-val" id="timeRight" style="color:var(--accent-1)">0ms</div><div class="stat-lbl">Thời gian thực</div></div>
        </div>

        <div class="academic-panel markdown-body" id="descRight">
        </div>
    </div>
</div>

<div class="control-bar">
    <div>
        <div class="stat-lbl">Kích thước lưới</div>
        <input type="range" id="sizeRange" min="20" max="80" value="40" style="accent-color:var(--text-primary)">
        <span id="sizeDisplay" style="font-weight:bold; margin-left:10px">40x40</span>
    </div>

    <div>
        <div class="stat-lbl">Mật độ chướng ngại</div>
        <select id="densityMode" style="border:none; background:transparent; font-weight:bold; color:var(--text-primary); outline:none">
            <option value="sparse">Thưa (Sparse)</option>
            <option value="fair" selected>Trung bình (Fair)</option>
            <option value="dense">Dày đặc (Dense)</option>
        </select>
    </div>

    <button id="btnRun" class="btn-earth">
        <i class="fas fa-play"></i> CHẠY SO SÁNH
    </button>
</div>

<script>
    // --- DATABASE KIẾN THỨC HỌC THUẬT ---
    const ALGO_DB = {
        'Prim': {
            name: "Prim's Algorithm",
            desc: "Thuật toán tham lam tìm cây khung nhỏ nhất (MST). Phát triển từ một đỉnh khởi tạo giống như 'vết dầu loang'.",
            complexity: "O(V²) hoặc O(E log V)",
            pros: "Tối ưu cho đồ thị dày (Dense). Luôn tìm ra MST chính xác.",
            cons: "Chậm trên đồ thị thưa nếu dùng Matrix. Khó cài đặt phân tán.",
            type: "MST"
        },
        'Kruskal': {
            name: "Kruskal's Algorithm",
            desc: "Thuật toán tham lam dựa trên cạnh. Sắp xếp tất cả cạnh và nối các cây con rời rạc lại.",
            complexity: "O(E log E)",
            pros: "Tối ưu cho đồ thị thưa (Sparse). Dễ cài đặt với Union-Find.",
            cons: "Chậm trên đồ thị dày do bước sắp xếp cạnh.",
            type: "MST"
        },
        'Dijkstra': {
            name: "Dijkstra",
            desc: "Thuật toán tìm đường đi ngắn nhất từ một nguồn. Quét đều ra mọi hướng (như đường tròn).",
            complexity: "O((V+E) log V)",
            pros: "Đảm bảo đường đi ngắn nhất tuyệt đối. Xử lý tốt mọi trọng số dương.",
            cons: "Lãng phí tài nguyên khi quét cả những vùng không hướng về đích.",
            type: "Path"
        },
        'AStar': {
            name: "A* (A-Star)",
            desc: "Cải tiến của Dijkstra có sử dụng hàm Heuristic h(n) để ước lượng khoảng cách tới đích.",
            complexity: "O(E) (Best case)",
            pros: "Nhanh hơn Dijkstra rất nhiều nhờ định hướng. Tối ưu cho Point-to-Point.",
            cons: "Hiệu năng phụ thuộc hoàn toàn vào hàm Heuristic. Tốn bộ nhớ.",
            type: "Path"
        },
        'GreedyBestFirst': {
            name: "Greedy Best-First (Euclidean)",
            desc: "Thuật toán tham lam thuần túy. Luôn chọn đỉnh có khoảng cách chim bay tới đích gần nhất.",
            complexity: "O(b^m)",
            pros: "Tốc độ cực nhanh. Rất hiệu quả trong không gian mở ít vật cản.",
            cons: "Không đảm bảo đường ngắn nhất (có thể bị kẹt hoặc đi vòng).",
            type: "Greedy"
        },
        'GreedyManhattan': {
            name: "Greedy (Manhattan)",
            desc: "Giống Best-First nhưng dùng khoảng cách Manhattan (|x1-x2| + |y1-y2|).",
            complexity: "O(b^m)",
            pros: "Phù hợp cho bản đồ dạng lưới (Grid) 4 hướng.",
            cons: "Đường đi thường gấp khúc, không mượt.",
            type: "Greedy"
        },
        'GreedyChebyshev': {
            name: "Greedy (Chebyshev)",
            desc: "Sử dụng khoảng cách Chebyshev (Max(|dx|, |dy|)). Cho phép di chuyển chéo.",
            complexity: "O(b^m)",
            pros: "Tốt cho lưới 8 hướng (King's move trong cờ vua).",
            cons: "Không tối ưu cho lưới chỉ có 4 hướng.",
            type: "Greedy"
        }
    };

    // --- VARIABLES ---
    let ctxL, ctxR, gridSize;
    const colorVisited = "rgba(215, 204, 200, 0.6)"; // Nâu nhạt mờ
    const colorPath = "#D84315"; // Đỏ gạch
    const colorWall = "#3E2723"; // Nâu đậm

    document.addEventListener('DOMContentLoaded', () => {
        const s = document.getElementById('sizeRange');
        s.addEventListener('input', () => {
            document.getElementById('sizeDisplay').innerText = `${s.value}x${s.value}`;
            initCanvas();
        });

        updateInfo('left');
        updateInfo('right');
        initCanvas();
    });

    function updateInfo(side) {
        const algo = document.getElementById(`${side}Algo`).value;
        const info = ALGO_DB[algo];
        const el = document.getElementById(`desc${side.charAt(0).toUpperCase() + side.slice(1)}`);

        const md = `
#### ${info.name}
* **Loại:** ${info.type}
* **Độ phức tạp:** \`${info.complexity}\`
* **Mô tả:** ${info.desc}

| Đặc điểm | Chi tiết |
| :--- | :--- |
| **Ưu điểm** | ${info.pros} |
| **Nhược điểm** | ${info.cons} |
        `;
        el.innerHTML = marked.parse(md);
    }

    function initCanvas() {
        gridSize = parseInt(document.getElementById('sizeRange').value);
        ['canvasLeft', 'canvasRight'].forEach(id => {
            const c = document.getElementById(id);
            c.width = c.parentElement.clientWidth;
            c.height = c.width;
            const ctx = c.getContext('2d');

            // Vẽ Grid
            ctx.fillStyle = "#FFFFFF"; ctx.fillRect(0, 0, c.width, c.height);
            ctx.strokeStyle = "#EFEBE9"; ctx.lineWidth = 1;
            const cell = c.width / gridSize;

            ctx.beginPath();
            for (let i = 0; i <= gridSize; i++) {
                ctx.moveTo(i * cell, 0); ctx.lineTo(i * cell, c.height);
                ctx.moveTo(0, i * cell); ctx.lineTo(c.width, i * cell);
            }
            ctx.stroke();
        });
        ctxL = document.getElementById('canvasLeft').getContext('2d');
        ctxR = document.getElementById('canvasRight').getContext('2d');
    }

    document.getElementById('btnRun').onclick = async () => {
        const btn = document.getElementById('btnRun');
        btn.disabled = true;
        document.querySelectorAll('.algo-card').forEach(c => c.classList.remove('winner'));

        // Clear Canvas but keep grid (simple repaint)
        initCanvas();

        const formData = new FormData();
        formData.append('gridSize', gridSize);
        formData.append('density', document.getElementById('densityMode').value);
        formData.append('algo1', document.getElementById('leftAlgo').value);
        formData.append('algo2', document.getElementById('rightAlgo').value);

        try {
            // CALL BACKEND
            const res = await fetch('/MoPhong/RunArena', { method: 'POST', body: formData });
            const data = await res.json();

            if (data.success) {
                // Update Time Stats
                document.getElementById('timeLeft').innerText = data.res1.time.toFixed(3) + "ms";
                document.getElementById('timeRight').innerText = data.res2.time.toFixed(3) + "ms";

                document.getElementById('costLeft').innerText = data.res1.cost;
                document.getElementById('costRight').innerText = data.res2.cost;

                // Run Animation
                const cell = ctxL.canvas.width / gridSize;

                await Promise.all([
                    animate(ctxL, data.res1, cell, 'visLeft'),
                    animate(ctxR, data.res2, cell, 'visRight')
                ]);

                // Determine Winner
                if (data.res1.time < data.res2.time) win('cardLeft');
                else win('cardRight');
            }
        } catch (e) {
            console.error(e);
            alert("Lỗi xử lý mô phỏng!");
        }
        btn.disabled = false;
    };

    function win(id) {
        document.getElementById(id).classList.add('winner');
        confetti({ particleCount: 150, spread: 70, origin: { y: 0.6 }, colors: ['#D84315', '#2E7D32', '#F9A825'] });
    }

    async function animate(ctx, data, cell, visId) {
        // 1. Draw Obstacles
        ctx.fillStyle = colorWall;
        for (let w of data.walls) {
            ctx.fillRect(w.x * cell, w.y * cell, cell, cell);
        }

        // 2. Animate Visited
        ctx.fillStyle = colorVisited;
        let count = 0;
        const speed = data.visited.length > 1000 ? 1 : 5; // Fast mode for large data

        for (let i = 0; i < data.visited.length; i++) {
            const v = data.visited[i];
            ctx.fillRect(v.x * cell, v.y * cell, cell, cell);
            if (i % speed === 0) {
                document.getElementById(visId).innerText = ++count;
                await new Promise(r => requestAnimationFrame(r));
            }
        }

        // 3. Draw Path
        if (data.path) {
            ctx.fillStyle = colorPath;
            for (let p of data.path) {
                ctx.fillRect(p.x * cell + 2, p.y * cell + 2, cell - 4, cell - 4);
                await new Promise(r => setTimeout(r, 10));
            }
        }
    }
</script>