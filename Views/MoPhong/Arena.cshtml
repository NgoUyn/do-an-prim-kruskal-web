@{
    ViewBag.Title = "Algorithm Arena - Pro Mode";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&family=JetBrains+Mono:wght@500;800&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

<style>
    :root {
        --bg-body: #0F172A;
        --card-glass: rgba(30, 41, 59, 0.7);
        --border-glass: 1px solid rgba(255, 255, 255, 0.1);
        --text-primary: #F8FAFC;
        --color-prim: #00E676; /* Green Neon */
        --color-path: #2979FF; /* Blue Neon */
        --color-warn: #FF3D00; /* Red Neon */
    }

    body {
        background-color: var(--bg-body);
        background-image: radial-gradient(circle at 15% 50%, rgba(41, 121, 255, 0.08), transparent 25%), radial-gradient(circle at 85% 30%, rgba(0, 230, 118, 0.08), transparent 25%);
        color: var(--text-primary);
        font-family: 'Outfit', sans-serif;
        overflow-x: hidden;
    }

    /* === HEADER === */
    .arena-header {
        text-align: center;
        padding: 30px 0;
    }

    .brand-title {
        font-size: 3rem;
        font-weight: 900;
        letter-spacing: -1px;
        background: linear-gradient(to right, #fff, #94A3B8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    /* === MAIN ARENA === */
    .arena-grid {
        display: grid;
        grid-template-columns: 1fr 80px 1fr;
        gap: 20px;
        padding: 0 40px;
        max-width: 1600px;
        margin: 0 auto 100px auto;
        align-items: start;
    }

    .vs-badge {
        background: #000;
        color: #fff;
        font-family: 'JetBrains Mono';
        font-weight: 800;
        font-size: 1.5rem;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #334155;
        margin: 150px auto 0 auto; /* Canh giữa theo chiều dọc tương đối */
        box-shadow: 0 0 30px rgba(0,0,0,0.5);
        z-index: 10;
    }

    /* === CARDS === */
    .algo-card {
        background: var(--card-glass);
        backdrop-filter: blur(12px);
        border: var(--border-glass);
        border-radius: 24px;
        padding: 24px;
        transition: 0.3s;
        position: relative;
    }

        .algo-card.winner {
            border-color: #FFD700;
            box-shadow: 0 0 60px rgba(255, 215, 0, 0.15);
            transform: translateY(-5px);
        }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .algo-select {
        background: rgba(0,0,0,0.3);
        color: #fff;
        border: 1px solid rgba(255,255,255,0.2);
        padding: 8px 16px;
        border-radius: 8px;
        font-family: 'Outfit';
        font-weight: 700;
        outline: none;
        cursor: pointer;
    }

    /* === MONITOR SCREEN === */
    .monitor-screen {
        width: 100%;
        aspect-ratio: 1;
        background: #000;
        border-radius: 16px;
        border: 1px solid #334155;
        position: relative;
        overflow: hidden;
    }

    canvas {
        width: 100%;
        height: 100%;
        display: block;
        image-rendering: pixelated;
    }

    /* === STATS === */
    .stats-row {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 10px;
        margin-top: 20px;
    }

    .stat-box {
        background: rgba(255,255,255,0.03);
        padding: 10px;
        border-radius: 10px;
        text-align: center;
        border: 1px solid rgba(255,255,255,0.05);
    }

    .stat-val {
        font-family: 'JetBrains Mono';
        font-weight: 700;
        font-size: 1.2rem;
    }

    .stat-lbl {
        font-size: 0.7rem;
        color: #94A3B8;
        text-transform: uppercase;
        margin-top: 5px;
    }

    /* === CONTROL DOCK === */
    .control-dock {
        position: fixed;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(15, 23, 42, 0.9);
        backdrop-filter: blur(16px);
        padding: 15px 30px;
        border-radius: 20px;
        border: 1px solid rgba(255,255,255,0.15);
        display: flex;
        gap: 30px;
        align-items: center;
        box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        z-index: 100;
    }

    .ctrl-group {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .ctrl-lbl {
        font-size: 0.65rem;
        color: #94A3B8;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    input[type=range] {
        -webkit-appearance: none;
        background: #334155;
        height: 4px;
        border-radius: 2px;
    }

        input[type=range]::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 16px;
            height: 16px;
            background: #fff;
            border-radius: 50%;
            cursor: pointer;
        }

    .btn-neon {
        background: #fff;
        color: #000;
        border: none;
        padding: 12px 40px;
        border-radius: 12px;
        font-weight: 800;
        text-transform: uppercase;
        cursor: pointer;
        transition: 0.2s;
        box-shadow: 0 0 20px rgba(255,255,255,0.2);
    }

        .btn-neon:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 30px rgba(255,255,255,0.4);
        }

        .btn-neon:disabled {
            background: #475569;
            color: #94A3B8;
            box-shadow: none;
            cursor: not-allowed;
        }

    /* Winner Overlay */
    .winner-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,0.8);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: 0.5s;
        pointer-events: none;
    }

    .algo-card.winner .winner-overlay {
        opacity: 1;
    }

    .win-tag {
        background: #FFD700;
        color: #000;
        padding: 5px 20px;
        border-radius: 50px;
        font-weight: 900;
        font-size: 1.2rem;
        box-shadow: 0 0 20px #FFD700;
    }
</style>

<div class="arena-header">
    <div class="brand-title">ALGO.ARENA <span style="font-size:1rem; vertical-align:middle; background:#334155; padding:4px 8px; border-radius:6px;">REAL-TIME</span></div>
</div>

<div class="arena-grid">
    <div class="algo-card" id="cardLeft">
        <div class="card-header">
            <div style="font-size:1.5rem; font-weight:800; color:var(--color-prim)">MST SQUAD</div>
            <select id="leftAlgo" class="algo-select">
                <option value="Prim">Prim (Dense King)</option>
                <option value="Kruskal">Kruskal (Sparse King)</option>
            </select>
        </div>
        <div class="monitor-screen">
            <canvas id="canvasLeft"></canvas>
            <div class="winner-overlay" id="overlayLeft">
                <div class="win-tag">VICTORY</div>
                <div style="color:#CBD5E0; margin-top:5px" id="reasonLeft">Faster</div>
            </div>
        </div>
        <div class="stats-row">
            <div class="stat-box"><div class="stat-val" id="visLeft">0</div><div class="stat-lbl">Nodes</div></div>
            <div class="stat-box"><div class="stat-val" style="color:var(--color-prim)" id="timeLeft">0ms</div><div class="stat-lbl">Real Time</div></div>
            <div class="stat-box"><div class="stat-val" id="statusLeft" style="font-size:1rem; line-height:1.5rem">IDLE</div><div class="stat-lbl">State</div></div>
        </div>
        <div style="width:100%; height:4px; background:#334155; margin-top:20px; border-radius:2px; overflow:hidden">
            <div id="progLeft" style="width:0%; height:100%; background:var(--color-prim); transition:width 0.1s linear"></div>
        </div>
    </div>

    <div class="vs-badge">VS</div>

    <div class="algo-card" id="cardRight">
        <div class="card-header">
            <div style="font-size:1.5rem; font-weight:800; color:var(--color-path)">PATH SQUAD</div>
            <select id="rightAlgo" class="algo-select">
                <option value="A*">A* (Smart)</option>
                <option value="Dijkstra">Dijkstra (Safe)</option>
                <option value="BFS">BFS (Wide)</option>
            </select>
        </div>
        <div class="monitor-screen">
            <canvas id="canvasRight"></canvas>
            <div class="winner-overlay" id="overlayRight">
                <div class="win-tag">VICTORY</div>
                <div style="color:#CBD5E0; margin-top:5px" id="reasonRight">Faster</div>
            </div>
        </div>
        <div class="stats-row">
            <div class="stat-box"><div class="stat-val" id="visRight">0</div><div class="stat-lbl">Nodes</div></div>
            <div class="stat-box"><div class="stat-val" style="color:var(--color-path)" id="timeRight">0ms</div><div class="stat-lbl">Real Time</div></div>
            <div class="stat-box"><div class="stat-val" id="statusRight" style="font-size:1rem; line-height:1.5rem">IDLE</div><div class="stat-lbl">State</div></div>
        </div>
        <div style="width:100%; height:4px; background:#334155; margin-top:20px; border-radius:2px; overflow:hidden">
            <div id="progRight" style="width:0%; height:100%; background:var(--color-path); transition:width 0.1s linear"></div>
        </div>
    </div>
</div>

<div class="control-dock">
    <div class="ctrl-group">
        <div class="ctrl-lbl">Grid Size (Nodes)</div>
        <div style="display:flex; gap:10px; align-items:center">
            <input type="range" id="sizeRange" min="20" max="60" value="40" oninput="updateMeta()">
            <span id="sizeVal" style="font-family:'JetBrains Mono'; font-weight:bold; color:#fff">1600</span>
        </div>
    </div>

    <div class="ctrl-group" style="border-left:1px solid rgba(255,255,255,0.2); padding-left:20px;">
        <div class="ctrl-lbl">Complexity (Density)</div>
        <select id="densityMode" style="background:#1E293B; color:white; border:none; padding:4px; border-radius:4px; font-size:0.8rem">
            <option value="sparse">Thưa (Sparse - Kruskal Win)</option>
            <option value="fair" selected>Trung bình (Fair)</option>
            <option value="dense">Dày (Dense - Prim Win)</option>
        </select>
    </div>

    <div class="ctrl-group" style="border-left:1px solid rgba(255,255,255,0.2); padding-left:20px;">
        <div class="ctrl-lbl">Time Dilation (Speed)</div>
        <div style="display:flex; gap:10px; align-items:center">
            <span style="font-size:0.8rem">⚡</span>
            <input type="range" id="speedRange" min="1" max="100" value="10">
            <span style="font-size:0.8rem">🐢</span>
        </div>
    </div>
    <button id="btnRun" class="btn-neon"><i class="fas fa-play"></i> BATTLE</button>
</div>

<script>
    // --- VARIABLES ---
    let leftCtx, rightCtx, gridSize, cellSize;
    // Bảng màu: Xanh (Đầu) -> Vàng -> Đỏ (Cuối)
    const heatGradient = [[0, 230, 118], [255, 235, 59], [255, 61, 0]];

    document.addEventListener('DOMContentLoaded', () => {
        updateMeta();
        initCanvases();
    });

    function updateMeta() {
        const s = parseInt(document.getElementById('sizeRange').value);
        gridSize = s;
        document.getElementById('sizeVal').innerText = (s * s);
    }

    function initCanvases() {
        const container = document.querySelector('.monitor-screen');
        const w = container.clientWidth;
        const h = w;
        const dpr = window.devicePixelRatio || 1;
        cellSize = w / gridSize;

        ['canvasLeft', 'canvasRight'].forEach(id => {
            const c = document.getElementById(id);
            const ctx = c.getContext('2d');
            c.width = w * dpr; c.height = h * dpr;
            c.style.width = w + 'px'; c.style.height = h + 'px';
            ctx.scale(dpr, dpr);

            // Vẽ nền đen + Grid mờ
            ctx.fillStyle = "#000"; ctx.fillRect(0, 0, w, h);
            ctx.strokeStyle = "rgba(255,255,255,0.05)"; ctx.lineWidth = 1;
            ctx.beginPath();
            for (let i = 0; i <= gridSize; i++) {
                let p = i * cellSize;
                ctx.moveTo(p, 0); ctx.lineTo(p, h); ctx.moveTo(0, p); ctx.lineTo(w, p);
            }
            ctx.stroke();

            // Vẽ Start/End
            drawDot(ctx, 0, 0, '#00E676');
            drawDot(ctx, gridSize - 1, gridSize - 1, '#F50057');
        });

        leftCtx = document.getElementById('canvasLeft').getContext('2d');
        rightCtx = document.getElementById('canvasRight').getContext('2d');
    }

    function drawDot(ctx, gx, gy, color) {
        let x = gx * cellSize + cellSize / 2;
        let y = gy * cellSize + cellSize / 2;
        ctx.beginPath(); ctx.arc(x, y, cellSize * 0.3, 0, Math.PI * 2);
        ctx.fillStyle = color; ctx.fill();
        ctx.shadowBlur = 15; ctx.shadowColor = color; ctx.stroke(); ctx.shadowBlur = 0;
    }

    // --- MAIN LOGIC ---
    document.getElementById('btnRun').onclick = async () => {
        const btn = document.getElementById('btnRun');
        btn.disabled = true;

        // Reset UI
        document.querySelectorAll('.algo-card').forEach(c => c.classList.remove('winner'));
        initCanvases();

        const nodeCount = gridSize * gridSize;
        const density = document.getElementById('densityMode').value;
        const timeFactor = parseInt(document.getElementById('speedRange').value); // Hệ số nhân thời gian

        const formData = new FormData();
        formData.append('nodeCount', nodeCount);
        formData.append('densityMode', density); // QUAN TRỌNG: Gửi Density để backend tính toán đúng Complexity
        formData.append('leftAlgo', document.getElementById('leftAlgo').value);
        formData.append('rightAlgo', document.getElementById('rightAlgo').value);

        try {
            const res = await fetch('/MoPhong/RunArena', { method: 'POST', body: formData });
            const data = await res.json();

            if (data.success) {
                // Hiển thị thời gian thực tế từ Server (CPU Time)
                document.getElementById('timeLeft').innerText = data.left.time.toFixed(3) + "ms";
                document.getElementById('timeRight').innerText = data.right.time.toFixed(3) + "ms";

                // --- REAL-TIME SCALING ---
                // Tính toán thời gian animation dựa trên tỷ lệ thực tế
                // Base: 1ms thực tế = (timeFactor * 10) ms animation
                // Ví dụ: Prim 1ms, Kruskal 10ms -> Prim chạy trong 1s, Kruskal chạy trong 10s
                const animScale = timeFactor * 20; // Magic number để visual dễ nhìn
                const durLeft = Math.max(500, data.left.time * animScale);
                const durRight = Math.max(500, data.right.time * animScale);

                let leftDone = false, rightDone = false;

                const checkWin = () => {
                    if (leftDone && rightDone) {
                        btn.disabled = false;
                        const tL = data.left.time;
                        const tR = data.right.time;

                        if (tL < tR) endGame('cardLeft', 'cardRight', `Nhanh gấp ${(tR / tL).toFixed(1)}x`);
                        else endGame('cardRight', 'cardLeft', `Nhanh gấp ${(tL / tR).toFixed(1)}x`);
                    }
                };

                // Chạy Animation dựa trên thời gian
                runProAnim(leftCtx, data.left, durLeft, 'progLeft', 'visLeft', 'statusLeft', () => { leftDone = true; checkWin(); });
                runProAnim(rightCtx, data.right, durRight, 'progRight', 'visRight', 'statusRight', () => { rightDone = true; checkWin(); });
            }
        } catch (e) {
            console.error(e);
            alert("Lỗi server hoặc timeout.");
            btn.disabled = false;
        }
    };

    function endGame(winId, loseId, reason) {
        document.getElementById(winId).classList.add('winner');
        const overlayId = winId === 'cardLeft' ? 'reasonLeft' : 'reasonRight';
        document.getElementById(overlayId).innerText = reason;
        confetti({ particleCount: 200, spread: 100, origin: { y: 0.6 }, colors: ['#00E676', '#FFD700'] });
    }

    // --- ANIMATION ENGINE (TIME-BASED) ---
    function runProAnim(ctx, data, durationMs, progId, visId, statusId, onDone) {
        const visited = data.visited;
        const total = visited.length;
        let startTime = null;

        document.getElementById(statusId).innerText = "COMPUTING...";
        document.getElementById(statusId).style.color = "#FFC107";

        let drawnIndex = 0;

        function frame(timestamp) {
            if (!startTime) startTime = timestamp;
            const elapsed = timestamp - startTime;

            // Tính toán % tiến độ dựa trên thời gian thực
            let progress = Math.min(elapsed / durationMs, 1.0);

            // Số lượng node cần vẽ tính đến thời điểm này
            const targetIndex = Math.floor(progress * total);

            // Batch Draw: Vẽ tất cả các node từ lần vẽ trước đến hiện tại
            if (targetIndex > drawnIndex) {
                for (let i = drawnIndex; i < targetIndex; i++) {
                    const n = visited[i];
                    // Heatmap color logic
                    const color = getHeatColor(i / total);

                    ctx.fillStyle = `rgb(${color.r},${color.g},${color.b})`;
                    // Vẽ pixel nhỏ hơn 1 chút để tạo hiệu ứng Grid
                    ctx.fillRect(n.x * cellSize + 0.5, n.y * cellSize + 0.5, cellSize - 1, cellSize - 1);
                }
                drawnIndex = targetIndex;
            }

            // Update DOM Stats
            document.getElementById(visId).innerText = drawnIndex;
            document.getElementById(progId).style.width = (progress * 100) + "%";

            if (progress < 1.0) {
                requestAnimationFrame(frame);
            } else {
                // FINISH
                document.getElementById(statusId).innerText = "COMPLETE";
                document.getElementById(statusId).style.color = "#00E676";
                drawDot(ctx, 0, 0, '#FFF'); // Redraw Start
                drawDot(ctx, gridSize - 1, gridSize - 1, '#FFF'); // Redraw End

                // Nếu có đường đi (Path) thì vẽ đè lên màu trắng
                if (data.path && data.path.length > 0) {
                    drawPath(ctx, data.path);
                }
                onDone();
            }
        }
        requestAnimationFrame(frame);
    }

    function drawPath(ctx, path) {
        ctx.fillStyle = "#FFFFFF";
        ctx.shadowBlur = 10; ctx.shadowColor = "#FFF";
        path.forEach(n => {
            ctx.fillRect(n.x * cellSize + 2, n.y * cellSize + 2, cellSize - 4, cellSize - 4);
        });
        ctx.shadowBlur = 0;
    }

    function getHeatColor(t) {
        // Nội suy màu tuyến tính giữa 3 mốc (Green -> Yellow -> Red)
        if (t < 0.5) return interpolate(heatGradient[0], heatGradient[1], t * 2);
        return interpolate(heatGradient[1], heatGradient[2], (t - 0.5) * 2);
    }

    function interpolate(c1, c2, t) {
        return {
            r: Math.round(c1[0] + (c2[0] - c1[0]) * t),
            g: Math.round(c1[1] + (c2[1] - c1[1]) * t),
            b: Math.round(c1[2] + (c2[2] - c1[2]) * t)
        };
    }
</script>