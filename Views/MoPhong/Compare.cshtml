@{
    ViewBag.Title = "Prim vs Kruskal - Ultimate Duel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

<style>
    /* === THEME: ORGANIC DUEL === */
    :root {
        --bg-body: #F2F2F7;
        --card-bg: #FFFFFF;
        --text-main: #2C2C2E;
        --text-sub: #8E8E93;
        --border-color: #E5E5EA;
        /* Prim Color: Organic Green */
        --prim-color: #34C759;
        /* Kruskal Color: Structural Orange/Brown */
        --kruskal-color: #FF9500;
        --shadow-soft: 0 8px 30px rgba(0,0,0,0.08);
    }

    body {
        background-color: var(--bg-body);
        color: var(--text-main);
        font-family: 'Inter', sans-serif;
        overflow-x: hidden;
    }

    /* === HEADER === */
    .duel-header {
        text-align: center;
        padding: 50px 0 30px 0;
    }

    .duel-title {
        font-size: 3rem;
        font-weight: 900;
        letter-spacing: -1px;
        color: var(--text-main);
        margin: 0;
    }

    .duel-subtitle {
        font-family: 'Space Mono', monospace;
        color: var(--text-sub);
        font-size: 0.9rem;
        margin-top: 10px;
    }

    /* === ARENA LAYOUT === */
    .arena-container {
        display: grid;
        grid-template-columns: 1fr 80px 1fr;
        gap: 20px;
        max-width: 1400px;
        margin: 0 auto 120px auto;
        padding: 0 30px;
        align-items: start;
    }

    /* === ALGO CARD === */
    .algo-card {
        background: var(--card-bg);
        border-radius: 24px;
        padding: 24px;
        box-shadow: var(--shadow-soft);
        border: 1px solid var(--border-color);
        position: relative;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .algo-card.winner {
            border-color: var(--text-main);
            transform: translateY(-8px);
            box-shadow: 0 20px 50px rgba(0,0,0,0.15);
            z-index: 10;
        }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .algo-name {
        font-size: 1.5rem;
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    .algo-desc {
        font-size: 0.75rem;
        font-family: 'Space Mono';
        color: var(--text-sub);
        background: #F2F2F7;
        padding: 4px 8px;
        border-radius: 6px;
    }

    /* CANVAS */
    .canvas-box {
        width: 100%;
        aspect-ratio: 1;
        background: #FAFAFA;
        border-radius: 16px;
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.05);
    }

    canvas {
        width: 100%;
        height: 100%;
        display: block;
        image-rendering: pixelated;
    }

    /* STATS */
    .stats-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
        margin-top: 20px;
    }

    .stat-item {
        background: #F9F9F9;
        padding: 12px;
        border-radius: 12px;
        text-align: center;
    }

    .stat-val {
        font-family: 'Space Mono';
        font-weight: 700;
        font-size: 1.2rem;
        color: var(--text-main);
    }

    .stat-lbl {
        font-size: 0.7rem;
        color: var(--text-sub);
        text-transform: uppercase;
        margin-top: 4px;
    }

    /* PROGRESS BAR */
    .prog-bar-bg {
        width: 100%;
        height: 6px;
        background: #E5E5EA;
        margin-top: 20px;
        border-radius: 3px;
        overflow: hidden;
    }

    .prog-bar-fill {
        height: 100%;
        width: 0%;
        transition: width 0.1s linear;
    }

    /* VS BADGE */
    .vs-badge {
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        font-weight: 900;
        font-style: italic;
        font-size: 1.5rem;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        margin-top: 250px;
    }

    /* OVERLAY */
    .result-overlay {
        position: absolute;
        inset: 0;
        background: rgba(255,255,255,0.85);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: 0.4s;
        backdrop-filter: blur(4px);
        pointer-events: none;
    }

    .algo-card.winner .result-overlay {
        opacity: 1;
    }

    .win-tag {
        background: #000;
        color: #fff;
        padding: 8px 20px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 1rem;
        margin-bottom: 8px;
    }

    .win-details {
        font-family: 'Space Mono';
        color: var(--text-sub);
        font-size: 0.9rem;
    }

    /* CONTROL DOCK */
    .control-dock {
        position: fixed;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(255,255,255,0.95);
        backdrop-filter: blur(20px);
        padding: 15px 30px;
        border-radius: 20px;
        border: 1px solid rgba(0,0,0,0.1);
        display: flex;
        gap: 30px;
        align-items: center;
        box-shadow: 0 20px 60px rgba(0,0,0,0.15);
        z-index: 100;
    }

    .ctrl-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 5px;
    }

    .ctrl-lbl {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--text-sub);
        letter-spacing: 1px;
    }

    input[type=range] {
        -webkit-appearance: none;
        background: #E5E5EA;
        height: 4px;
        border-radius: 2px;
        width: 120px;
    }

        input[type=range]::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 18px;
            height: 18px;
            background: #2C2C2E;
            border-radius: 50%;
            cursor: pointer;
        }

    .btn-battle {
        background: #000;
        color: #fff;
        border: none;
        padding: 14px 40px;
        border-radius: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 1rem;
    }

        .btn-battle:hover {
            transform: scale(1.05);
            background: #333;
        }

        .btn-battle:disabled {
            background: #CCC;
            transform: none;
            cursor: not-allowed;
        }
</style>

<div class="duel-header">
    <h1 class="duel-title">PRIM <span style="font-weight:300; color:#E5E5EA">vs</span> KRUSKAL</h1>
    <div class="duel-subtitle">MST ALGORITHM PERFORMANCE SHOWDOWN</div>
</div>

<div class="arena-container">
    <div class="algo-card" id="cardPrim">
        <div class="card-header">
            <div>
                <div class="algo-name" style="color:var(--prim-color)">PRIM</div>
                <div class="algo-desc">Best for Dense Graphs (O(V²))</div>
            </div>
            <i class="fas fa-project-diagram" style="font-size:1.5rem; color:var(--prim-color); opacity:0.3"></i>
        </div>
        <div class="canvas-box">
            <canvas id="canvasPrim"></canvas>
            <div class="result-overlay" id="overlayPrim">
                <div class="win-tag">WINNER</div>
                <div class="win-details" id="reasonPrim">Faster</div>
            </div>
        </div>
        <div class="stats-grid">
            <div class="stat-item"><div class="stat-val" id="timePrim" style="color:var(--prim-color)">0ms</div><div class="stat-lbl">Execution Time</div></div>
            <div class="stat-item"><div class="stat-val" id="visPrim">0</div><div class="stat-lbl">Processed</div></div>
        </div>
        <div class="prog-bar-bg"><div class="prog-bar-fill" id="progPrim" style="background:var(--prim-color)"></div></div>
    </div>

    <div class="vs-badge">VS</div>

    <div class="algo-card" id="cardKruskal">
        <div class="card-header">
            <div>
                <div class="algo-name" style="color:var(--kruskal-color)">KRUSKAL</div>
                <div class="algo-desc">Best for Sparse Graphs (O(E log E))</div>
            </div>
            <i class="fas fa-border-all" style="font-size:1.5rem; color:var(--kruskal-color); opacity:0.3"></i>
        </div>
        <div class="canvas-box">
            <canvas id="canvasKruskal"></canvas>
            <div class="result-overlay" id="overlayKruskal">
                <div class="win-tag">WINNER</div>
                <div class="win-details" id="reasonKruskal">Faster</div>
            </div>
        </div>
        <div class="stats-grid">
            <div class="stat-item"><div class="stat-val" id="timeKruskal" style="color:var(--kruskal-color)">0ms</div><div class="stat-lbl">Execution Time</div></div>
            <div class="stat-item"><div class="stat-val" id="visKruskal">0</div><div class="stat-lbl">Processed</div></div>
        </div>
        <div class="prog-bar-bg"><div class="prog-bar-fill" id="progKruskal" style="background:var(--kruskal-color)"></div></div>
    </div>
</div>

<div class="control-dock">
    <div class="ctrl-item">
        <div class="ctrl-lbl">Map Size</div>
        <div style="display:flex; align-items:center; gap:10px">
            <input type="range" id="sizeRange" min="20" max="80" value="40" oninput="updateMeta()">
            <span id="sizeVal" style="font-family:'Space Mono'; font-weight:bold">1600</span>
        </div>
    </div>

    <div style="width:1px; height:40px; background:#E5E5EA"></div>

    <div class="ctrl-item">
        <div class="ctrl-lbl">Graph Density</div>
        <select id="densityMode" style="border:none; background:transparent; font-family:'Inter'; font-weight:700; cursor:pointer; font-size:1rem;">
            <option value="sparse">Sparse (Kruskal Win)</option>
            <option value="fair" selected>Fair (Balanced)</option>
            <option value="dense">Dense (Prim Win)</option>
        </select>
        <div style="font-size:0.6rem; color:#8E8E93" id="edgeEst">~3,200 Edges</div>
    </div>

    <div style="width:1px; height:40px; background:#E5E5EA"></div>

    <div class="ctrl-item">
        <div class="ctrl-lbl">Time Dilation</div>
        <div style="display:flex; align-items:center; gap:10px">
            <span style="font-size:0.8rem">1x</span>
            <input type="range" id="speedRange" min="1" max="100" value="10">
            <span style="font-size:0.8rem">100x</span>
        </div>
    </div>

    <button id="btnRun" class="btn-battle">
        <i class="fas fa-play"></i> START DUEL
    </button>
</div>

<script>
    // --- CONFIG ---
    let primCtx, kruskalCtx, gridSize, cellSize;

    // Palette: Trắng -> Gạo -> Nâu (Simulation Style)
    const heatGradient = [
        [255, 255, 255], // New
        [215, 204, 200], // Processing
        [93, 64, 55]     // Old/Root
    ];

    document.addEventListener('DOMContentLoaded', () => {
        updateMeta();
        initCanvases();

        // Cập nhật ước tính số cạnh khi đổi density
        document.getElementById('densityMode').addEventListener('change', updateMeta);
    });

    function updateMeta() {
        const s = parseInt(document.getElementById('sizeRange').value);
        gridSize = s;
        const nodes = s * s;
        document.getElementById('sizeVal').innerText = nodes;

        // Ước tính số cạnh để hiển thị cho pro
        const mode = document.getElementById('densityMode').value;
        let edges = 0;
        if (mode === 'sparse') edges = nodes * 2.5; // ~2.5E per V
        else if (mode === 'fair') edges = (nodes * (nodes - 1)) / 2 * 0.15; // 15% complete
        else edges = (nodes * (nodes - 1)) / 2 * 0.8; // 80% complete

        document.getElementById('edgeEst').innerText = `~${Number(edges.toFixed(0)).toLocaleString()} Edges`;
    }

    function initCanvases() {
        const container = document.querySelector('.canvas-box');
        const w = container.clientWidth;
        const h = w;
        const dpr = window.devicePixelRatio || 1;
        cellSize = w / gridSize;

        ['canvasPrim', 'canvasKruskal'].forEach(id => {
            const c = document.getElementById(id);
            const ctx = c.getContext('2d');
            c.width = w * dpr; c.height = h * dpr;
            c.style.width = w + 'px'; c.style.height = h + 'px';
            ctx.scale(dpr, dpr);

            // Background
            ctx.fillStyle = "#FAFAFA"; ctx.fillRect(0, 0, w, h);

            // Grid
            ctx.strokeStyle = "rgba(0,0,0,0.03)"; ctx.lineWidth = 1;
            ctx.beginPath();
            for (let i = 0; i <= gridSize; i++) {
                let p = i * cellSize;
                ctx.moveTo(p, 0); ctx.lineTo(p, h); ctx.moveTo(0, p); ctx.lineTo(w, p);
            }
            ctx.stroke();
        });

        primCtx = document.getElementById('canvasPrim').getContext('2d');
        kruskalCtx = document.getElementById('canvasKruskal').getContext('2d');
    }

    // --- MAIN LOGIC ---
    document.getElementById('btnRun').onclick = async () => {
        const btn = document.getElementById('btnRun');
        btn.disabled = true;

        // Reset UI
        document.querySelectorAll('.algo-card').forEach(c => c.classList.remove('winner'));
        document.querySelectorAll('.result-overlay').forEach(o => o.style.opacity = '0');
        initCanvases();

        const nodeCount = gridSize * gridSize;
        const density = document.getElementById('densityMode').value;
        const timeFactor = parseInt(document.getElementById('speedRange').value);

        // FORM DATA: Cố định 2 thuật toán
        const formData = new FormData();
        formData.append('nodeCount', nodeCount);
        formData.append('densityMode', density);
        formData.append('leftAlgo', 'Prim');     // HARDCODED
        formData.append('rightAlgo', 'Kruskal'); // HARDCODED

        try {
            const res = await fetch('/MoPhong/RunArena', { method: 'POST', body: formData });
            const data = await res.json();

            if (data.success) {
                const tPrim = data.left.time;
                const tKruskal = data.right.time;

                // Update text stats
                document.getElementById('timePrim').innerText = tPrim.toFixed(3) + "ms";
                document.getElementById('timeKruskal').innerText = tKruskal.toFixed(3) + "ms";

                // --- REAL-TIME SCALING ---
                // Hệ số nhân (timeFactor) giúp mắt thường nhìn thấy được tốc độ ms
                // Ví dụ: timeFactor = 10. Prim chạy 1ms -> Animation 10ms. Kruskal 100ms -> Animation 1000ms.
                const visualMultiplier = timeFactor * 10;

                // Đảm bảo min duration là 500ms để không bị nháy
                const durPrim = Math.max(500, tPrim * visualMultiplier);
                const durKruskal = Math.max(500, tKruskal * visualMultiplier);

                let primDone = false, kruskalDone = false;

                const checkWin = () => {
                    if (primDone && kruskalDone) {
                        btn.disabled = false;
                        if (tPrim < tKruskal) {
                            endGame('cardPrim', 'cardKruskal', `Nhanh gấp ${(tKruskal / tPrim).toFixed(1)}x`);
                        } else {
                            endGame('cardKruskal', 'cardPrim', `Nhanh gấp ${(tPrim / tKruskal).toFixed(1)}x`);
                        }
                    }
                };

                // Chạy song song 2 animation
                runSim(primCtx, data.left, durPrim, 'progPrim', 'visPrim', () => { primDone = true; checkWin(); });
                runSim(kruskalCtx, data.right, durKruskal, 'progKruskal', 'visKruskal', () => { kruskalDone = true; checkWin(); });
            }
        } catch (e) {
            console.error(e);
            alert("Lỗi kết nối server.");
            btn.disabled = false;
        }
    };

    function endGame(winId, loseId, reason) {
        document.getElementById(winId).classList.add('winner');
        const overlayId = winId === 'cardPrim' ? 'reasonPrim' : 'reasonKruskal';
        document.getElementById(overlayId).innerText = reason;

        // Bắn pháo giấy
        confetti({
            particleCount: 150, spread: 70, origin: { y: 0.6 },
            colors: ['#34C759', '#FF9500', '#2C2C2E']
        });
    }

    // --- SIMULATION ENGINE ---
    function runSim(ctx, data, durationMs, progId, visId, onDone) {
        const visited = data.visited;
        const total = visited.length;
        let startTime = null;
        let drawnIndex = 0;

        function frame(timestamp) {
            if (!startTime) startTime = timestamp;
            const elapsed = timestamp - startTime;

            // Tính toán % tiến độ dựa trên thời gian thực
            // Đây là chìa khóa để thể hiện tốc độ thực tế
            let progress = Math.min(elapsed / durationMs, 1.0);

            const targetIndex = Math.floor(progress * total);

            if (targetIndex > drawnIndex) {
                // Batch Draw
                for (let i = drawnIndex; i < targetIndex; i++) {
                    const n = visited[i];
                    // Màu loang từ Nâu (Gốc) -> Trắng (Ngọn)
                    // t=0 (Nâu), t=1 (Trắng)
                    const t = 1 - (i / total);
                    const color = interpolateColor(t);

                    ctx.fillStyle = `rgb(${color.r},${color.g},${color.b})`;
                    // Vẽ ô vuông (Sát nhau, không bo góc)
                    ctx.fillRect(n.x * cellSize, n.y * cellSize, cellSize, cellSize);
                }
                drawnIndex = targetIndex;
            }

            document.getElementById(visId).innerText = drawnIndex;
            document.getElementById(progId).style.width = (progress * 100) + "%";

            if (progress < 1.0) {
                requestAnimationFrame(frame);
            } else {
                onDone();
            }
        }
        requestAnimationFrame(frame);
    }

    function interpolateColor(t) {
        // heatGradient: 0=White, 1=Beige, 2=Brown
        if (t < 0.5) return _lerp(heatGradient[2], heatGradient[1], t * 2);
        return _lerp(heatGradient[1], heatGradient[0], (t - 0.5) * 2);
    }

    function _lerp(c1, c2, t) {
        return {
            r: Math.round(c1[0] + (c2[0] - c1[0]) * t),
            g: Math.round(c1[1] + (c2[1] - c1[1]) * t),
            b: Math.round(c1[2] + (c2[2] - c1[2]) * t)
        };
    }
</script>