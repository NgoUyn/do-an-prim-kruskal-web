@model Prim_Kruskal_Web.Models.CompareResult
@{
    ViewBag.Title = "Algorithm Visualization Studio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="https://d3js.org/d3.v7.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    :root {
        --bg-main: #F9F7F2;
        --text-color: #4E342E;
        --panel-bg: #FFFFFF;

        --prim-color: #2E7D32;   /* Forest Green */
        --kruskal-color: #D84315; /* Burnt Clay */
        --node-color: #5D4037;   /* Coffee Bean */
        --edge-color: #BCAAA4;   /* Light Brown */

        --shadow-soft: 0 10px 30px rgba(78, 52, 46, 0.08);
        --border-radius: 24px;
    }

    body {
        font-family: 'Nunito', sans-serif;
        background-color: var(--bg-main);
        background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23d7ccc8' fill-opacity='0.2'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
        color: var(--text-color);
    }

    .app-container {
        display: grid;
        grid-template-columns: 350px 1fr 320px;
        gap: 25px;
        max-width: 1600px;
        margin: 0 auto;
        padding: 20px;
        height: calc(100vh - 80px); /* Full height trừ header */
    }

    /* === CARD STYLING === */
    .glass-card {
        background: var(--panel-bg);
        border-radius: var(--border-radius);
        box-shadow: var(--shadow-soft);
        border: 1px solid rgba(78, 52, 46, 0.05);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .card-header {
        padding: 20px;
        border-bottom: 2px dashed #EFEBE9;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .card-title {
        font-family: 'Quicksand', sans-serif;
        font-weight: 700;
        font-size: 1.1rem;
        color: var(--text-color);
        display: flex; align-items: center; gap: 8px;
    }
    .card-body { padding: 20px; flex: 1; overflow-y: auto; }

    /* === LEFT PANEL: INPUT === */
    .input-group label { font-size: 0.85rem; font-weight: 700; color: #8D6E63; display: block; margin-bottom: 5px; }
    .custom-input {
        width: 100%; padding: 10px 15px; border: 2px solid #EFEBE9; border-radius: 12px;
        font-family: 'Nunito', sans-serif; font-size: 0.95rem; color: var(--text-color);
        background: #FAFAFA; transition: 0.3s; margin-bottom: 15px;
    }
    .custom-input:focus { outline: none; border-color: var(--kruskal-color); background: #fff; }

    .edge-row { display: flex; gap: 5px; margin-bottom: 8px; }
    .edge-row input { flex: 1; padding: 8px; border-radius: 8px; border: 1px solid #EFEBE9; }

    .btn-action {
        width: 100%; padding: 12px; border: none; border-radius: 12px;
        font-weight: 700; cursor: pointer; transition: 0.3s;
        display: flex; align-items: center; justify-content: center; gap: 8px;
    }
    .btn-add { background: #F1F8E9; color: var(--prim-color); margin-top: 5px; }
    .btn-add:hover { background: #DCEDC8; }

    .btn-run {
        background: linear-gradient(135deg, #FF7043 0%, #D84315 100%);
        color: white; font-size: 1rem; margin-top: 20px;
        box-shadow: 0 8px 20px rgba(216, 67, 21, 0.2);
    }
    .btn-run:hover { transform: translateY(-2px); box-shadow: 0 12px 25px rgba(216, 67, 21, 0.3); }

    .sample-group { display: flex; gap: 10px; margin-top: 10px; }
    .btn-sample { flex: 1; background: #fff; border: 1px solid #D7CCC8; color: #8D6E63; font-size: 0.8rem; padding: 8px; border-radius: 8px; cursor: pointer; }
    .btn-sample:hover { background: #EFEBE9; color: var(--text-color); }

    /* NÚT CHUYỂN TRANG COMPARE/ARENA */
    .btn-arena {
        background: linear-gradient(135deg, #42A5F5 0%, #1976D2 100%);
        color: white; margin-bottom: 20px;
        box-shadow: 0 8px 20px rgba(25, 118, 210, 0.2);
    }
    .btn-arena:hover { transform: translateY(-2px); box-shadow: 0 12px 25px rgba(25, 118, 210, 0.3); }

    /* === CENTER PANEL: CANVAS === */
    .canvas-wrapper { position: relative; width: 100%; height: 100%; background-color: #F5F5F5; overflow: hidden; cursor: grab; }
    .canvas-wrapper:active { cursor: grabbing; }

    .canvas-bg {
        position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        background-image: radial-gradient(#CFD8DC 1px, transparent 1px);
        background-size: 20px 20px;
        pointer-events: none;
    }

    .canvas-toolbar {
        position: absolute; top: 15px; right: 15px;
        display: flex; flex-direction: column; gap: 8px;
    }
    .tool-btn {
        width: 40px; height: 40px; border-radius: 10px; background: white; border: 1px solid #EFEBE9;
        display: flex; align-items: center; justify-content: center;
        color: #5D4037; font-size: 1rem; cursor: pointer; box-shadow: 0 4px 10px rgba(0,0,0,0.05); transition: 0.2s;
    }
    .tool-btn:hover { background: var(--prim-color); color: white; border-color: var(--prim-color); }

    .playback-controls {
        position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%);
        background: white; padding: 8px 15px; border-radius: 50px;
        display: flex; gap: 15px; align-items: center;
        box-shadow: 0 8px 25px rgba(0,0,0,0.1); border: 1px solid #EFEBE9;
    }
    .play-btn {
        width: 50px; height: 50px; border-radius: 50%; border: none;
        background: var(--prim-color); color: white; font-size: 1.2rem;
        cursor: pointer; display: flex; align-items: center; justify-content: center;
        transition: 0.3s;
    }
    .play-btn:hover { transform: scale(1.1); box-shadow: 0 5px 15px rgba(46, 125, 50, 0.3); }

    .speed-slider { width: 100px; accent-color: var(--kruskal-color); }

    /* === RIGHT PANEL: STEPS === */
    .step-list { display: flex; flex-direction: column; gap: 10px; }
    .step-card {
        background: #fff; border: 1px solid #EFEBE9; padding: 12px; border-radius: 12px;
        font-size: 0.9rem; transition: 0.3s;
        border-left: 4px solid transparent;
    }
    .step-card.active { border-left-color: var(--prim-color); background: #F1F8E9; transform: translateX(-5px); box-shadow: 0 4px 12px rgba(46, 125, 50, 0.1); }
    .step-card.kruskal-active { border-left-color: var(--kruskal-color); background: #FBE9E7; }

    .step-number { font-weight: 800; color: #8D6E63; margin-right: 8px; }
    .step-desc { color: var(--text-color); line-height: 1.4; }

    /* Responsive */
    @@media (max-width: 1200px) {
        .app-container { grid-template-columns: 1fr; height: auto; }
        .canvas-wrapper { height: 500px; border-radius: 20px; }
    }
</style>

<div class="app-container">

    <div class="glass-card">
        <div class="card-header">
            <div class="card-title"><i class="fas fa-sliders-h"></i> Cấu Hình Đồ Thị</div>
        </div>
        <div class="card-body">

            <a href="@Url.Action("Compare", "MoPhong")" class="btn-action btn-arena" style="text-decoration:none; text-align:center;">
                <i class="fas fa-bolt"></i> CHUYỂN SANG ĐẤU TRƯỜNG (RACE)
            </a>

            <div style="border-bottom: 1px dashed #EFEBE9; margin-bottom: 20px;"></div>

            <form method="post" action="@Url.Action("Result", "MoPhong")" id="graphForm">
                <div class="input-group">
                    <label>Danh sách Đỉnh (cách nhau dấu phẩy)</label>
                    <input type="text" name="nodes" id="nodesInput" class="custom-input"
                           value="@(ViewBag.Nodes ?? "A,B,C,D,E")" placeholder="VD: A, B, C..." required />
                </div>

                <div class="input-group">
                    <label>Danh sách Cạnh (Từ - Đến - Trọng số)</label>
                    <div id="edgesContainer" style="max-height: 250px; overflow-y: auto; margin-bottom: 10px;">
                        @if (ViewBag.Src != null)
                        {
                            var s = ViewBag.Src as string[]; var d = ViewBag.Dest as string[]; var w = ViewBag.Weight as int[];
                            for (int i = 0; i < s.Length; i++)
                            {
                                <div class="edge-row">
                                    <input type="text" name="src[]" value="@s[i]" placeholder="Từ" required>
                                    <input type="text" name="dest[]" value="@d[i]" placeholder="Đến" required>
                                    <input type="number" name="weight[]" value="@w[i]" placeholder="W" required>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="edge-row">
                                <input type="text" name="src[]" placeholder="Từ" required>
                                <input type="text" name="dest[]" placeholder="Đến" required>
                                <input type="number" name="weight[]" placeholder="W" required>
                            </div>
                        }
                    </div>
                    <button type="button" class="btn-action btn-add" onclick="addEdgeRow()">
                        <i class="fas fa-plus-circle"></i> Thêm Cạnh
                    </button>
                </div>

                <div class="input-group" style="margin-top: 20px;">
                    <label>Thuật Toán</label>
                    <select name="algorithm" class="custom-input">
                        <option value="Prim" @(ViewBag.Algorithm == "Prim" ? "selected" : "")>Prim (Loang dầu)</option>
                        <option value="Kruskal" @(ViewBag.Algorithm == "Kruskal" ? "selected" : "")>Kruskal (Kết nối)</option>
                    </select>
                </div>

                <div class="sample-group">
                    <button type="button" class="btn-sample" onclick="loadSample(1)">Mẫu Nhỏ</button>
                    <button type="button" class="btn-sample" onclick="loadSample(2)">Mẫu Lớn</button>
                </div>

                <button type="submit" class="btn-action btn-run">
                    <i class="fas fa-play"></i> CHẠY MÔ PHỎNG
                </button>
            </form>
            @if (ViewBag.Error != null)
            {<div style="color: #D32F2F; margin-top: 10px; font-size: 0.9rem;">@ViewBag.Error</div>}
        </div>
    </div>

    <div class="glass-card" style="overflow: visible;">
        <div class="canvas-wrapper" id="canvasContainer">
            <div class="canvas-bg"></div>
            <canvas id="mainCanvas"></canvas>

            <div class="canvas-toolbar">
                <button class="tool-btn" onclick="zoomCanvas(1.1)"><i class="fas fa-plus"></i></button>
                <button class="tool-btn" onclick="zoomCanvas(0.9)"><i class="fas fa-minus"></i></button>
                <button class="tool-btn" onclick="resetCanvas()"><i class="fas fa-compress"></i></button>
            </div>

            <div class="playback-controls">
                <button class="play-btn" id="playPauseBtn"><i class="fas fa-play"></i></button>
                <div style="display:flex; flex-direction:column; gap:2px;">
                    <span style="font-size:0.7rem; font-weight:700; color:#8D6E63">TỐC ĐỘ</span>
                    <input type="range" class="speed-slider" min="100" max="2000" step="100" value="1000" id="speedRange">
                </div>
                <div style="font-size:0.9rem; font-weight:800; color:var(--text-color);" id="stepIndicator">0 / 0</div>
            </div>
        </div>
    </div>

    <div class="glass-card">
        <div class="card-header">
            <div class="card-title"><i class="fas fa-list-ul"></i> Nhật Ký Chạy</div>
            <div class="card-title" style="font-size:0.9rem; color:#8D6E63">
                @(ViewBag.Result != null ? ((List<Prim_Kruskal_Web.Models.Edge>)ViewBag.Result).Sum(e => e.Weight) + " Tổng W" : "0")
            </div>
        </div>
        <div class="card-body">
            <div class="step-list" id="stepList">
                <div style="text-align:center; color:#BCAAA4; margin-top:50px;">
                    <i class="fas fa-wind" style="font-size:3rem; margin-bottom:10px;"></i>
                    <p>Chưa có dữ liệu chạy.</p>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
    // DATA FROM SERVER
    const rawNodes = @Html.Raw(ViewBag.NodesJson ?? "[]");
    const allEdges = @Html.Raw(ViewBag.AllEdgesJson ?? "[]");
    const primSteps = @Html.Raw(ViewBag.PrimStepsJson ?? "[]");
    const kruskalSteps = @Html.Raw(ViewBag.KruskalStepsJson ?? "[]");
    const resultEdges = @Html.Raw(ViewBag.ResultJson ?? "[]");
    const currentAlgo = '@ViewBag.Algorithm';

    const steps = currentAlgo === 'Kruskal' ? kruskalSteps : primSteps;
    const activeColor = currentAlgo === 'Kruskal' ? '#D84315' : '#2E7D32'; // Cam hoặc Xanh
    const activeClass = currentAlgo === 'Kruskal' ? 'kruskal-active' : 'active';

    // CANVAS SETUP
    const canvas = document.getElementById('mainCanvas');
    const container = document.getElementById('canvasContainer');
    const ctx = canvas.getContext('2d');

    let width, height;
    let d3Nodes = [], d3Links = [];
    let simulation;
    let transform = d3.zoomIdentity;

    // Animation State
    let currentStep = 0;
    let isPlaying = false;
    let animationInterval;
    let speed = 1000;

    // INIT
    function init() {
        resizeCanvas();
        window.addEventListener('resize', resizeCanvas);

        if (rawNodes.length > 0) {
            setupSimulation();
            renderStepList();
            document.getElementById('stepIndicator').innerText = `0 / ${steps.length}`;
        }
    }

    function resizeCanvas() {
        width = container.clientWidth;
        height = container.clientHeight;
        canvas.width = width;
        canvas.height = height;
        if(simulation) simulation.alpha(0.3).restart(); // Wake up sim
    }

    function setupSimulation() {
        // Clone data for D3
        d3Nodes = rawNodes.map(n => ({ id: n.Name, ...n }));
        d3Links = allEdges.map(e => ({ source: e.Src.Name, target: e.Destination.Name, weight: e.Weight }));

        simulation = d3.forceSimulation(d3Nodes)
            .force("link", d3.forceLink(d3Links).id(d => d.id).distance(150))
            .force("charge", d3.forceManyBody().strength(-500))
            .force("center", d3.forceCenter(width / 2, height / 2))
            .force("collide", d3.forceCollide(40))
            .on("tick", draw);

        // Zoom & Drag behavior using D3
        const d3Canvas = d3.select(canvas);

        d3Canvas.call(d3.drag()
            .subject(event => {
                const [x, y] = d3.pointer(event);
                const tx = transform.invertX(x), ty = transform.invertY(y);
                return d3Nodes.find(n => Math.hypot(tx - n.x, ty - n.y) < 25);
            })
            .on("start", dragstarted)
            .on("drag", dragged)
            .on("end", dragended));

        d3Canvas.call(d3.zoom()
            .scaleExtent([0.1, 5])
            .on("zoom", event => {
                transform = event.transform;
                draw();
            }));
    }

    // DRAW LOOP
    function draw() {
        ctx.save();
        ctx.clearRect(0, 0, width, height);
        ctx.translate(transform.x, transform.y);
        ctx.scale(transform.k, transform.k);

        // 1. Draw Links
        d3Links.forEach(link => {
            ctx.beginPath();
            ctx.moveTo(link.source.x, link.source.y);
            ctx.lineTo(link.target.x, link.target.y);
            ctx.strokeStyle = "#BCAAA4";
            ctx.lineWidth = 2;
            ctx.stroke();

            // Weight Label (nền trắng tròn)
            const mx = (link.source.x + link.target.x) / 2;
            const my = (link.source.y + link.target.y) / 2;

            ctx.beginPath();
            ctx.arc(mx, my, 12, 0, 2*Math.PI);
            ctx.fillStyle = "#fff";
            ctx.fill();
            ctx.strokeStyle = "#EFEBE9";
            ctx.lineWidth = 1;
            ctx.stroke();

            ctx.fillStyle = "#5D4037";
            ctx.font = "bold 10px Nunito";
            ctx.textAlign = "center";
            ctx.textBaseline = "middle";
            ctx.fillText(link.weight, mx, my);
        });

        // 2. Draw MST / Active Edges based on currentStep
        if (currentStep > 0 && steps.length > 0) {
            // Lấy danh sách cạnh MST tại bước hiện tại
            // Lưu ý: steps[i] chứa danh sách MST tính đến lúc đó
            const stepData = steps[currentStep - 1]; // steps index 0 is Step 1
            const mstEdges = stepData.CurrentMSTEdges || [];

            mstEdges.forEach(edge => {
                const s = d3Nodes.find(n => n.id === edge.Src.Name);
                const t = d3Nodes.find(n => n.id === edge.Destination.Name);
                if (s && t) {
                    ctx.beginPath();
                    ctx.moveTo(s.x, s.y);
                    ctx.lineTo(t.x, t.y);
                    ctx.strokeStyle = activeColor;
                    ctx.lineWidth = 5;
                    ctx.lineCap = "round";
                    ctx.stroke();
                }
            });

            // Highlight cạnh vừa xét (nếu có trong description)
            // Logic này có thể phức tạp, tạm thời ta chỉ vẽ MST đã
        }

        // 3. Draw Nodes
        d3Nodes.forEach(node => {
            // Check if visited
            let isVisited = false;
            if (currentStep > 0 && steps[currentStep - 1].VisitedNodes) {
                // Mapping ID -> Name hoặc ID -> ID tùy vào logic backend
                // Ở đây giả sử VisitedNodes chứa ID int, ta cần map về node object
                // Code đơn giản: Tô màu tất cả nếu nằm trong MST
                // Thực tế nên check ID chính xác.
            }

            ctx.beginPath();
            ctx.arc(node.x, node.y, 20, 0, 2 * Math.PI);
            ctx.fillStyle = "#fff";
            ctx.fill();
            ctx.strokeStyle = "#5D4037"; // Coffee border
            ctx.lineWidth = 2;
            ctx.stroke();

            ctx.fillStyle = "#3E2723";
            ctx.font = "bold 14px Quicksand";
            ctx.textAlign = "center";
            ctx.textBaseline = "middle";
            ctx.fillText(node.id, node.x, node.y);
        });

        ctx.restore();
    }

    // DRAG HANDLERS
    function dragstarted(event) { if (!event.active) simulation.alphaTarget(0.3).restart(); event.subject.fx = event.subject.x; event.subject.fy = event.subject.y; }
    function dragged(event) { event.subject.fx = transform.invertX(event.x); event.subject.fy = transform.invertY(event.y); }
    function dragended(event) { if (!event.active) simulation.alphaTarget(0); event.subject.fx = null; event.subject.fy = null; }

    // RENDER LIST
    function renderStepList() {
        const list = document.getElementById('stepList');
        if (steps.length === 0) return;

        list.innerHTML = steps.map((s, i) => `
            <div class="step-card" id="step-card-${i + 1}">
                <span class="step-number">#${s.StepNumber}</span>
                <span class="step-desc">${s.Description}</span>
            </div>
        `).join('');
    }

    // PLAYBACK LOGIC
    function setStep(step) {
        if (step < 0) step = 0;
        if (step > steps.length) step = steps.length;
        currentStep = step;

        // Update Indicator
        document.getElementById('stepIndicator').innerText = `${currentStep} / ${steps.length}`;

        // Highlight List
        document.querySelectorAll('.step-card').forEach(el => el.className = 'step-card');
        if (currentStep > 0) {
            const card = document.getElementById(`step-card-${currentStep}`);
            if (card) {
                card.classList.add(activeClass);
                card.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }

        draw();
    }

    document.getElementById('playPauseBtn').onclick = () => {
        if (isPlaying) {
            clearInterval(animationInterval);
            isPlaying = false;
            document.getElementById('playPauseBtn').innerHTML = '<i class="fas fa-play"></i>';
        } else {
            if (currentStep === steps.length) currentStep = 0; // Restart
            isPlaying = true;
            document.getElementById('playPauseBtn').innerHTML = '<i class="fas fa-pause"></i>';
            animationInterval = setInterval(() => {
                if (currentStep < steps.length) {
                    setStep(currentStep + 1);
                } else {
                    clearInterval(animationInterval);
                    isPlaying = false;
                    document.getElementById('playPauseBtn').innerHTML = '<i class="fas fa-play"></i>';
                }
            }, speed);
        }
    };

    // Speed Control (Đảo ngược: Giá trị càng nhỏ càng nhanh)
    document.getElementById('speedRange').oninput = (e) => {
        // Slider: 100 (Nhanh) -> 2000 (Chậm)
        // Nhưng UI thường muốn Kéo phải = Nhanh.
        // Ta để slider value là delay ms. Kéo phải (tăng) -> Chậm? Không logic.
        // Logic tốt nhất: Value slider = Speed (1x, 2x). Ở đây để đơn giản giữ nguyên Delay.
        speed = parseInt(e.target.value);
        if (isPlaying) {
            // Reset interval với tốc độ mới
            clearInterval(animationInterval);
            animationInterval = setInterval(() => {
                if (currentStep < steps.length) setStep(currentStep + 1);
                else { clearInterval(animationInterval); isPlaying = false; document.getElementById('playPauseBtn').innerHTML = '<i class="fas fa-play"></i>'; }
            }, speed);
        }
    };

    // Helper functions
    function addEdgeRow() {
        const div = document.createElement('div');
        div.className = 'edge-row';
        div.innerHTML = `<input type="text" name="src[]" placeholder="Từ" required>
                         <input type="text" name="dest[]" placeholder="Đến" required>
                         <input type="number" name="weight[]" placeholder="W" required>`;
        document.getElementById('edgesContainer').appendChild(div);
    }

    function loadSample(id) {
        const nInput = document.getElementById('nodesInput');
        const cContainer = document.getElementById('edgesContainer');
        cContainer.innerHTML = ''; // Clear old

        if(id === 1) {
            nInput.value = "A,B,C,D,E";
            addE("A","B",4); addE("A","C",2); addE("B","C",1); addE("B","D",5);
            addE("C","D",8); addE("C","E",10); addE("D","E",2);
        } else {
            nInput.value = "1,2,3,4,5,6,7";
            addE("1","2",2); addE("1","3",4); addE("1","4",1);
            addE("2","4",3); addE("2","5",10); addE("3","4",2);
            addE("3","6",5); addE("4","5",7); addE("4","6",8); addE("4","7",4);
            addE("5","7",6); addE("6","7",1);
        }
    }

    function addE(s,d,w) {
        const div = document.createElement('div');
        div.className = 'edge-row';
        div.innerHTML = `<input type="text" name="src[]" value="${s}">
                         <input type="text" name="dest[]" value="${d}">
                         <input type="number" name="weight[]" value="${w}">`;
        document.getElementById('edgesContainer').appendChild(div);
    }

    // Zoom control
    function zoomCanvas(factor) {
        const t = d3.zoomIdentity.translate(width/2, height/2).scale(transform.k * factor).translate(-width/2, -height/2);
        // Cần gọi qua D3 behavior để update state nội bộ, nhưng ở đây hack nhanh bằng biến global
        // Cách đúng: d3.select(canvas).call(zoom.transform, t);
        // Để đơn giản, ta chỉ scale biến transform global dùng trong draw()
        transform.k *= factor;
        draw();
    }
    function resetCanvas() {
        transform = { k: 1, x: 0, y: 0 };
        if(simulation) simulation.force("center", d3.forceCenter(width/2, height/2)).alpha(0.3).restart();
    }

    init();
</script>