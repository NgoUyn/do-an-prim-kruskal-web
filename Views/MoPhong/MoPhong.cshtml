@{
    ViewBag.Title = "Mô Phỏng Thuật Toán - Giao Diện Cao Cấp";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="https://d3js.org/d3.v7.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    /* --- 1. CORE THEME --- */
    :root {
        --prim-color: #2E7D32; /* Xanh lá */
        --prim-bg: #E8F5E9;
        --kruskal-color: #D84315; /* Cam đỏ */
        --kruskal-bg: #FBE9E7;
        --ai-color: #6A1B9A; /* Tím */
        --ai-bg: #F3E5F5;
        --bg-body: #F4F6F8;
        --text-main: #37474F;
        --radius: 12px;
    }

    body {
        background-color: var(--bg-body);
        font-family: 'Nunito', sans-serif;
        color: var(--text-main);
    }

    /* --- 2. LAYOUT GRID --- */
    .lab-container {
        display: grid;
        grid-template-columns: 360px 1fr 1fr;
        grid-template-rows: auto auto auto;
        gap: 24px;
        padding: 24px;
        max-width: 1800px;
        margin: 0 auto 50px auto;
    }

    /* --- 3. PANEL COMPONENT --- */
    .panel {
        background: white;
        border-radius: var(--radius);
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        border: 1px solid #ECEFF1;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .panel-head {
        padding: 16px 20px;
        font-weight: 800;
        text-transform: uppercase;
        font-size: 0.9rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #ECEFF1;
        background: #fff;
        color: #455A64;
    }

    /* --- 4. CONTROLS & BUTTONS --- */
    .control-group {
        margin-bottom: 16px;
    }

    .control-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #90A4AE;
        margin-bottom: 6px;
        display: block;
    }

    .form-select, .form-input {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #CFD8DC;
        border-radius: 8px;
        font-family: inherit;
        font-size: 0.95rem;
        color: #37474F;
        background-color: #FAFAFA;
    }

    .btn-tool {
        border: none;
        padding: 10px;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 0.9rem;
    }

    .btn-gen {
        background: #E1F5FE;
        color: #0288D1;
        font-weight: 600;
    }

    .btn-run {
        background: linear-gradient(135deg, #FF7043, #D84315);
        color: white;
        width: 100%;
        font-size: 1.1rem;
        padding: 14px;
        margin-top: 10px;
        box-shadow: 0 4px 10px rgba(216, 67, 21, 0.3);
    }

    .btn-clear {
        background: #FFEBEE;
        color: #C62828;
        width: 100%;
    }

    /* --- 5. VISUALIZATION & STATS --- */
    .canvas-area {
        height: 420px;
        position: relative;
        cursor: crosshair;
        background: #FAFAFA;
        overflow: hidden;
    }

    .stat-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        padding: 15px;
        background: #fff;
        border-top: 1px solid #ECEFF1;
    }

    .stat-card {
        background: #F5F7F8;
        padding: 10px;
        border-radius: 8px;
        text-align: center;
        border: 1px solid #ECEFF1;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .stat-val {
        font-size: 1.2rem;
        font-weight: 900;
        margin-bottom: 4px;
    }

    .stat-lbl {
        font-size: 0.7rem;
        text-transform: uppercase;
        color: #90A4AE;
        font-weight: 700;
    }

    .theory-val {
        color: #546E7A;
        font-family: 'Consolas', monospace;
    }

    /* --- 6. LOGS & AI --- */
    .log-panel {
        grid-column: 2 / -1;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        padding: 0;
        height: 400px;
        background: transparent;
        box-shadow: none;
        border: none;
    }

    .log-col {
        background: white;
        border-radius: var(--radius);
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        border: 1px solid #ECEFF1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .log-wrapper {
        flex: 1;
        overflow-y: auto;
    }

    table.log-table {
        width: 100%;
        font-size: 0.85rem;
        border-collapse: collapse;
    }

        table.log-table th {
            position: sticky;
            top: 0;
            background: #F5F5F5;
            padding: 10px;
            text-align: left;
            font-weight: 700;
            color: #546E7A;
            border-bottom: 1px solid #CFD8DC;
            z-index: 2;
        }

        table.log-table td {
            padding: 8px 10px;
            border-bottom: 1px solid #F5F5F5;
            color: #455A64;
        }

    .log-step-select {
        background-color: #E8F5E9 !important;
        border-left: 4px solid var(--prim-color);
    }

    .log-step-reject {
        background-color: #FFEBEE !important;
        color: #C62828;
        opacity: 0.8;
    }

    .full-width-panel {
        grid-column: 1 / -1;
    }

    .ai-content {
        padding: 25px;
        font-size: 0.95rem;
        line-height: 1.7;
        color: #263238;
        background: #fff;
    }

        .ai-content h1, .ai-content h2 {
            color: var(--ai-color);
            margin-top: 0;
            font-size: 1.1rem;
        }

    /* --- 7. BENCHMARK --- */
    .benchmark-controls {
        display: flex;
        gap: 20px;
        padding: 20px;
        background: #FAFAFA;
        border-bottom: 1px solid #eee;
        align-items: flex-end;
    }

    .chart-container {
        position: relative;
        height: 500px;
        width: 100%;
        padding: 15px;
        background: #fff;
    }

    @@media (max-width: 1200px) {
        .lab-container {
            grid-template-columns: 1fr;
        }

        .log-panel {
            grid-template-columns: 1fr;
            height: auto;
        }

        .log-col {
            height: 350px;
        }
    }
</style>

<div class="lab-container">

    <div class="panel">
        <div class="panel-head">
            <span><i class="fas fa-network-wired"></i> Input Graph</span>
            <span style="color: #0288D1; background: #E1F5FE; padding: 2px 8px; border-radius: 4px;" id="nodeCount">0 Nodes</span>
        </div>

        <div style="padding: 20px;">
            <div class="control-group">
                <span class="control-label">1. Chế độ Đồ thị</span>
                <select id="graphMode" class="form-select" onchange="updateModeInfo()">
                    <option value="sparse">🔵 Thưa (Sparse - Kruskal Win)</option>
                    <option value="fair">🟣 Trung Bình (Fair - Balanced)</option>
                    <option value="dense">🔴 Dày (Dense - Prim Win)</option>
                </select>
                <div id="modeInfo" style="color: #FF9800; font-size: 0.75rem; margin-top: 6px; font-style: italic;">* Mật độ cạnh thấp. Kruskal thường nhanh hơn.</div>
            </div>

            <div class="control-group">
                <span class="control-label">2. Sinh dữ liệu mẫu</span>
                <div style="display:flex; gap: 10px;">
                    <button class="btn-tool btn-gen" style="flex:1" onclick="genRandom(10)">10</button>
                    <button class="btn-tool btn-gen" style="flex:1" onclick="genRandom(30)">30</button>
                    <button class="btn-tool btn-gen" style="flex:1" onclick="genRandom(50)">50</button>
                </div>
                <div style="margin-top: 10px; display:flex; gap: 10px;">
                    <input type="number" id="customN" class="form-input" placeholder="Số lượng..." value="100" style="flex: 1;">
                    <button class="btn-tool" style="background: #ECEFF1; color: #455A64; width: 80px;" onclick="genCustom()">Tạo</button>
                </div>
            </div>

            <div class="control-group" style="margin-top: 20px; padding-top: 15px; border-top: 1px dashed #CFD8DC;">
                <span class="control-label" style="color: var(--prim-color);">3. Cấu trúc dữ liệu Prim</span>
                <select id="primVariant" class="form-select" style="border: 1px solid var(--prim-color); color: var(--prim-color); font-weight: 600;">
                    <option value="Standard">1. Standard [O(V²)]</option>
                    <option value="Matrix">2. Matrix [O(V²)]</option>
                    <option value="Heap">3. Binary Heap [O(E log V)]</option>
                </select>
            </div>
        </div>

        <div class="canvas-area"><canvas id="inputCanvas"></canvas></div>

        <div style="padding: 20px;">
            <button class="btn-tool btn-clear" onclick="clearCanvas()"><i class="fas fa-trash-alt"></i> Xóa Trắng</button>
            <button class="btn-tool btn-run" onclick="runAlgorithmsAsync()"><i class="fas fa-play"></i> CHẠY SO SÁNH</button>
        </div>
    </div>

    <div class="panel" style="border-top: 4px solid var(--prim-color);">
        <div class="panel-head" style="background: var(--prim-bg);">
            <span style="color: var(--prim-color);"><i class="fas fa-bezier-curve"></i> PRIM</span>
            <span id="p-algo" style="background:white; padding:2px 8px; border-radius:12px; font-size:0.75rem; font-weight:bold; color:var(--prim-color)">O(V²)</span>
        </div>
        <div class="canvas-area" id="primViz"></div>

        <div style="padding: 10px 20px; background: #fff; border-bottom: 1px solid #eee;">
            <input type="range" id="primSlider" min="0" value="0" disabled oninput="updateTimeTravel('Prim', this.value)" style="width:100%;">
            <div style="display:flex; justify-content:space-between; font-size:0.75rem; font-weight:700; color:#90A4AE; margin-top:5px;">
                <span>Start</span>
                <span style="color: var(--prim-color);">Step: <span id="primStepLbl">0</span>/<span id="primTotalLbl">0</span></span>
                <span>End</span>
            </div>
        </div>

        <div class="stat-grid">
            <div class="stat-card"><div class="stat-val" id="p-time" style="color: var(--prim-color);">0 ms</div><div class="stat-lbl">Thời Gian Thực</div></div>
            <div class="stat-card"><div class="stat-val theory-val" id="p-theory">0</div><div class="stat-lbl">Lý thuyết (Big-O)</div></div>
            <div class="stat-card"><div class="stat-val" id="p-cost">0</div><div class="stat-lbl">Tổng Chi Phí</div></div>
            <div class="stat-card"><div class="stat-val" id="p-steps-val">0</div><div class="stat-lbl">Tổng Số Bước</div></div>
        </div>
    </div>

    <div class="panel" style="border-top: 4px solid var(--kruskal-color);">
        <div class="panel-head" style="background: var(--kruskal-bg);">
            <span style="color: var(--kruskal-color);"><i class="fas fa-tree"></i> KRUSKAL</span>
            <span style="background:white; padding:2px 8px; border-radius:12px; font-size:0.75rem; font-weight:bold; color:var(--kruskal-color)">O(E log E)</span>
        </div>
        <div class="canvas-area" id="kruskalViz"></div>

        <div style="padding: 10px 20px; background: #fff; border-bottom: 1px solid #eee;">
            <input type="range" id="kruskalSlider" min="0" value="0" disabled oninput="updateTimeTravel('Kruskal', this.value)" style="width:100%;">
            <div style="display:flex; justify-content:space-between; font-size:0.75rem; font-weight:700; color:#90A4AE; margin-top:5px;">
                <span>Start</span>
                <span style="color: var(--kruskal-color);">Step: <span id="kruskalStepLbl">0</span>/<span id="kruskalTotalLbl">0</span></span>
                <span>End</span>
            </div>
        </div>

        <div class="stat-grid">
            <div class="stat-card"><div class="stat-val" id="k-time" style="color: var(--kruskal-color);">0 ms</div><div class="stat-lbl">Thời Gian Thực</div></div>
            <div class="stat-card"><div class="stat-val theory-val" id="k-theory">0</div><div class="stat-lbl">Lý thuyết (Big-O)</div></div>
            <div class="stat-card"><div class="stat-val" id="k-cost">0</div><div class="stat-lbl">Tổng Chi Phí</div></div>
            <div class="stat-card"><div class="stat-val" id="k-steps-val">0</div><div class="stat-lbl">Tổng Số Bước</div></div>
        </div>
    </div>

    <div class="log-panel full-width-panel">
        <div class="log-col" style="border-top: 4px solid var(--prim-color);">
            <div class="panel-head">Nhật Ký Prim</div>
            <div class="log-wrapper">
                <table class="log-table" id="primLog">
                    <thead><tr><th width="40px">#</th><th>Hành động</th><th width="60px">W</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
        <div class="log-col" style="border-top: 4px solid var(--kruskal-color);">
            <div class="panel-head">Nhật Ký Kruskal</div>
            <div class="log-wrapper">
                <table class="log-table" id="kruskalLog">
                    <thead><tr><th width="40px">#</th><th>Hành động</th><th width="60px">W</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="panel ai-panel full-width-panel" id="aiSimPanel" style="border-top: 4px solid var(--ai-color); display: none;">
        <div class="panel-head" style="background: #F3E5F5;">
            <span style="color: var(--ai-color);"><i class="fas fa-robot"></i> GEMINI AI NHẬN XÉT (MÔ PHỎNG)</span>
        </div>
        <div class="ai-content markdown-body" id="aiSimContent">Đang chờ chạy...</div>
    </div>

    <div class="panel full-width-panel">
        <div class="panel-head">
            <span><i class="fas fa-tachometer-alt"></i> Benchmark: Thực Tế (ms) vs Lý Thuyết (Big-O)</span>
        </div>

        <div class="benchmark-controls">
            <div style="flex:1">
                <label class="control-label">Start N</label>
                <input type="number" id="bnStart" class="form-input" value="100" min="10">
            </div>
            <div style="flex:1">
                <label class="control-label">End N</label>
                <input type="number" id="bnEnd" class="form-input" value="1000" min="100">
            </div>
            <div style="flex:1">
                <label class="control-label">Step</label>
                <input type="number" id="bnStep" class="form-input" value="100" min="10">
            </div>
            <div style="flex:2">
                <label class="control-label">&nbsp;</label>
                <button class="btn-tool" style="background:#263238; color:white; width:100%" id="btnBenchmark" onclick="runBenchmark()">
                    <i class="fas fa-rocket"></i> CHẠY TEST (5 Lần/Step)
                </button>
            </div>
        </div>
        <div id="benchStatus" style="text-align:center; padding: 10px; font-weight:bold; color: #D84315;"></div>

        <div class="chart-container">
            <canvas id="benchChart"></canvas>
        </div>
    </div>

    <div class="panel ai-panel full-width-panel" id="aiBenchPanel" style="border-top: 4px solid #37474F; display: none;">
        <div class="panel-head" style="background: #ECEFF1;">
            <span style="color: #37474F;"><i class="fas fa-chart-bar"></i> GEMINI AI NHẬN XÉT (BENCHMARK)</span>
        </div>
        <div class="ai-content markdown-body" id="aiBenchContent">Chạy benchmark để xem phân tích...</div>
    </div>
</div>

<script>
    // ==========================================
    // 1. GLOBAL VARIABLES
    // ==========================================
    let inputNodes = [], inputEdges = [], nextChar = 0;
    let primDetailedSteps = [], kruskalDetailedSteps = [];
    let primSvgGroups = null, kruskalSvgGroups = null;

    const iCanvas = document.getElementById('inputCanvas');
    const iCtx = iCanvas.getContext('2d');
    let selectedNode = null;

    function resizeInput() {
        if (!iCanvas.parentElement) return;
        iCanvas.width = iCanvas.parentElement.clientWidth;
        iCanvas.height = iCanvas.parentElement.clientHeight;
        drawInput();
    }
    window.addEventListener('resize', resizeInput);

    // ==========================================
    // 2. CANVAS LOGIC
    // ==========================================
    iCanvas.addEventListener('mousedown', e => {
        const rect = iCanvas.getBoundingClientRect();
        const x = e.clientX - rect.left; const y = e.clientY - rect.top;
        const clicked = inputNodes.find(n => Math.hypot(n.x - x, n.y - y) < 20);

        if (!clicked) {
            inputNodes.push({ id: String(nextChar++), x, y });
            selectedNode = null;
        } else {
            if (!selectedNode) selectedNode = clicked;
            else if (selectedNode === clicked) selectedNode = null;
            else {
                const exist = inputEdges.find(e => (e.u === selectedNode.id && e.v === clicked.id) || (e.u === clicked.id && e.v === selectedNode.id));
                if (!exist) {
                    const w = Math.floor(Math.random() * 50) + 1;
                    inputEdges.push({ u: selectedNode.id, v: clicked.id, w: w });
                }
                selectedNode = null;
            }
        }
        drawInput(); updateUI();
    });

    function drawInput() {
        iCtx.clearRect(0, 0, iCanvas.width, iCanvas.height);
        iCtx.strokeStyle = "#ECEFF1"; iCtx.lineWidth = 1; iCtx.beginPath();
        for (let i = 0; i < iCanvas.width; i += 20) { iCtx.moveTo(i, 0); iCtx.lineTo(i, iCanvas.height); }
        for (let i = 0; i < iCanvas.height; i += 20) { iCtx.moveTo(0, i); iCtx.lineTo(iCanvas.width, i); }
        iCtx.stroke();

        inputEdges.forEach(e => {
            const n1 = inputNodes.find(n=>n.id===e.u), n2 = inputNodes.find(n=>n.id===e.v);
            if (n1 && n2) {
                iCtx.beginPath(); iCtx.moveTo(n1.x, n1.y); iCtx.lineTo(n2.x, n2.y);
                iCtx.strokeStyle = "#B0BEC5"; iCtx.lineWidth = 2; iCtx.stroke();
                const mx = (n1.x + n2.x) / 2, my = (n1.y + n2.y) / 2;
                iCtx.fillStyle = "#fff"; iCtx.beginPath(); iCtx.arc(mx, my, 10, 0, Math.PI * 2); iCtx.fill();
                iCtx.fillStyle = "#546E7A"; iCtx.font = "bold 10px Nunito"; iCtx.textAlign = "center"; iCtx.textBaseline = "middle"; iCtx.fillText(e.w, mx, my);
            }
        });

        inputNodes.forEach(n => {
            iCtx.beginPath(); iCtx.arc(n.x, n.y, 14, 0, Math.PI * 2);
            iCtx.fillStyle = (selectedNode === n) ? "#FFF9C4" : "#E1F5FE";
            iCtx.fill();
            iCtx.strokeStyle = (selectedNode === n) ? "#FBC02D" : "#0288D1";
            iCtx.lineWidth = (selectedNode === n) ? 3 : 2; iCtx.stroke();
            iCtx.fillStyle = "#01579B"; iCtx.font = "bold 12px Nunito"; iCtx.textAlign = "center"; iCtx.textBaseline = "middle"; iCtx.fillText(n.id, n.x, n.y);
        });
    }

    // ==========================================
    // 3. GENERATION LOGIC
    // ==========================================
    function genRandom(n) {
        inputNodes = []; inputEdges = []; nextChar = n;
        const w = iCanvas.width, h = iCanvas.height;
        for (let i = 0; i < n; i++) inputNodes.push({ id: String(i), x: Math.random() * (w - 60) + 30, y: Math.random() * (h - 60) + 30 });
        for (let i = 0; i < n - 1; i++) inputEdges.push({ u: String(i), v: String(i + 1), w: Math.floor(Math.random() * 90) + 10 });

        let mode = document.getElementById('graphMode').value;
        let extra = mode === 'sparse' ? Math.floor(n*0.2) : (mode === 'fair' ? Math.floor(n*1.5) : Math.floor(n*n*0.1));

        for (let k = 0; k < extra; k++) {
            let u = Math.floor(Math.random() * n), v = Math.floor(Math.random() * n);
            if (u !== v && !inputEdges.some(e => (e.u == u && e.v == v) || (e.u == v && e.v == u)))
                inputEdges.push({ u: String(u), v: String(v), w: Math.floor(Math.random() * 90) + 10 });
        }
        drawInput(); updateUI();
    }

    function genCustom() {
        let val = prompt("Nhập số đỉnh (Max 200):", "50");
        if(val) genRandom(parseInt(val));
    }

    function clearCanvas() { inputNodes = []; inputEdges = []; nextChar = 0; selectedNode = null; drawInput(); updateUI(); }
    function updateUI() { document.getElementById('nodeCount').innerText = inputNodes.length + " Nodes"; }
    function updateModeInfo() {
        const m = document.getElementById('graphMode').value;
        const i = document.getElementById('modeInfo');
        if(m=='sparse') i.innerText = "* Mật độ thấp. Kruskal thường nhanh hơn.";
        else if(m=='fair') i.innerText = "* Cân bằng. Cạnh tranh khốc liệt.";
        else i.innerText = "* Rất nhiều cạnh. Prim O(V²) lợi thế tuyệt đối.";
    }

    // ==========================================
    // 4. API CALL (FIX LỖI URL)
    // ==========================================
    async function runAlgorithmsAsync() {
        if (inputNodes.length < 2) return alert("Cần tối thiểu 2 đỉnh!");
        const formData = new FormData();
        formData.append('nodes', inputNodes.map(n => n.id).join(','));
        inputEdges.forEach(e => { formData.append('src[]', e.u); formData.append('dest[]', e.v); formData.append('weight[]', e.w); });
        formData.append('primVariant', document.getElementById('primVariant').value);

        document.getElementById('aiSimPanel').style.display = 'block';
        document.getElementById('aiSimContent').innerHTML = '<div style="text-align:center; padding:20px; color:#6A1B9A"><i class="fas fa-spinner fa-spin fa-2x"></i><br>AI đang phân tích độ phức tạp...</div>';

        try {
            // FIX: Dùng Url.Action để đảm bảo đường dẫn đúng
            const res = await fetch('@Url.Action("RunDualApi", "MoPhong")', { method: 'POST', body: formData });
            const data = await res.json();

            if (data.success) {
                renderStats(data);

                primDetailedSteps = simulatePrimSteps(data.graph.nodes, data.graph.edges);
                kruskalDetailedSteps = simulateKruskalSteps(data.graph.nodes, data.graph.edges);

                setupSlider('primSlider', primDetailedSteps.length);
                setupSlider('kruskalSlider', kruskalDetailedSteps.length);

                primSvgGroups = initD3Graph('primViz', data.graph, '#2E7D32');
                kruskalSvgGroups = initD3Graph('kruskalViz', data.graph, '#D84315');

                // FIX: Hàm này giờ sẽ tìm thấy table#primLog
                renderFullLog('primLog', primDetailedSteps);
                renderFullLog('kruskalLog', kruskalDetailedSteps);

                document.getElementById('primSlider').value = primDetailedSteps.length;
                updateTimeTravel('Prim', primDetailedSteps.length);
                document.getElementById('kruskalSlider').value = kruskalDetailedSteps.length;
                updateTimeTravel('Kruskal', kruskalDetailedSteps.length);

                if (data.analysis) document.getElementById('aiSimContent').innerHTML = marked.parse(data.analysis);
            } else { alert(data.message); }
        } catch (e) { console.error(e); alert("Lỗi kết nối Server! Vui lòng kiểm tra Console (F12)."); }
    }

    async function runBenchmark() {
        const start = parseInt(document.getElementById('bnStart').value);
        const end = parseInt(document.getElementById('bnEnd').value);
        const step = parseInt(document.getElementById('bnStep').value);
        const mode = document.getElementById('graphMode').value;
        const btn = document.getElementById('btnBenchmark');
        const status = document.getElementById('benchStatus');

        btn.disabled = true;
        status.innerHTML = `Đang chạy Benchmark (${start} -> ${end})... <i class="fas fa-cog fa-spin"></i>`;

        document.getElementById('aiBenchPanel').style.display = 'block';
        document.getElementById('aiBenchContent').innerHTML = '<div style="text-align:center; padding:20px; color:#37474F"><i class="fas fa-spinner fa-spin fa-2x"></i><br>AI đang phân tích xu hướng...</div>';

        const formData = new FormData();
        formData.append('startN', start); formData.append('endN', end); formData.append('step', step); formData.append('mode', mode);

        try {
            const res = await fetch('@Url.Action("RunBenchmark", "MoPhong")', { method: 'POST', body: formData });
            const resp = await res.json();
            if (resp.success) {
                status.innerHTML = `<span style="color:#2E7D32"><i class="fas fa-check-circle"></i> Hoàn tất! Biểu đồ sử dụng 2 trục tung để hiển thị rõ.</span>`;
                renderChart(resp.data);
                if (resp.analysis) document.getElementById('aiBenchContent').innerHTML = marked.parse(resp.analysis);
            } else status.innerText = "Lỗi Server: " + resp.message;
        } catch (e) { status.innerText = "Lỗi kết nối!"; console.error(e); }
        btn.disabled = false;
    }

    function renderChart(data) {
        const ctx = document.getElementById('benchChart').getContext('2d');
        if (window.benchChartInstance) window.benchChartInstance.destroy();

        window.benchChartInstance = new Chart(ctx, {
            type: 'line',
            data: {
                labels: data.map(d => d.n),
                datasets: [
                    { label: 'Prim Time (ms)', data: data.map(d => d.primTime), borderColor: '#2E7D32', backgroundColor: '#2E7D32', borderWidth: 3, tension: 0.3, yAxisID: 'y' },
                    { label: 'Kruskal Time (ms)', data: data.map(d => d.kruskalTime), borderColor: '#D84315', backgroundColor: '#D84315', borderWidth: 3, tension: 0.3, yAxisID: 'y' },
                    { label: 'Prim Score (Theory)', data: data.map(d => d.primScore), borderColor: '#81C784', borderDash: [5, 5], pointRadius: 0, borderWidth: 1, tension: 0.3, yAxisID: 'y1' },
                    { label: 'Kruskal Score (Theory)', data: data.map(d => d.kruskalScore), borderColor: '#FF8A65', borderDash: [5, 5], pointRadius: 0, borderWidth: 1, tension: 0.3, yAxisID: 'y1' }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                scales: {
                    x: { title: { display: true, text: 'Số lượng đỉnh (N)' } },
                    y: { type: 'linear', display: true, position: 'left', title: { display:true, text: 'Thời gian (ms)', color: '#37474F' } },
                    y1: { type: 'linear', display: true, position: 'right', title: { display:true, text: 'Điểm phức tạp (Ops)', color: '#78909C' }, grid: { drawOnChartArea: false } }
                }
            }
        });
    }

    // ==========================================
    // 6. HELPER FUNCTIONS
    // ==========================================
    function renderStats(data) {
        document.getElementById('p-cost').innerText = data.prim.cost;
        document.getElementById('p-time').innerText = data.prim.time.toFixed(4) + " ms";
        document.getElementById('p-theory').innerText = "Score: " + formatNumber(data.prim.theoryScore);
        document.getElementById('p-steps-val').innerText = data.prim.steps;
        document.getElementById('p-algo').innerText = data.prim.complexity;

        document.getElementById('k-cost').innerText = data.kruskal.cost;
        document.getElementById('k-time').innerText = data.kruskal.time.toFixed(4) + " ms";
        document.getElementById('k-theory').innerText = "Score: " + formatNumber(data.kruskal.theoryScore);
        document.getElementById('k-steps-val').innerText = data.kruskal.steps;
    }
    function formatNumber(num) { return Math.round(num).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ","); }

    function simulatePrimSteps(nodes, edges) {
        let steps = []; let visited = new Set(); let mstEdges = [];
        let startNode = nodes[0].id; visited.add(startNode);
        steps.push({ type: 'start', msg: `Bắt đầu: ${startNode}`, edges: [] });
        while (visited.size < nodes.length) {
            let candidates = [];
            edges.forEach(e => {
                let uIn = visited.has(e.source), vIn = visited.has(e.target);
                if (uIn !== vIn) candidates.push(e);
            });
            if (candidates.length === 0) break;
            candidates.sort((a, b) => a.weight - b.weight);
            let bestEdge = candidates[0];
            mstEdges.push(bestEdge);
            visited.add(visited.has(bestEdge.source) ? bestEdge.target : bestEdge.source);
            steps.push({ type: 'select', msg: `Chọn ${bestEdge.source}-${bestEdge.target} (W:${bestEdge.weight})`, edges: [...mstEdges] });
        }
        return steps;
    }

    function simulateKruskalSteps(nodes, edges) {
        let steps = [];
        let sorted = [...edges].sort((a, b) => a.weight - b.weight);
        let parent = {}; nodes.forEach(n => parent[n.id] = n.id);
        function find(i) { if (parent[i] === i) return i; return find(parent[i]); }
        function union(i, j) { let ri = find(i), rj = find(j); if (ri !== rj) { parent[ri] = rj; return true; } return false; }
        let mst = [];
        for (let e of sorted) {
            if (union(e.source, e.target)) {
                mst.push(e);
                steps.push({ type: 'select', msg: `Chọn ${e.source}-${e.target} (W:${e.weight})`, edges: [...mst] });
            } else {
                steps.push({ type: 'reject', msg: `Bỏ ${e.source}-${e.target} (Chu trình)`, edges: [...mst] });
            }
        }
        return steps;
    }

    function initD3Graph(id, graph, color) {
        const container = document.getElementById(id); container.innerHTML = "";
        const w = container.clientWidth, h = 400;
        const svg = d3.select("#" + id).append("svg").attr("width", w).attr("height", h)
            .call(d3.zoom().on("zoom", (e) => g.attr("transform", e.transform))).append("g");
        const g = svg;
        const nodes = graph.nodes.map(d => ({ ...d })); const links = graph.edges.map(d => ({ ...d }));

        const simulation = d3.forceSimulation(nodes)
            .force("link", d3.forceLink(links).id(d => d.id).distance(60))
            .force("charge", d3.forceManyBody().strength(-150))
            .force("center", d3.forceCenter(w / 2, h / 2));

        const link = g.append("g").selectAll("line").data(links).enter().append("line").attr("stroke", "#eee").attr("stroke-width", 2);
        const mstLink = g.append("g").selectAll("line").data(links).enter().append("line").attr("stroke", color).attr("stroke-width", 0).attr("opacity", 0);
        const node = g.append("g").selectAll("circle").data(nodes).enter().append("circle").attr("r", 9).attr("fill", "#fff").attr("stroke", "#546E7A").attr("stroke-width", 2)
            .call(d3.drag().on("start", (e, d) => { if (!e.active) simulation.alphaTarget(0.3).restart(); d.fx = d.x; d.fy = d.y; }).on("drag", (e, d) => { d.fx = e.x; d.fy = e.y; }).on("end", (e, d) => { if (!e.active) simulation.alphaTarget(0); d.fx = null; d.fy = null; }));
        const label = g.append("g").selectAll("text").data(nodes).enter().append("text").text(d => d.id).attr("dy", 3).attr("text-anchor", "middle").attr("font-size", "10px").attr("font-weight", "bold").attr("pointer-events", "none");

        simulation.on("tick", () => {
            link.attr("x1", d => d.source.x).attr("y1", d => d.source.y).attr("x2", d => d.target.x).attr("y2", d => d.target.y);
            mstLink.attr("x1", d => d.source.x).attr("y1", d => d.source.y).attr("x2", d => d.target.x).attr("y2", d => d.target.y);
            node.attr("cx", d => d.x).attr("cy", d => d.y);
            label.attr("x", d => d.x).attr("y", d => d.y);
        });
        return { mstLink };
    }

    function setupSlider(id, max) { document.getElementById(id).max = max; document.getElementById(id).disabled = false; document.getElementById(id.replace('Slider', 'TotalLbl')).innerText = max; }
    function updateTimeTravel(algo, val) {
        document.getElementById(algo.toLowerCase() + 'StepLbl').innerText = val;
        const steps = algo === 'Prim' ? primDetailedSteps : kruskalDetailedSteps;
        const vizObj = algo === 'Prim' ? primSvgGroups : kruskalSvgGroups;
        if (!steps || !vizObj) return;

        vizObj.mstLink.attr("stroke-width", 0).attr("opacity", 0);
        if (val > 0) {
            let activeEdges = steps[val - 1].edges || [];
            activeEdges.forEach(e => {
                vizObj.mstLink.filter(d => (d.source.id === e.source && d.target.id === e.target) || (d.source.id === e.target && d.target.id === e.source))
                    .attr("stroke-width", 3).attr("opacity", 1);
            });
        }
        highlightTableRow(algo.toLowerCase() + 'Log', val);
    }

    function renderFullLog(tableId, steps) {
        const table = document.getElementById(tableId);
        if (!table) { console.error("Table not found: " + tableId); return; }

        let tbody = table.querySelector('tbody');
        if (!tbody) {
            tbody = document.createElement('tbody');
            table.appendChild(tbody);
        }

        tbody.innerHTML = steps.map((s, i) => {
            let cls = s.type === 'select' ? 'log-step-select' : (s.type === 'reject' ? 'log-step-reject' : '');
            let w = s.edges && s.edges.length > 0 ? s.edges[s.edges.length - 1].weight : '';
            if (!w && s.type === 'reject') {
                let match = s.msg.match(/W:(\d+)/);
                if (match) w = match[1];
            }
            return `<tr class="${cls}" id="${tableId}-row-${i + 1}"><td>${i + 1}</td><td>${s.msg}</td><td><b>${w}</b></td></tr>`;
        }).join('');
    }

    function highlightTableRow(tableId, index) {
        document.querySelectorAll(`#${tableId} tr`).forEach(tr => tr.style.border = "none");
        if (index > 0) document.getElementById(`${tableId}-row-${index}`)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    updateModeInfo();
    setTimeout(resizeInput, 500);
</script>