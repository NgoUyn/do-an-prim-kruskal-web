@{
    ViewBag.Title = "Thuật toán Prim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- 🌈 SECTION -->
<section class="prim-section text-center py-5">
    <div class="container">
        <h1 class="fw-bold text-primary mb-3 animate__animated animate__fadeInDown">
            🌐 Thuật toán Prim
        </h1>

        <div class="divider mx-auto mb-4"></div>

        <div class="algorithm-box shadow-lg p-4 rounded-4 bg-white animate__animated animate__fadeInUp">
            <img src="@Url.Content("~/Content/Images/prim.png")"
                 alt="Thuật toán Prim"
                 class="img-fluid rounded-4 mb-4 algorithm-img" />
            <p class="fs-5 text-muted text-justify">
                Thuật toán <strong>Prim</strong> tìm <em>cây khung nhỏ nhất</em> (Minimum Spanning Tree)
                bằng cách mở rộng dần từ một đỉnh ban đầu. Ở mỗi bước, nó chọn cạnh có trọng số nhỏ nhất
                nối cây hiện tại với một đỉnh chưa thuộc cây.
            </p>

            <div class="text-start mt-4 px-3">
                <h5 class="fw-semibold text-primary mb-2">🧮 Quy trình thực hiện:</h5>
                <ol class="text-muted fs-6 text-start">
                    <li>Chọn một đỉnh bắt đầu, thêm vào cây khung.</li>
                    <li>Từ các cạnh nối cây với đỉnh chưa xét, chọn cạnh có trọng số nhỏ nhất.</li>
                    <li>Thêm cạnh đó và đỉnh kề vào cây khung.</li>
                    <li>Lặp lại cho đến khi tất cả các đỉnh đều được thêm vào cây.</li>
                </ol>
            </div>

            <p class="mt-4 fs-6 text-secondary">
                💡 <strong>Ứng dụng:</strong> Tối ưu hóa lộ trình du lịch, mạng điện, hay hệ thống kết nối
                để giảm chi phí di chuyển giữa các địa điểm.
            </p>

            <a href="@Url.Action("Index", "Kruskal")" class="btn btn-outline-primary mt-3 px-4">
                → Xem tiếp: Thuật toán Kruskal
            </a>
        </div>
    </div>
</section>
