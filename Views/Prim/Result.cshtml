@model List<Prim_Kruskal_Web.Models.Edge>

<h2>Kết quả Cây khung nhỏ nhất (MST)</h2>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Đỉnh A</th>
            <th>Đỉnh B</th>
            <th>Trọng số</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td>@e.Src.Name</td>
                <td>@e.Destination.Name</td>
                <td>@e.Weight</td>
            </tr>
        }
    </tbody>
</table>
