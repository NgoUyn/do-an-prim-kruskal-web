<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="description" content="TourWorld - Du lịch thông minh bằng giải thuật tối ưu Prim và Kruskal.">
    <title>@ViewBag.Title - TourWorld</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="icon" type="image/png" href="~/Content/IMG/logo.png" />
    <link href="~/Content/css/style.css" rel="stylesheet" />
    <link href="~/Content/css/layouttemp.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        /* Dropdown on hover for the main nav */
        .nav-menu {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            gap: 20px;
            align-items: center;
        }

            .nav-menu li {
                position: relative;
            }

            .nav-menu a {
                text-decoration: none;
                color: inherit;
                display: inline-block;
                padding: 6px 8px;
            }

        .nav-dropdown > a {
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .dropdown-menu {
            display: none;
            position: absolute;
            top: calc(100% + 6px);
            left: 0;
            background: #ffffff;
            min-width: 200px;
            box-shadow: 0 6px 18px rgba(0,0,0,0.12);
            border-radius: 4px;
            padding: 6px 0;
            z-index: 1000;
        }

            .dropdown-menu li {
                display: block;
            }

            .dropdown-menu a {
                display: block;
                padding: 8px 14px;
                color: #333;
            }

                .dropdown-menu a:hover {
                    background: #f2f2f2;
                }

        /* show on hover */
        .nav-dropdown:hover > .dropdown-menu,
        .nav-dropdown:focus-within > .dropdown-menu {
            display: block;
        }

        /* small responsive tweak */
        @@media (max-width: 700px) {
            .nav-menu {
                gap: 8px;
                flex-wrap: wrap;
            }

            .dropdown-menu {
                position: static;
                box-shadow: none;
            }
        }
    </style>
</head>
<body>
    <!-- HEADER -->
    <header class="tour-header">
        <div class="header-container">
            <div class="logo">
                <a href="@Url.Action("Index","Home")">
                    <i class="fa-solid fa-earth-asia"></i>
                    <span>TourWorld</span>
                </a>
            </div>

            <nav class="nav-bar">
                <ul class="nav-menu">
                    <li><a href="@Url.Action("Index","Home")" class="@(ViewBag.Title == "Trang chủ" ? "active" : "")">Trang Chủ</a></li>
                    <li><a href="@Url.Action("MoPhong","Home")">Mô Phỏng</a></li>
                    <li class="nav-dropdown">
                        <a href="@Url.Action("UngDung","Home")" aria-haspopup="true" aria-expanded="false">
                            Ứng Dụng <i class="fa-solid fa-caret-down"></i>
                        </a>
                        <ul class="dropdown-menu" role="menu" aria-label="Ứng Dụng menu">
                            <li role="none"><a role="menuitem" href="@Url.Action("NoiTinh","UngDung")">Du lịch nội tỉnh</a></li>
                            <li role="none"><a role="menuitem" href="@Url.Action("LienTinh","UngDung")">Du lịch liên tỉnh</a></li>
                        </ul>
                    </li>
                    <li><a href="@Url.Action("Contact","Home")">Liên Hệ</a></li>
                </ul>
            </nav>

            <form class="header-search" action="@Url.Action("Search","Home")" method="get">
                <input type="text" name="query" placeholder="Tìm tour, địa điểm..." class="search-input" />
                <button type="submit" class="search-btn">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </form>
        </div>
    </header>

    <!-- MAIN -->
    <main class="main-container">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="tour-footer">
        <div class="footer-container">
            <div class="footer-col">
                <h3><i class="fa-solid fa-map-location-dot"></i> Liên Hệ</h3>
                <p>📍 140 Lê Trọng Tấn, Tây Thạnh, Tân Phú, Thành phố Hồ Chí Minh</p>
                <p>📞 094 248 3612</p>
                <p>✉ contact@example.com</p>
              
            </div>

            <div class="footer-col">
                <h3><i class="fa-solid fa-compass"></i> Liên Kết Nhanh</h3>
                <ul>
                    <li><a href="@Url.Action("Index","Home")">Trang Chủ</a></li>
                    <li><a href="@Url.Action("MoPhong","Home")">Mô Phỏng</a></li>
                    <li><a href="@Url.Action("Compare","Kruskal")">Ứng Dụng</a></li>
                    <li><a href="@Url.Action("Contact","Home")">Liên Hệ</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h3><i class="fa-solid fa-plane-departure"></i> Theo Dõi Chúng Tôi</h3>
                <div class="social-links">
                    <a href="#"><i class="fab fa-facebook"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i></a>
                    <a href="#"><i class="fab fa-youtube"></i></a>
                    <a href="#"><i class="fab fa-tiktok"></i></a>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <p>© 2025 <strong>TourWorld</strong> — Thiết kế bởi Nhóm Du Lịch.</p>
        </div>
    </footer>

    <script src="~/Scripts/js/script.js"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>
