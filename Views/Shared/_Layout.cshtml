<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="TourWorld - Du lịch thông minh bằng giải thuật tối ưu Prim và Kruskal.">
    <title>@ViewBag.Title - TourWorld</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <link href="~/Content/css/trangchu.css?v=1.2" rel="stylesheet" />
    <link rel="icon" type="image/png" href="~/Content/IMG/logo.png" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
</head>
<body>

    <header class="tour-header">
        <div class="header-container">
            <div class="logo">
                <a href="@Url.Action("Index","Home")">
                    <i class="fa-solid fa-earth-asia"></i>
                    <span>TourWorld</span>
                </a>
            </div>
            <nav class="nav-bar">
                <ul class="nav-menu">
                    <li>
                        <a href="@Url.Action("Index","Home")" class="@(ViewBag.Title == "Trang chủ" ? "active" : "")">Trang Chủ</a>
                    </li>

                    <li class="nav-dropdown">
                        <a href="#" aria-haspopup="true" aria-expanded="false">
                            Mô Phỏng <i class="fa-solid fa-caret-down"></i>
                        </a>
                        <ul class="dropdown-menu" role="menu">
                            <li role="none">
                                <a role="menuitem" href="@Url.Action("MoPhong", "MoPhong")">
                                    <i class="fa-solid fa-diagram-project"></i> Mô phỏng từng bước
                                </a>
                            </li>
                            @*<li role="none">
                                <a role="menuitem" href="@Url.Action("Compare", "MoPhong")">
                                    <i class="fa-solid fa-bolt"></i> The Race (So sánh)
                                </a>
                            </li>*@
                            <li role="none">
                                <a role="menuitem" href="@Url.Action("Arena", "MoPhong")">
                                    <i class="fa-solid fa-trophy"></i> Đấu Trường (Arena)
                                </a>
                            </li>
                        </ul>
                    </li>

                    <li class="nav-dropdown">
                        <a href="#" aria-haspopup="true" aria-expanded="false">
                            Ứng Dụng <i class="fa-solid fa-caret-down"></i>
                        </a>
                        <ul class="dropdown-menu" role="menu" aria-label="Ứng Dụng menu">
                            <li role="none">
                                <a role="menuitem" href="@Url.Action("NoiTinh", "UngDung")">
                                    <i class="fa-solid fa-city"></i> Du lịch nội tỉnh
                                </a>
                            </li>
                            <li role="none">
                                <a role="menuitem" href="@Url.Action("LienTinh", "UngDung")">
                                    <i class="fa-solid fa-plane-departure"></i> Du lịch liên tỉnh
                                </a>
                            </li>
                        </ul>
                    </li>

                    <li><a href="@Url.Action("Contact","Home")">Liên Hệ</a></li>
                </ul>
            </nav>
            <form class="header-search" action="@Url.Action("Search","Home")" method="get">
                <input type="text" name="query" placeholder="Tìm tour, địa điểm..." class="search-input" />
                <button type="submit" class="search-btn">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </form>
        </div>
    </header>

    <main class="main-container">
        @RenderBody()
    </main>

    <footer class="tour-footer">
        <div class="footer-container">
            <div class="footer-col">
                <h3><i class="fa-solid fa-map-location-dot"></i> Liên Hệ</h3>
                <p>📍 140 Lê Trọng Tấn, Tây Thạnh, Tân Phú, Thành phố Hồ Chí Minh</p>
                <p>📞 094 248 3612</p>
                <p>✉ contact@example.com</p>
            </div>
            <div class="footer-col">
                <h3><i class="fa-solid fa-compass"></i> Liên Kết Nhanh</h3>
                <ul>
                    <li><a href="@Url.Action("Index","Home")">Trang Chủ</a></li>
                    <li><a href="@Url.Action("MoPhong","MoPhong")">Mô Phỏng</a></li>
                    <li><a href="@Url.Action("LienTinh","UngDung")">Ứng Dụng</a></li>
                    <li><a href="@Url.Action("Contact","Home")">Liên Hệ</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h3><i class="fa-solid fa-plane-departure"></i> Theo Dõi Chúng Tôi</h3>
                <div class="social-links">
                    <a href="#"><i class="fab fa-facebook"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i></a>
                    <a href="#"><i class="fab fa-youtube"></i></a>
                    <a href="#"><i class="fab fa-tiktok"></i></a>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>© 2025 <strong>TourWorld</strong> — Thiết kế bởi Nhóm Du Lịch.</p>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    <script src="~/Scripts/js/script.js"></script>

    <script src="https://unpkg.com/aos@next/dist/aos.js"></script>
    <script>
        AOS.init({
            duration: 800,
            once: true,
            offset: 100
        });
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>