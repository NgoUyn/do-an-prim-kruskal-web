@{
    ViewBag.Title = "Smart Travel - Du Lịch Liên Tỉnh";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    :root {
        --primary: #1976D2; /* Xanh biển đậm (Liên tỉnh) */
        --primary-hover: #1565C0;
        --secondary: #64B5F6; /* Xanh biển nhạt */
        --accent: #FF6F00; /* Cam điểm nhấn */
        --bg-body: #F5F7FA;
        --card-bg: #FFFFFF;
        --text-main: #263238;
        --text-sub: #78909C;
        --radius: 12px;
        --shadow: 0 4px 20px rgba(0,0,0,0.08);
    }

    body {
        font-family: 'Inter', sans-serif;
        background: var(--bg-body);
        color: var(--text-main);
        margin: 0;
    }

    /* LAYOUT */
    .app-container {
        display: grid;
        grid-template-columns: 380px 1fr;
        gap: 20px;
        height: calc(100vh - 60px);
        padding: 20px;
        max-width: 1920px;
        margin: 0 auto;
    }

    /* SIDEBAR */
    .sidebar {
        background: var(--card-bg);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid #ECEFF1;
    }

    .sidebar-header {
        padding: 25px;
        background: var(--primary);
        color: white;
    }

    .app-name {
        font-family: 'Playfair Display', serif;
        font-size: 1.6rem;
        letter-spacing: 0.5px;
    }

    .app-desc {
        font-size: 0.8rem;
        opacity: 0.9;
        margin-top: 4px;
    }

    .sidebar-content {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
    }

    /* SEARCH & LIST */
    .search-box {
        width: 100%;
        padding: 12px;
        border: 1px solid #CFD8DC;
        border-radius: 8px;
        font-family: inherit;
        font-size: 0.95rem;
        margin-bottom: 15px;
    }

        .search-box:focus {
            border-color: var(--primary);
            outline: none;
        }

    .province-list {
        max-height: 400px;
        overflow-y: auto;
        border: 1px solid #ECEFF1;
        border-radius: 8px;
    }

    .province-item {
        padding: 10px 15px;
        border-bottom: 1px solid #FAFAFA;
        cursor: pointer;
        display: flex;
        align-items: center;
        transition: 0.2s;
    }

        .province-item:hover {
            background: #E3F2FD;
        }

        .province-item.active {
            background: #BBDEFB;
            color: var(--primary);
            font-weight: 600;
        }

        .province-item input {
            margin-right: 10px;
            cursor: pointer;
            transform: scale(1.2);
        }

    /* CONTROLS */
    .control-group {
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid #ECEFF1;
    }

    .control-label {
        font-weight: 700;
        font-size: 0.85rem;
        color: #455A64;
        margin-bottom: 8px;
        display: block;
    }

    .algo-select {
        width: 100%;
        padding: 10px;
        border-radius: 6px;
        border: 1px solid #CFD8DC;
        background: #fff;
    }

    .btn-run {
        width: 100%;
        padding: 16px;
        border: none;
        border-radius: 10px;
        background: var(--primary);
        color: white;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        transition: 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 20px;
        box-shadow: 0 4px 10px rgba(25, 118, 210, 0.3);
    }

        .btn-run:disabled {
            background: #CFD8DC;
            cursor: not-allowed;
            box-shadow: none;
        }

        .btn-run:hover:not(:disabled) {
            transform: translateY(-2px);
            background: var(--primary-hover);
        }

    /* MAP AREA */
    .map-wrapper {
        position: relative;
        background: #fff;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    #mainMap {
        width: 100%;
        height: 100%;
        z-index: 1;
    }

    /* DASHBOARD OVERLAY */
    .dashboard-overlay {
        position: absolute;
        bottom: 30px;
        left: 30px;
        right: 30px;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(12px);
        padding: 20px;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        z-index: 999;
        display: none;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        border: 1px solid rgba(255,255,255,0.5);
    }

    .stat-item {
        text-align: center;
        border-right: 1px solid #ECEFF1;
    }

        .stat-item:last-child {
            border: none;
        }

    .stat-val {
        font-size: 1.8rem;
        font-weight: 800;
        color: var(--text-main);
    }

    .stat-lbl {
        font-size: 0.75rem;
        text-transform: uppercase;
        color: var(--text-sub);
        font-weight: 600;
        margin-top: 5px;
    }

    /* LOADER */
    .loader-overlay {
        position: absolute;
        inset: 0;
        background: rgba(255,255,255,0.9);
        z-index: 1000;
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .spinner {
        font-size: 3rem;
        color: var(--primary);
        margin-bottom: 20px;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        100% {
            transform: rotate(360deg);
        }
    }

    /* INFO TAG */
    .info-tag {
        position: absolute;
        top: 20px;
        right: 20px;
        z-index: 999;
        background: white;
        padding: 10px 20px;
        border-radius: 30px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        font-weight: 600;
        color: var(--primary);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    @@media (max-width: 1024px) {
        .app-container {
            grid-template-columns: 1fr;
            grid-template-rows: auto 500px;
            height: auto;
        }

        .dashboard-overlay {
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }
    }
</style>

<div class="app-container">
    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="app-name"><i class="fas fa-globe-asia"></i> Smart Travel</div>
            <div class="app-desc">Hệ thống định tuyến Liên Tỉnh Toàn Quốc</div>
        </div>

        <div class="sidebar-content">
            <div class="control-group" style="border:none; padding:0; margin:0">
                <label class="control-label">1. Chọn các Tỉnh/Thành muốn đi</label>
                <input type="text" id="searchBox" class="search-box" placeholder="Tìm kiếm tỉnh thành...">

                <div class="province-list" id="provinceListContainer">
                    <div style="padding:20px; text-align:center; color:#90A4AE">
                        <i class="fas fa-spinner fa-spin"></i> Đang tải dữ liệu hành chính...
                    </div>
                </div>

                <div style="margin-top:10px; font-size:0.8rem; color:var(--primary); font-weight:600; display:flex; justify-content:space-between">
                    <span id="selectedCount">0 tỉnh đã chọn</span>
                    <a href="#" onclick="clearSelection()" style="color:#E53935; text-decoration:none">Xóa hết</a>
                </div>
            </div>

            <div class="control-group">
                <label class="control-label">2. Thuật toán tối ưu</label>
                <select id="algoSelect" class="algo-select">
                    <option value="prim">Prim (Tối ưu nhất cho mạng lưới dày)</option>
                    <option value="kruskal">Kruskal (Tối ưu cho mạng lưới thưa)</option>
                </select>
                <div style="font-size:0.75rem; color:#78909C; margin-top:5px; line-height:1.4">
                    <i class="fas fa-info-circle"></i> Hệ thống sẽ tính toán cây khung nhỏ nhất (MST) để nối tất cả các tỉnh đã chọn với chi phí thấp nhất.
                </div>
            </div>

            <button id="btnRun" class="btn-run" disabled>
                <i class="fas fa-paper-plane"></i> TÍNH TOÁN LỘ TRÌNH
            </button>
        </div>
    </aside>

    <main class="map-wrapper">
        <div id="mainMap"></div>

        <div class="info-tag">
            <i class="fas fa-satellite-dish"></i> OSRM Routing Live
        </div>

        <div id="loader" class="loader-overlay">
            <div class="spinner"><i class="fas fa-circle-notch"></i></div>
            <h3 style="color:var(--text-main); margin:0">Đang xử lý dữ liệu liên tỉnh...</h3>
            <p style="color:var(--text-sub); margin-top:5px">Vui lòng chờ trong giây lát</p>
        </div>

        <div id="dashboard" class="dashboard-overlay">
            <div class="stat-item">
                <div class="stat-value" id="resAlgo" style="color:var(--primary)">Prim</div>
                <div class="stat-lbl">Thuật toán</div>
            </div>
            <div class="stat-item">
                <div class="stat-value" id="resCost" style="color:#E65100">0</div>
                <div class="stat-lbl">Chi phí xăng (VNĐ)</div>
            </div>
            <div class="stat-item">
                <div class="stat-value" id="resDist">0</div>
                <div class="stat-lbl">Tổng quãng đường (Km)</div>
            </div>
            <div class="stat-item" style="display:flex; justify-content:center; align-items:center">
                <button onclick="resetMap()" style="padding:10px 20px; border:1px solid #CFD8DC; background:#fff; border-radius:8px; cursor:pointer; font-weight:600">
                    <i class="fas fa-redo"></i> Làm mới
                </button>
            </div>
        </div>
    </main>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script>
    // --- CONFIGURATION ---
    const API_PROVINCES = 'https://provinces.open-api.vn/api/?depth=1';
    const API_NOMINATIM = 'https://nominatim.openstreetmap.org/search';
    // Server định tuyến (Đức - Ổn định)
    const API_OSRM = 'https://routing.openstreetmap.de/routed-car/route/v1/driving';

    // --- STATE ---
    let map;
    let allProvinces = [];
    let selectedProvinces = []; // {code, name, lat, lng}
    let markers = [];
    let polylines = [];

    // --- INIT ---
    document.addEventListener('DOMContentLoaded', () => {
        initMap();
        loadProvincesData();
        setupSearch();
    });

    function initMap() {
        // Center Vietnam
        map = L.map('mainMap').setView([16.047079, 108.206230], 6);
        // CartoDB Voyager (Clean map style)
        L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
            attribution: '© OpenStreetMap, © CARTO',
            maxZoom: 18
        }).addTo(map);
    }

    // --- 1. LOAD PROVINCE LIST ---
    async function loadProvincesData() {
        try {
            const res = await fetch(API_PROVINCES);
            allProvinces = await res.json();
            renderProvinceList(allProvinces);
        } catch (e) {
            document.getElementById('provinceListContainer').innerHTML = '<div style="color:red; text-align:center; padding:20px">Lỗi tải dữ liệu hành chính</div>';
        }
    }

    function renderProvinceList(list) {
        const container = document.getElementById('provinceListContainer');
        container.innerHTML = '';

        list.forEach(p => {
            const div = document.createElement('div');
            div.className = 'province-item';
            div.innerHTML = `
                <input type="checkbox" id="chk-${p.code}" value="${p.code}">
                <label for="chk-${p.code}" style="flex:1; cursor:pointer">${p.name}</label>
            `;

            // Event Click
            div.querySelector('input').addEventListener('change', (e) => {
                toggleSelection(p, e.target.checked, div);
            });

            container.appendChild(div);
        });
    }

    // --- 2. SEARCH & SELECTION LOGIC ---
    function setupSearch() {
        document.getElementById('searchBox').addEventListener('input', (e) => {
            const term = e.target.value.toLowerCase();
            const filtered = allProvinces.filter(p => p.name.toLowerCase().includes(term));
            renderProvinceList(filtered);
            // Re-check selected items in new list
            selectedProvinces.forEach(sel => {
                const chk = document.getElementById(`chk-${sel.code}`);
                if (chk) { chk.checked = true; chk.parentElement.classList.add('active'); }
            });
        });
    }

    async function toggleSelection(province, isSelected, element) {
        if (isSelected) {
            element.classList.add('active');
            // Check limit
            if (selectedProvinces.length >= 10) {
                alert("Vui lòng chọn tối đa 10 tỉnh để đảm bảo tốc độ xử lý.");
                element.querySelector('input').checked = false;
                element.classList.remove('active');
                return;
            }

            // Get Coordinates (Lazy load)
            if (!province.lat) {
                try {
                    // Gọi Nominatim để lấy tọa độ tâm tỉnh
                    const res = await fetch(`${API_NOMINATIM}?q=${province.name}, Vietnam&format=json&limit=1`);
                    const data = await res.json();
                    if (data.length > 0) {
                        province.lat = parseFloat(data[0].lat);
                        province.lng = parseFloat(data[0].lon);
                    }
                } catch (e) { console.error("Geo error"); }
            }

            if (province.lat) {
                selectedProvinces.push(province);
                addMarker(province);
            }
        } else {
            element.classList.remove('active');
            selectedProvinces = selectedProvinces.filter(p => p.code !== province.code);
            removeMarker(province.code);
        }

        updateUI();
    }

    function addMarker(p) {
        const m = L.marker([p.lat, p.lng]).addTo(map).bindPopup(`<b>${p.name}</b>`);
        m._code = p.code;
        markers.push(m);

        // Auto fit bounds
        if (markers.length > 1) {
            const group = new L.featureGroup(markers);
            map.fitBounds(group.getBounds().pad(0.2));
        } else {
            map.flyTo([p.lat, p.lng], 8);
        }
    }

    function removeMarker(code) {
        const idx = markers.findIndex(m => m._code === code);
        if (idx > -1) {
            map.removeLayer(markers[idx]);
            markers.splice(idx, 1);
        }
    }

    function updateUI() {
        document.getElementById('selectedCount').innerText = `${selectedProvinces.length} tỉnh đã chọn`;
        document.getElementById('btnRun').disabled = selectedProvinces.length < 2;
    }

    window.clearSelection = () => {
        selectedProvinces = [];
        markers.forEach(m => map.removeLayer(m));
        markers = [];
        document.querySelectorAll('.province-item').forEach(el => {
            el.classList.remove('active');
            el.querySelector('input').checked = false;
        });
        updateUI();
        resetMap();
    };

    // --- 3. ALGORITHMS (CORE) ---

    // Union-Find for Kruskal
    class UnionFind {
        constructor(size) { this.parent = Array.from({ length: size }, (_, i) => i); }
        find(i) { if (this.parent[i] === i) return i; return this.parent[i] = this.find(this.parent[i]); }
        union(i, j) {
            const rootI = this.find(i); const rootJ = this.find(j);
            if (rootI !== rootJ) { this.parent[rootI] = rootJ; return true; }
            return false;
        }
    }

    // Haversine Distance
    function getDist(p1, p2) {
        const R = 6371;
        const dLat = (p2.lat - p1.lat) * Math.PI / 180, dLon = (p2.lng - p1.lng) * Math.PI / 180;
        const a = Math.sin(dLat / 2) ** 2 + Math.cos(p1.lat * Math.PI / 180) * Math.cos(p2.lat * Math.PI / 180) * Math.sin(dLon / 2) ** 2;
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }

    // Prim
    function runPrim(nodes) {
        const n = nodes.length, visited = new Array(n).fill(false), edges = [];
        visited[0] = true; let count = 0;
        while (count < n - 1) {
            let min = Infinity, u = -1, v = -1;
            for (let i = 0; i < n; i++) if (visited[i])
                for (let j = 0; j < n; j++) if (!visited[j]) {
                    const d = getDist(nodes[i], nodes[j]);
                    if (d < min) { min = d; u = i; v = j; }
                }
            if (u !== -1) { visited[v] = true; edges.push({ from: nodes[u], to: nodes[v], dist: min }); count++; }
        }
        return edges;
    }

    // Kruskal
    function runKruskal(nodes) {
        const n = nodes.length, all = [], edges = [];
        for (let i = 0; i < n; i++) for (let j = i + 1; j < n; j++)
            all.push({ u: i, v: j, from: nodes[i], to: nodes[j], dist: getDist(nodes[i], nodes[j]) });
        all.sort((a, b) => a.dist - b.dist);
        const uf = new UnionFind(n);
        for (const e of all) if (uf.union(e.u, e.v)) edges.push(e);
        return edges;
    }

    // --- 4. EXECUTION ---
    document.getElementById('btnRun').addEventListener('click', async () => {
        const loader = document.getElementById('loader');
        const algo = document.getElementById('algoSelect').value;

        loader.style.display = 'flex';
        resetMap(); // Clear old lines

        try {
            // A. Chạy thuật toán tìm cạnh nối (MST)
            await new Promise(r => setTimeout(r, 500)); // UX delay
            let mstEdges = (algo === 'kruskal') ? runKruskal(selectedProvinces) : runPrim(selectedProvinces);

            // B. Gọi OSRM vẽ đường thực tế
            let totalDist = 0;

            for (const edge of mstEdges) {
                // API Call: /driving/lon1,lat1;lon2,lat2
                const url = `${API_OSRM}/${edge.from.lng},${edge.from.lat};${edge.to.lng},${edge.to.lat}?overview=full&geometries=geojson`;

                try {
                    const res = await fetch(url);
                    const json = await res.json();

                    if (json.code === 'Ok' && json.routes.length > 0) {
                        const route = json.routes[0];
                        // Vẽ đường
                        const line = L.geoJSON(route.geometry, {
                            style: { color: algo === 'kruskal' ? '#FF6F00' : '#1976D2', weight: 4, opacity: 0.8 }
                        }).addTo(map);

                        line.bindTooltip(`${(route.distance / 1000).toFixed(0)} km`, { sticky: true });
                        polylines.push(line);
                        totalDist += route.distance;
                    } else { throw new Error("No route"); }
                } catch (e) {
                    // Fallback đường thẳng
                    console.warn("OSRM Fail, fallback line");
                    const line = L.polyline([[edge.from.lat, edge.from.lng], [edge.to.lat, edge.to.lng]],
                        { color: '#90A4AE', weight: 3, dashArray: '5,5' }).addTo(map);
                    polylines.push(line);
                    totalDist += edge.dist * 1000 * 1.3;
                }

                await new Promise(r => setTimeout(r, 200)); // Tránh spam server
            }

            // C. Hiển thị kết quả
            const km = (totalDist / 1000).toFixed(0);
            const cost = Math.round((totalDist / 1000) * 15000).toLocaleString(); // 15k/km

            document.getElementById('resAlgo').innerText = (algo === 'prim') ? "Prim" : "Kruskal";
            document.getElementById('resDist').innerText = km;
            document.getElementById('resCost').innerText = cost;
            document.getElementById('dashboard').style.display = 'grid';

        } catch (e) {
            console.error(e);
            alert("Lỗi tính toán lộ trình.");
        } finally {
            loader.style.display = 'none';
        }
    });

    window.resetMap = function (clearMarkers = false) {
        polylines.forEach(l => map.removeLayer(l));
        polylines = [];
        document.getElementById('dashboard').style.display = 'none';
    };
</script>