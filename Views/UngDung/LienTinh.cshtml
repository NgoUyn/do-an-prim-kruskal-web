<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Du Lịch Liên Tỉnh - Tối Ưu Hóa Tuyến Đường</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>

    <style>
        :root {
            /* BẢNG MÀU ORGANIC & NATURE (ĐỒNG BỘ VỚI RACE) */
            --bg-main: #F9F7F2;      /* Nền giấy gạo */
            --text-color: #4E342E;   /* Nâu cà phê */
            --panel-bg: #FFFFFF;

            --prim-color: #2E7D32;   /* Xanh Rừng */
            --kruskal-color: #D84315; /* Cam Đất */
            --accent-soft: #FFAB91;  /* Cam Nhạt */

            --grid-empty: #ECEFF1;
            --shadow-soft: 0 10px 30px rgba(78, 52, 46, 0.08);
            --border-radius: 20px;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Nunito', sans-serif;
            background-color: var(--bg-main);
            /* Họa tiết vân giấy */
            background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23d7ccc8' fill-opacity='0.2'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
            color: var(--text-color);
            min-height: 100vh;
            padding: 30px;
        }

        .container { max-width: 1400px; margin: 0 auto; }

        /* HEADER */
        .banner {
            text-align: center;
            margin-bottom: 40px;
            position: relative;
        }
        .banner h1 {
            font-family: 'Quicksand', sans-serif;
            font-size: 2.8rem;
            font-weight: 700;
            color: var(--text-color);
            margin-bottom: 10px;
        }
        .banner p {
            font-size: 1.1rem;
            color: #8D6E63; /* Nâu nhạt */
        }
        .banner::after {
            content: '';
            display: block;
            width: 60px; height: 4px;
            background: var(--kruskal-color);
            margin: 20px auto 0;
            border-radius: 2px;
        }

        /* LAYOUT */
        .content-wrapper { display: flex; gap: 30px; flex-wrap: wrap; }

        /* SIDEBAR (SELECTION PANEL) */
        .selection-panel {
            flex: 0 0 380px;
            background: var(--panel-bg);
            border-radius: var(--border-radius);
            box-shadow: var(--shadow-soft);
            padding: 30px;
            height: fit-content;
            border: 1px solid rgba(78, 52, 46, 0.05);
            position: sticky; top: 20px;
        }

        .panel-header h2 {
            font-family: 'Quicksand', sans-serif;
            font-size: 1.4rem;
            color: var(--kruskal-color);
            margin-bottom: 20px;
            display: flex; align-items: center; gap: 10px;
        }

        .hint-box {
            background: #FFF3E0; /* Cam rất nhạt */
            border-left: 4px solid var(--kruskal-color);
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 20px;
            font-size: 0.95rem;
            color: #E65100;
            line-height: 1.5;
        }

        .search-input {
            width: 100%;
            padding: 14px 20px;
            border: 2px solid #EFEBE9;
            border-radius: 12px;
            font-size: 1rem;
            font-family: 'Nunito', sans-serif;
            background: #FAFAFA;
            transition: 0.3s;
            color: var(--text-color);
            margin-bottom: 15px;
        }
        .search-input:focus { outline: none; border-color: var(--kruskal-color); background: #fff; }

        .provinces-list {
            max-height: 350px;
            overflow-y: auto;
            margin-bottom: 20px;
            padding-right: 5px;
        }
        .provinces-list::-webkit-scrollbar { width: 6px; }
        .provinces-list::-webkit-scrollbar-thumb { background: #D7CCC8; border-radius: 10px; }

        .province-option {
            display: flex; align-items: center;
            padding: 12px 15px;
            margin-bottom: 8px;
            background: #fff;
            border: 1px solid #EFEBE9;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.2s;
        }
        .province-option:hover { border-color: var(--prim-color); transform: translateX(3px); }
        .province-option input[type="checkbox"] {
            width: 18px; height: 18px;
            accent-color: var(--prim-color);
            margin-right: 12px;
            cursor: pointer;
        }
        .province-option label { cursor: pointer; font-weight: 600; color: var(--text-color); flex: 1; }

        /* BUTTONS */
        .panel-actions { display: flex; gap: 10px; margin-bottom: 20px; }
        .btn {
            padding: 12px;
            border: none; border-radius: 12px;
            font-weight: 700; cursor: pointer;
            transition: 0.3s;
            font-family: 'Nunito', sans-serif;
            display: flex; align-items: center; justify-content: center; gap: 8px;
        }

        .btn-clear { background: #FFEBEE; color: #C62828; flex: 1; }
        .btn-clear:hover { background: #FFCDD2; }

        .btn-save { background: #E8F5E9; color: #2E7D32; flex: 1; }
        .btn-save:hover { background: #C8E6C9; }

        .btn-calculate {
            width: 100%;
            padding: 16px;
            font-size: 1.1rem;
            color: white;
            background: linear-gradient(135deg, #FF7043 0%, #D84315 100%);
            box-shadow: 0 8px 20px rgba(216, 67, 21, 0.25);
        }
        .btn-calculate:hover:not(:disabled) { transform: translateY(-3px); box-shadow: 0 12px 25px rgba(216, 67, 21, 0.35); }
        .btn-calculate:disabled { background: #BCAAA4; cursor: not-allowed; box-shadow: none; }

        .selected-info { margin-top: 30px; border-top: 2px dashed #EFEBE9; padding-top: 20px; }
        .selected-info h3 { font-size: 1rem; color: #8D6E63; margin-bottom: 15px; }

        .selected-item {
            background: #F1F8E9;
            padding: 8px 12px;
            margin-bottom: 6px;
            border-radius: 8px;
            display: flex; justify-content: space-between; align-items: center;
            font-size: 0.9rem; font-weight: 600;
            color: var(--prim-color);
        }
        .remove-vertex {
            background: none; border: none; color: #ef5350; cursor: pointer; font-size: 0.8rem; font-weight: 700;
        }

        /* MAIN CONTENT (RESULTS) */
        .results-panel {
            flex: 1;
            background: var(--panel-bg);
            border-radius: var(--border-radius);
            box-shadow: var(--shadow-soft);
            padding: 40px;
            min-height: 600px;
            border: 1px solid rgba(78, 52, 46, 0.05);
        }

        .initial-message {
            height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center;
            color: #BCAAA4; text-align: center; margin-top: 100px;
        }
        .initial-message i { font-size: 4rem; margin-bottom: 20px; color: #EFEBE9; }

        /* RESULT SECTIONS */
        .result-section h2 {
            font-family: 'Quicksand', sans-serif;
            color: var(--text-color);
            font-size: 1.5rem;
            margin-bottom: 25px;
            display: flex; align-items: center; gap: 12px;
        }
        .result-section h2 i { color: var(--kruskal-color); }

        .optimal-grid {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: #FAFAFA;
            border-radius: 16px;
            padding: 20px;
            border: 1px solid #EFEBE9;
            transition: 0.3s;
        }
        .stat-card:hover { transform: translateY(-5px); border-color: var(--accent-soft); }

        .stat-label { font-size: 0.85rem; color: #8D6E63; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 5px; }
        .stat-value { font-size: 1.8rem; font-weight: 800; font-family: 'Quicksand', sans-serif; color: var(--text-color); }
        .stat-unit { font-size: 0.9rem; color: #BCAAA4; font-weight: 600; }

        .stat-card.highlight { background: #FFF8E1; border-color: #FFE082; }
        .stat-card.highlight .stat-value { color: #F57F17; }

        /* ROUTE PATH */
        .route-box {
            background: #E8EAF6;
            padding: 25px;
            border-radius: 16px;
            border-left: 5px solid #3F51B5;
            margin-bottom: 30px;
        }
        .route-text { font-size: 1.1rem; font-weight: 700; color: #283593; line-height: 1.6; }

        /* BUTTON AI */
        .btn-ai {
            width: 100%;
            background: linear-gradient(135deg, #AB47BC 0%, #7B1FA2 100%);
            color: white;
            padding: 15px;
            border-radius: 12px;
            margin-top: 15px;
            font-size: 1rem;
            box-shadow: 0 8px 20px rgba(123, 31, 162, 0.2);
        }
        .btn-ai:hover { transform: translateY(-2px); box-shadow: 0 12px 25px rgba(123, 31, 162, 0.3); }
        .ai-response {
            background: #F3E5F5; color: #4A148C; padding: 20px; border-radius: 12px;
            margin-top: 15px; font-size: 0.95rem; line-height: 1.6; display: none;
        }

        /* TABLE */
        .custom-table { width: 100%; border-collapse: separate; border-spacing: 0; margin-bottom: 40px; }
        .custom-table th { background: #FAFAFA; color: #8D6E63; font-weight: 700; padding: 15px; text-align: left; border-bottom: 2px solid #EFEBE9; }
        .custom-table td { padding: 15px; border-bottom: 1px solid #F5F5F5; font-weight: 600; color: var(--text-color); }
        .custom-table tr:hover td { background: #FAFAFA; }

        /* CHART AREA */
        .charts-container {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 25px;
        }
        .chart-box {
            background: #fff; border: 1px solid #EFEBE9; border-radius: 16px; padding: 20px;
            height: 320px;
        }
        .chart-box h4 { text-align: center; color: #8D6E63; margin-bottom: 15px; font-size: 0.9rem; }

        /* LIST EDGES */
        .edge-list { max-height: 250px; overflow-y: auto; display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 10px; }
        .edge-card {
            background: #fff; border: 1px solid #EFEBE9; padding: 12px; border-radius: 10px;
            border-left: 4px solid var(--prim-color); font-size: 0.9rem;
        }
        .edge-card strong { color: var(--text-color); display: block; margin-bottom: 4px; }
        .edge-card small { color: #8D6E63; }

        /* Responsive */
        @@media (max-width: 1024px) {
            .content-wrapper { flex-direction: column; }
            .selection-panel { width: 100%; position: static; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="banner">
            <h1>Du Lịch Liên Tỉnh Tối Ưu</h1>
            <p>Khám phá lộ trình tiết kiệm nhất với sức mạnh thuật toán</p>
        </div>

        <div class="content-wrapper">
            <aside class="selection-panel">
                <div class="panel-header">
                    <h2><i class="fas fa-map-marked-alt"></i> Chọn Điểm Đến</h2>
                </div>

                <div class="hint-box">
                    <i class="fas fa-lightbulb"></i> <strong>Mẹo:</strong> Chọn ít nhất 2 tỉnh thành mà bạn muốn ghé thăm, sau đó nhấn "Lưu Đỉnh" và "Tính Toán".
                </div>

                <input type="text" id="searchInput" placeholder="Tìm kiếm tỉnh thành..." class="search-input">

                <div class="provinces-list" id="provincesList">
                    <div style="padding: 20px; text-align: center; color: #999;">
                        <i class="fas fa-spinner fa-spin"></i> Đang tải dữ liệu...
                    </div>
                </div>

                <div class="panel-actions">
                    <button id="clearBtn" class="btn btn-clear"><i class="fas fa-trash-alt"></i> Xóa Hết</button>
                    <button id="saveBtn" class="btn btn-save"><i class="fas fa-check"></i> Lưu Đỉnh</button>
                </div>

                <button id="calculateBtn" class="btn btn-calculate" disabled>
                    <i class="fas fa-calculator"></i> TÍNH TOÁN LỘ TRÌNH
                </button>

                <div class="selected-info">
                    <h3>DANH SÁCH ĐÃ CHỌN (<span id="selectedCount">0</span>)</h3>
                    <ul id="selectedList" style="list-style:none; padding:0">
                        <li style="color: #BCAAA4; font-style: italic;">Chưa chọn tỉnh nào</li>
                    </ul>
                </div>
            </aside>

            <main class="results-panel">
                <div id="loadingSpinner" style="display: none; height: 100%; flex-direction: column; align-items: center; justify-content: center;">
                    <div style="font-size: 3rem; color: var(--kruskal-color); margin-bottom: 20px;"><i class="fas fa-circle-notch fa-spin"></i></div>
                    <p style="color: #8D6E63; font-weight: 600;">Đang tìm đường đi tối ưu nhất...</p>
                </div>

                <div id="initialMessage" class="initial-message">
                    <i class="fas fa-route"></i>
                    <p>Hãy chọn các điểm đến bên trái để bắt đầu hành trình.</p>
                </div>

                <div id="resultsContent" style="display: none;">

                    <section class="result-section">
                        <h2><i class="fas fa-trophy"></i> Kết Quả Tối Ưu Nhất</h2>
                        <div id="messageBox" style="margin-bottom:20px;"></div>

                        <div class="optimal-grid">
                            <div class="stat-card">
                                <span class="stat-label">Thuật Toán</span>
                                <span class="stat-value" id="optimalAlgorithm" style="color:var(--prim-color); font-size:1.4rem">-</span>
                            </div>
                            <div class="stat-card highlight">
                                <span class="stat-label">Tổng Chi Phí</span>
                                <span class="stat-value" id="optimalCost">-</span>
                                <span class="stat-unit">VNĐ</span>
                            </div>
                            <div class="stat-card">
                                <span class="stat-label">Tổng Quãng Đường</span>
                                <span class="stat-value" id="optimalDistance">-</span>
                                <span class="stat-unit">Km</span>
                            </div>
                            <div class="stat-card">
                                <span class="stat-label">Thời Gian Xử Lý</span>
                                <span class="stat-value" id="optimalTime">-</span>
                                <span class="stat-unit">ms</span>
                            </div>
                        </div>

                        <div class="route-box">
                            <div style="text-transform:uppercase; font-size:0.8rem; color:#7986CB; margin-bottom:8px;">Lộ trình gợi ý:</div>
                            <div class="route-text" id="routePath">-</div>

                            <button id="btnAskAI" class="btn btn-ai">
                                <i class="fas fa-magic"></i> Nhờ AI Tư vấn Ăn chơi & Review Tour này
                            </button>
                            <div id="aiResponse" class="ai-response">
                                <i class="fas fa-spinner fa-spin"></i> Đang kết nối với Gemini AI...
                            </div>
                        </div>
                    </section>

                    <section class="result-section">
                        <h2><i class="fas fa-balance-scale"></i> So Sánh Hiệu Năng</h2>
                        <table class="custom-table">
                            <thead>
                                <tr>
                                    <th>Tiêu chí</th>
                                    <th style="color:var(--prim-color)">Prim</th>
                                    <th style="color:var(--kruskal-color)">Kruskal</th>
                                    <th>Chênh lệch</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Chi phí (VNĐ)</td>
                                    <td><span id="primCostVal">-</span></td>
                                    <td><span id="kruskalCostVal">-</span></td>
                                    <td><span id="costDiff" style="color:#E65100; font-weight:800">-</span></td>
                                </tr>
                                <tr>
                                    <td>Thời gian (ms)</td>
                                    <td><span id="primTimeVal">-</span></td>
                                    <td><span id="kruskalTimeVal">-</span></td>
                                    <td><span id="timeDiff">-</span></td>
                                </tr>
                                <tr>
                                    <td>Số phép toán</td>
                                    <td><span id="primOpsVal">-</span></td>
                                    <td><span id="kruskalOpsVal">-</span></td>
                                    <td><span id="opsDiff">-</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </section>

                    <section class="result-section">
                        <h2><i class="fas fa-chart-pie"></i> Biểu Đồ Trực Quan</h2>
                        <div class="charts-container">
                            <div class="chart-box">
                                <h4>So sánh Chi phí (VNĐ)</h4>
                                <canvas id="costChart"></canvas>
                            </div>
                            <div class="chart-box">
                                <h4>Thời gian thực thi (ms)</h4>
                                <canvas id="timeChart"></canvas>
                            </div>
                            <div class="chart-box">
                                <h4>Số lượng cạnh trong MST</h4>
                                <canvas id="edgesChart"></canvas>
                            </div>
                        </div>
                    </section>

                    <section class="result-section" style="border:none">
                        <h2><i class="fas fa-list-ul"></i> Chi Tiết Các Chặng Di Chuyển</h2>
                        <div class="edge-list" id="edgesList"></div>
                    </section>

                </div>
            </main>
        </div>
    </div>

    <script>
        let allProvinces = [];
        let selectedProvinces = new Set();
        let savedProvinces = [];
        let charts = {};

        // 1. INIT
        async function init() {
            await loadProvinces();
            setupEventListeners();
        }

        // 2. LOAD PROVINCES
        async function loadProvinces() {
            try {
                const response = await fetch('/UngDung/GetProvinces');
                const result = await response.json();
                if (result.success) {
                    allProvinces = result.data;
                    renderProvincesList();
                } else {
                    alert('Lỗi tải dữ liệu: ' + result.message);
                }
            } catch (error) { console.error(error); }
        }

        function renderProvincesList(term = '') {
            const list = document.getElementById('provincesList');
            const filtered = allProvinces.filter(p => p.name.toLowerCase().includes(term.toLowerCase()));

            if (filtered.length === 0) { list.innerHTML = '<div style="padding:20px; text-align:center; color:#BCAAA4">Không tìm thấy</div>'; return; }

            list.innerHTML = filtered.map(p => `
                    <div class="province-option">
                        <input type="checkbox" id="p-${p.id}" value="${p.id}">
                        <label for="p-${p.id}">${p.name}</label>
                    </div>
                `).join('');

            // Re-bind events
            document.querySelectorAll('.province-option input').forEach(cb => {
                cb.addEventListener('change', e => {
                    e.target.checked ? selectedProvinces.add(parseInt(e.target.value)) : selectedProvinces.delete(parseInt(e.target.value));
                });
            });
        }

        function setupEventListeners() {
            document.getElementById('searchInput').oninput = e => renderProvincesList(e.target.value);
            document.getElementById('clearBtn').onclick = () => {
                selectedProvinces.clear();
                document.querySelectorAll('input[type=checkbox]').forEach(cb => cb.checked = false);
            };
            document.getElementById('saveBtn').onclick = () => {
                if (selectedProvinces.size < 2) return alert('Vui lòng chọn ít nhất 2 địa điểm!');
                savedProvinces = Array.from(selectedProvinces);
                updateSelectedUI();
                document.getElementById('calculateBtn').disabled = false;
                alert('Đã lưu danh sách điểm đến!');
            };
            document.getElementById('calculateBtn').onclick = calculateRoute;

            // AI Button Event
            document.getElementById('btnAskAI').onclick = askAI;
        }

        function updateSelectedUI() {
            document.getElementById('selectedCount').innerText = savedProvinces.length;
            const list = document.getElementById('selectedList');
            list.innerHTML = savedProvinces.map(id => {
                const p = allProvinces.find(x => x.id === id);
                return `<li class="selected-item"><span>${p.name}</span> <button class="remove-vertex" onclick="removeP(${id})">Xóa</button></li>`;
            }).join('');
        }

        window.removeP = (id) => {
            savedProvinces = savedProvinces.filter(x => x !== id);
            updateSelectedUI();
            if (savedProvinces.length < 2) document.getElementById('calculateBtn').disabled = true;
        };

        // 3. CALCULATE
        async function calculateRoute() {
            const loading = document.getElementById('loadingSpinner');
            const content = document.getElementById('resultsContent');
            const initMsg = document.getElementById('initialMessage');

            loading.style.display = 'flex';
            content.style.display = 'none';
            initMsg.style.display = 'none';

            try {
                const res = await fetch('/UngDung/CalculateOptimalRoute', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ selectedProvinces: savedProvinces })
                });
                const data = await res.json();

                if (data.success) {
                    displayData(data);
                    content.style.display = 'block';
                } else {
                    alert(data.message);
                    initMsg.style.display = 'flex';
                }
            } catch (e) { alert('Lỗi kết nối'); }
            finally { loading.style.display = 'none'; }
        }

        function displayData(data) {
            const opt = data.optimalRoute;
            const p = data.primResult;
            const k = data.kruskalResult;
            const c = data.comparison;

            // Optimal Info
            document.getElementById('optimalAlgorithm').innerText = opt.algorithmName;
            document.getElementById('optimalCost').innerText = opt.totalCost.toLocaleString();
            document.getElementById('optimalDistance').innerText = opt.totalDistance.toLocaleString();
            document.getElementById('optimalTime').innerText = opt.executionTime.toFixed(2);
            document.getElementById('routePath').innerText = opt.routeNames.join(' ➝ ');

            // Comparison Table
            document.getElementById('primCostVal').innerText = p.totalCost.toLocaleString();
            document.getElementById('kruskalCostVal').innerText = k.totalCost.toLocaleString();
            document.getElementById('costDiff').innerText = c.costDifference.toLocaleString();

            document.getElementById('primTimeVal').innerText = p.executionTime.toFixed(2);
            document.getElementById('kruskalTimeVal').innerText = k.executionTime.toFixed(2);
            document.getElementById('timeDiff').innerText = c.timeDifference.toFixed(2);

            document.getElementById('primOpsVal').innerText = p.operationCount;
            document.getElementById('kruskalOpsVal').innerText = k.operationCount;
            document.getElementById('opsDiff').innerText = c.operationDifference;

            // Edge List
            const edgeHtml = opt.edges.map((e, i) => `
                    <div class="edge-card">
                        <strong>Chặng ${i + 1}: ${e.fromName} ↔ ${e.toName}</strong>
                        <small>Chi phí: ${e.cost.toLocaleString()} VNĐ • Dài: ${e.distance} km</small>
                    </div>
                `).join('');
            document.getElementById('edgesList').innerHTML = edgeHtml;

            // Charts
            drawCharts(p, k);
        }

        // 4. CHART JS
        function drawCharts(p, k) {
            Object.values(charts).forEach(c => c?.destroy && c.destroy());
            charts = {};

            const createChart = (id, label, d1, d2, color1, color2) => {
                const ctx = document.getElementById(id).getContext('2d');
                return new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: ['Prim', 'Kruskal'],
                        datasets: [{
                            label: label,
                            data: [d1, d2],
                            backgroundColor: [color1, color2],
                            borderRadius: 8
                        }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
                });
            };

            charts.cost = createChart('costChart', 'Chi phí', p.totalCost, k.totalCost, '#2E7D32', '#D84315');
            charts.time = createChart('timeChart', 'Thời gian', p.executionTime, k.executionTime, '#66BB6A', '#FF7043');

            // Doughnut for edges
            const ctxE = document.getElementById('edgesChart').getContext('2d');
            charts.edges = new Chart(ctxE, {
                type: 'doughnut',
                data: {
                    labels: ['Prim', 'Kruskal'],
                    datasets: [{ data: [p.edgeCount, k.edgeCount], backgroundColor: ['#2E7D32', '#D84315'] }]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
            });
        }

        // 5. ASK AI
        async function askAI() {
            const route = document.getElementById('routePath').innerText;
            const cost = document.getElementById('optimalCost').innerText.replace(/,/g, '');
            const box = document.getElementById('aiResponse');

            if (route === '-') return alert('Vui lòng tính toán trước!');

            box.style.display = 'block';
            box.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang kết nối với Gemini AI...';

            try {
                const formData = new FormData();
                formData.append('routeInfo', route);
                formData.append('totalCost', parseFloat(cost));

                const res = await fetch('/UngDung/GetAIAdvice', { method: 'POST', body: formData });
                const json = await res.json();

                if (json.success) {
                    box.innerHTML = `<strong><i class="fas fa-robot"></i> Gemini tư vấn:</strong><br/>${json.data.replace(/\n/g, '<br>')}`;
                } else {
                    box.innerHTML = `<span style="color:red">Lỗi: ${json.message}</span>`;
                }
            } catch (e) { box.innerHTML = 'Lỗi kết nối AI'; }
        }

        init();
    </script>
</body>
</html>