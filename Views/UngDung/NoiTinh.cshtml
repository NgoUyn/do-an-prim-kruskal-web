@{
    ViewBag.Title = "Smart Travel - Đa Phương Tiện";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />

<style>
    /* GIỮ NGUYÊN CSS CŨ VÀ THÊM MỘT CHÚT CHO ĐẸP HƠN */
    :root {
        --primary: #2E7D32;
        --secondary: #81C784;
        --accent: #FF6F00;
        --bg-body: #F5F7FA;
        --card-bg: #FFFFFF;
        --text-main: #263238;
        --radius: 12px;
        --shadow: 0 4px 20px rgba(0,0,0,0.08);
    }

    body {
        font-family: 'Inter', sans-serif;
        background: var(--bg-body);
        color: var(--text-main);
        margin: 0;
    }

    .app-container {
        display: grid;
        grid-template-columns: 360px 1fr;
        gap: 20px;
        height: calc(100vh - 60px);
        padding: 20px;
        max-width: 1920px;
        margin: 0 auto;
    }

    .sidebar {
        background: #fff;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid #ECEFF1;
    }

    .sidebar-header {
        padding: 20px;
        background: var(--primary);
        color: white;
    }

    .sidebar-content {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
    }

    .control-group {
        margin-bottom: 20px;
    }

    .control-label {
        display: block;
        font-weight: 700;
        margin-bottom: 8px;
        font-size: 0.85rem;
        color: #455A64;
        text-transform: uppercase;
    }

    .custom-select {
        width: 100%;
        padding: 12px;
        border: 1px solid #CFD8DC;
        border-radius: 8px;
        font-family: inherit;
        transition: 0.3s;
        background: #fff;
    }

    /* MODE SELECTOR (MỚI) */
    .mode-selector {
        display: flex;
        gap: 10px;
        margin-bottom: 15px;
    }

    .mode-option {
        flex: 1;
        padding: 10px;
        border: 1px solid #CFD8DC;
        border-radius: 8px;
        text-align: center;
        cursor: pointer;
        transition: 0.2s;
        font-size: 0.9rem;
    }

        .mode-option:hover {
            background: #F1F8E9;
        }

        .mode-option.active {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
            font-weight: 600;
        }

        .mode-option i {
            display: block;
            font-size: 1.2rem;
            margin-bottom: 4px;
        }

    .location-list {
        min-height: 100px;
        border: 1px dashed #CFD8DC;
        border-radius: 8px;
        padding: 8px;
        background: #FAFAFA;
    }

    .location-item {
        display: flex;
        align-items: center;
        padding: 10px;
        border: 1px solid #ECEFF1;
        border-radius: 8px;
        margin-bottom: 6px;
        cursor: pointer;
        background: #fff;
    }

        .location-item.active {
            background: #E8F5E9;
            border-color: var(--primary);
        }

        .location-item .icon {
            width: 32px;
            height: 32px;
            background: #F1F8E9;
            color: var(--primary);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
        }

        .location-item .info {
            flex: 1;
        }

        .location-item .name {
            font-weight: 600;
            font-size: 0.9rem;
        }

        .location-item .type {
            font-size: 0.75rem;
            color: #78909C;
        }

    .btn-run {
        width: 100%;
        padding: 16px;
        border: none;
        border-radius: 10px;
        background: var(--primary);
        color: white;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
    }

        .btn-run:disabled {
            background: #CFD8DC;
            cursor: not-allowed;
        }

    .map-container {
        position: relative;
        background: #fff;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    #mainMap {
        width: 100%;
        height: 100%;
        z-index: 1;
    }

    .overlay-dashboard {
        position: absolute;
        bottom: 30px;
        left: 30px;
        right: 30px;
        background: rgba(255,255,255,0.95);
        backdrop-filter: blur(10px);
        padding: 20px;
        border-radius: 16px;
        z-index: 999;
        display: none;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    }

    .stat-item {
        text-align: center;
        border-right: 1px solid #ECEFF1;
    }

        .stat-item:last-child {
            border: none;
        }

    .stat-value {
        font-size: 1.6rem;
        font-weight: 800;
        color: var(--text-main);
    }

    .stat-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        color: #78909C;
        font-weight: 600;
    }

    .loader {
        position: absolute;
        inset: 0;
        background: rgba(255,255,255,0.9);
        z-index: 1000;
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
</style>

<div class="app-container">
    <aside class="sidebar">
        <div class="sidebar-header">
            <div style="font-family:'Playfair Display'; font-size:1.5rem">TravelVN</div>
            <div style="font-size:0.8rem; opacity:0.9">Tối ưu lộ trình thông minh</div>
        </div>

        <div class="sidebar-content">
            <div class="control-group">
                <label class="control-label">01. Khu vực</label>
                <select id="provinceSelect" class="custom-select">
                    <option value="">-- Đang tải dữ liệu... --</option>
                </select>
            </div>

            <div class="control-group">
                <label class="control-label">02. Phương tiện di chuyển</label>
                <div class="mode-selector">
                    <div class="mode-option active" onclick="setMode('car', this)">
                        <i class="fas fa-car"></i> Ô tô
                    </div>
                    <div class="mode-option" onclick="setMode('bike', this)">
                        <i class="fas fa-motorcycle"></i> Xe máy
                    </div>
                    <div class="mode-option" onclick="setMode('foot', this)">
                        <i class="fas fa-walking"></i> Đi bộ
                    </div>
                </div>
            </div>

            <div class="control-group">
                <div style="display:flex; justify-content:space-between; margin-bottom:8px">
                    <label class="control-label" style="margin:0">03. Điểm đến</label>
                    <span id="counter" style="background:#ECEFF1; padding:2px 8px; border-radius:10px; font-size:0.75rem; font-weight:700">0 chọn</span>
                </div>
                <div id="locationsList" class="location-list">
                    <div style="text-align:center; padding:20px; color:#B0BEC5; font-size:0.9rem">Vui lòng chọn tỉnh trước</div>
                </div>
            </div>

            <div class="control-group" style="background:#F1F8E9; padding:15px; border-radius:8px; border:1px solid #C5E1A5">
                <label class="control-label" style="color:#2E7D32">04. Thuật toán</label>
                <select id="algoSelect" class="custom-select" style="border-color:#C5E1A5">
                    <option value="prim">Prim (Tối ưu nhất)</option>
                    <option value="kruskal">Kruskal (Cân bằng)</option>
                </select>
            </div>
        </div>

        <div style="padding:20px; border-top:1px solid #ECEFF1">
            <button id="btnRun" class="btn-run" disabled>
                <i class="fas fa-paper-plane"></i> TÍNH TOÁN
            </button>
        </div>
    </aside>

    <main class="map-container">
        <div id="mainMap"></div>

        <div id="loader" class="loader">
            <i class="fas fa-circle-notch fa-spin" style="font-size:3rem; color:var(--primary)"></i>
            <h3 style="margin-top:15px; color:#37474F">Đang tìm đường đi tốt nhất...</h3>
        </div>

        <div id="dashboard" class="overlay-dashboard">
            <div class="stat-item">
                <div class="stat-value" id="resMode"><i class="fas fa-car"></i></div>
                <div class="stat-label">Phương tiện</div>
            </div>
            <div class="stat-item">
                <div class="stat-value" id="resCost">0</div>
                <div class="stat-label">Chi phí (VND)</div>
            </div>
            <div class="stat-item">
                <div class="stat-value" id="resDist">0</div>
                <div class="stat-label">Quãng đường (Km)</div>
            </div>
            <div class="stat-item" style="display:flex; justify-content:center; align-items:center">
                <button onclick="resetApp()" style="padding:8px 16px; border:1px solid #CFD8DC; background:#fff; border-radius:6px; cursor:pointer">Làm mới</button>
            </div>
        </div>
    </main>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    // --- CẤU HÌNH API ---
    const API_PROVINCES = 'https://provinces.open-api.vn/api/?depth=1';
    const API_NOMINATIM = 'https://nominatim.openstreetmap.org/search';
    const API_OVERPASS = 'https://overpass-api.de/api/interpreter';

    // SERVER ĐỊNH TUYẾN (Dùng server Đức vì nó ổn định và hỗ trợ đủ loại phương tiện)
    const OSRM_BASE = 'https://routing.openstreetmap.de';
    let currentMode = 'car'; // car, bike, foot

    let map, markers = [], routeLayers = [], selectedLocations = [];

    document.addEventListener('DOMContentLoaded', () => {
        initMap();
        loadProvinces();
    });

    function initMap() {
        map = L.map('mainMap').setView([16.047079, 108.206230], 6);
        L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
            attribution: 'OpenStreetMap, CARTO', maxZoom: 19
        }).addTo(map);
    }

    // --- CHỌN PHƯƠNG TIỆN ---
    window.setMode = function (mode, el) {
        currentMode = mode;
        document.querySelectorAll('.mode-option').forEach(e => e.classList.remove('active'));
        el.classList.add('active');
        // Nếu đã có kết quả thì tính lại ngay
        if (selectedLocations.length >= 2 && !document.getElementById('btnRun').disabled) {
            // Có thể tự động chạy lại nếu muốn
        }
    }

    // --- API TỈNH ---
    async function loadProvinces() {
        try {
            const res = await fetch(API_PROVINCES);
            const data = await res.json();
            const sel = document.getElementById('provinceSelect');
            sel.innerHTML = '<option value="">-- Chọn Tỉnh Thành --</option>';
            data.forEach(p => {
                const opt = document.createElement('option');
                opt.value = p.code; opt.text = p.name; opt.dataset.fullName = p.name;
                sel.appendChild(opt);
            });
        } catch (e) { alert("Lỗi tải danh sách tỉnh"); }
    }

    document.getElementById('provinceSelect').addEventListener('change', async function () {
        const name = this.options[this.selectedIndex].dataset.fullName;
        if (!name) return;

        resetApp(false);
        document.getElementById('locationsList').innerHTML = '<div style="text-align:center; padding:20px"><i class="fas fa-spinner fa-spin"></i> Đang tải...</div>';

        // 1. Lấy tọa độ tỉnh
        const geoRes = await fetch(`${API_NOMINATIM}?q=${name}, Vietnam&format=json&limit=1`);
        const geoData = await geoRes.json();
        if (!geoData.length) return;

        const lat = parseFloat(geoData[0].lat), lon = parseFloat(geoData[0].lon);
        map.flyTo([lat, lon], 12);

        // 2. Lấy điểm du lịch (Overpass)
        const query = `
            [out:json][timeout:25];
            (
                node["tourism"~"attraction|museum|zoo|theme_park"](around:20000,${lat},${lon});
                node["historic"~"memorial|monument|ruins"](around:20000,${lat},${lon});
                node["leisure"~"park|water_park"](around:20000,${lat},${lon});
            );
            out body 40;
        `;
        const osmRes = await fetch(`${API_OVERPASS}?data=${encodeURIComponent(query)}`);
        const osmData = await osmRes.json();
        renderList(osmData.elements);
    });

    function renderList(elements) {
        const list = document.getElementById('locationsList');
        list.innerHTML = '';
        const items = elements.filter(x => x.tags && x.tags.name);
        const unique = [];
        const seen = new Set();

        items.forEach(i => {
            if (!seen.has(i.tags.name)) { seen.add(i.tags.name); unique.push(i); }
        });

        if (unique.length === 0) { list.innerHTML = '<div style="padding:10px; text-align:center">Không tìm thấy địa điểm nào</div>'; return; }

        unique.forEach(item => {
            const el = document.createElement('div');
            el.className = 'location-item';
            let icon = 'fa-map-marker-alt', type = 'Địa điểm';

            if (item.tags.tourism === 'museum') { icon = 'fa-landmark'; type = 'Bảo tàng'; }
            else if (item.tags.leisure === 'park') { icon = 'fa-tree'; type = 'Công viên'; }

            el.innerHTML = `<div class="icon"><i class="fas ${icon}"></i></div>
                            <div class="info"><div class="name">${item.tags.name}</div><div class="type">${type}</div></div>
                            <div class="check"><i class="far fa-circle"></i></div>`;

            const locObj = { id: item.id, name: item.tags.name, lat: item.lat, lng: item.lon };
            el.onclick = () => toggleLoc(el, locObj);
            list.appendChild(el);
        });
    }

    function toggleLoc(el, loc) {
        const idx = selectedLocations.findIndex(x => x.id === loc.id);
        if (idx > -1) {
            selectedLocations.splice(idx, 1);
            el.classList.remove('active');
            el.querySelector('.check i').className = 'far fa-circle';
            removeMarker(loc.id);
        } else {
            if (selectedLocations.length >= 8) return alert("Chọn tối đa 8 điểm thôi nhé!");
            selectedLocations.push(loc);
            el.classList.add('active');
            el.querySelector('.check i').className = 'fas fa-check-circle';
            addMarker(loc);
        }
        document.getElementById('counter').innerText = `${selectedLocations.length} chọn`;
        document.getElementById('btnRun').disabled = selectedLocations.length < 2;
    }

    function addMarker(loc) {
        const m = L.marker([loc.lat, loc.lng]).addTo(map).bindPopup(loc.name);
        m._id = loc.id;
        markers.push(m);
    }
    function removeMarker(id) {
        const idx = markers.findIndex(m => m._id === id);
        if (idx > -1) { map.removeLayer(markers[idx]); markers.splice(idx, 1); }
    }

    // --- LOGIC THUẬT TOÁN ---
    document.getElementById('btnRun').addEventListener('click', async () => {
        const loader = document.getElementById('loader');
        const algo = document.getElementById('algoSelect').value;
        loader.style.display = 'flex';

        // Xóa đường cũ
        routeLayers.forEach(l => map.removeLayer(l));
        routeLayers = [];

        try {
            // 1. Chạy thuật toán tìm cặp điểm nối (Client-side MST)
            await new Promise(r => setTimeout(r, 500)); // Fake delay
            let edges = (algo === 'kruskal') ? runKruskal(selectedLocations) : runPrim(selectedLocations);

            // 2. Gọi API vẽ đường thực tế
            let totalDist = 0;
            // Endpoint đổi theo phương tiện: routed-car, routed-bike, routed-foot
            const profile = currentMode === 'car' ? 'routed-car' : (currentMode === 'bike' ? 'routed-bike' : 'routed-foot');

            for (const edge of edges) {
                // API OSRM chuẩn: /route/v1/driving/lon1,lat1;lon2,lat2
                const url = `${OSRM_BASE}/${profile}/route/v1/driving/${edge.from.lng},${edge.from.lat};${edge.to.lng},${edge.to.lat}?overview=full&geometries=geojson`;

                try {
                    const res = await fetch(url);
                    const json = await res.json();

                    if (json.code === 'Ok') {
                        const route = json.routes[0];
                        const line = L.geoJSON(route.geometry, {
                            style: { color: algo === 'kruskal' ? '#FF6F00' : '#2E7D32', weight: 5, opacity: 0.8 }
                        }).addTo(map);

                        line.bindTooltip(`${(route.distance / 1000).toFixed(1)} km`, { sticky: true });
                        routeLayers.push(line);
                        totalDist += route.distance;
                    } else { throw new Error("No route"); }
                } catch (e) {
                    // Fallback đường thẳng nếu API lỗi
                    const line = L.polyline([[edge.from.lat, edge.from.lng], [edge.to.lat, edge.to.lng]],
                        { color: '#90A4AE', weight: 3, dashArray: '5,5' }).addTo(map);
                    routeLayers.push(line);
                    totalDist += edge.dist * 1000; // Dùng khoảng cách chim bay
                }
                await new Promise(r => setTimeout(r, 150)); // Tránh spam server
            }

            // 3. Hiển thị Dashboard
            const km = (totalDist / 1000).toFixed(2);
            let unitPrice = currentMode === 'car' ? 15000 : (currentMode === 'bike' ? 5000 : 0);
            const cost = Math.round((totalDist / 1000) * unitPrice).toLocaleString();

            let iconMode = '<i class="fas fa-car"></i> Ô tô';
            if (currentMode === 'bike') iconMode = '<i class="fas fa-motorcycle"></i> Xe máy';
            if (currentMode === 'foot') iconMode = '<i class="fas fa-walking"></i> Đi bộ';

            document.getElementById('resMode').innerHTML = iconMode;
            document.getElementById('resDist').innerText = km;
            document.getElementById('resCost').innerText = cost;
            document.getElementById('dashboard').style.display = 'grid';

        } catch (e) { alert("Lỗi tính toán"); console.error(e); }
        finally { loader.style.display = 'none'; }
    });

    // --- ALGORITHMS ---
    function getDist(p1, p2) { // Haversine Km
        const R = 6371, dLat = (p2.lat - p1.lat) * Math.PI / 180, dLon = (p2.lng - p1.lng) * Math.PI / 180;
        const a = Math.sin(dLat / 2) ** 2 + Math.cos(p1.lat * Math.PI / 180) * Math.cos(p2.lat * Math.PI / 180) * Math.sin(dLon / 2) ** 2;
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }

    function runPrim(nodes) {
        const n = nodes.length, visited = new Array(n).fill(false), edges = [];
        visited[0] = true; let count = 0;
        while (count < n - 1) {
            let min = Infinity, u = -1, v = -1;
            for (let i = 0; i < n; i++) if (visited[i])
                for (let j = 0; j < n; j++) if (!visited[j]) {
                    const d = getDist(nodes[i], nodes[j]);
                    if (d < min) { min = d; u = i; v = j; }
                }
            if (u !== -1) { visited[v] = true; edges.push({ from: nodes[u], to: nodes[v], dist: min }); count++; }
        }
        return edges;
    }

    function runKruskal(nodes) {
        const n = nodes.length, all = [], edges = [];
        for (let i = 0; i < n; i++) for (let j = i + 1; j < n; j++)
            all.push({ u: i, v: j, from: nodes[i], to: nodes[j], dist: getDist(nodes[i], nodes[j]) });
        all.sort((a, b) => a.dist - b.dist);

        const parent = Array.from({ length: n }, (_, i) => i);
        const find = i => parent[i] === i ? i : parent[i] = find(parent[i]);
        const union = (i, j) => { const rI = find(i), rJ = find(j); if (rI !== rJ) { parent[rI] = rJ; return true; } return false; };

        for (const e of all) if (union(e.u, e.v)) edges.push(e);
        return edges;
    }

    window.resetApp = function (clear = true) {
        routeLayers.forEach(l => map.removeLayer(l)); routeLayers = [];
        document.getElementById('dashboard').style.display = 'none';
        if (clear) {
            markers.forEach(m => map.removeLayer(m)); markers = []; selectedLocations = [];
            document.querySelectorAll('.location-item').forEach(e => {
                e.classList.remove('active'); e.querySelector('.check i').className = 'far fa-circle';
            });
            document.getElementById('counter').innerText = '0 chọn';
            document.getElementById('btnRun').disabled = true;
        }
    }
</script>