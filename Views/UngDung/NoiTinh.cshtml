@{
    ViewBag.Title = "Du Lịch Nội Tỉnh";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>

<style>
    /* BẢNG MÀU ORGANIC & NATURE */
    :root {
        --bg-main: #F9F7F2; --text-color: #4E342E; --panel-bg: #FFFFFF;
        --prim-color: #2E7D32; --kruskal-color: #D84315;
        --grid-empty: #ECEFF1; --shadow-soft: 0 10px 30px rgba(78, 52, 46, 0.08);
        --border-radius: 20px;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
        font-family: 'Nunito', sans-serif; background-color: var(--bg-main);
        background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23d7ccc8' fill-opacity='0.2'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
        color: var(--text-color); min-height: 100vh; padding: 30px;
    }
    .container { max-width: 1400px; margin: 0 auto; }
    .banner { text-align: center; margin-bottom: 40px; }
    .banner h1 { font-family: 'Quicksand', sans-serif; font-size: 2.8rem; font-weight: 700; color: var(--text-color); margin-bottom: 10px; }
    .banner p { font-size: 1.1rem; color: #8D6E63; }
    .banner::after { content: ''; display: block; width: 60px; height: 4px; background: var(--prim-color); margin: 20px auto 0; border-radius: 2px; }
    .content-wrapper { display: flex; gap: 30px; flex-wrap: wrap; }

    /* SIDEBAR */
    .selection-panel { flex: 0 0 380px; background: var(--panel-bg); border-radius: var(--border-radius); box-shadow: var(--shadow-soft); padding: 30px; height: fit-content; border: 1px solid rgba(78, 52, 46, 0.05); position: sticky; top: 20px; }
    .panel-header h2 { font-family: 'Quicksand', sans-serif; font-size: 1.4rem; color: var(--prim-color); margin-bottom: 20px; display: flex; align-items: center; gap: 10px; }
    .custom-select { width: 100%; padding: 14px 20px; border: 2px solid #EFEBE9; border-radius: 12px; font-size: 1rem; font-family: 'Nunito', sans-serif; color: var(--text-color); background: #FAFAFA; transition: 0.3s; margin-bottom: 15px; cursor: pointer; }
    .custom-select:focus { outline: none; border-color: var(--prim-color); background: #fff; }
    .locations-list { max-height: 400px; overflow-y: auto; margin-bottom: 20px; padding: 10px; border: 1px solid #EFEBE9; border-radius: 12px; background: #FAFAFA; }
    .locations-list::-webkit-scrollbar { width: 6px; }
    .locations-list::-webkit-scrollbar-thumb { background: #D7CCC8; border-radius: 10px; }
    .location-option { display: flex; align-items: center; padding: 12px; margin-bottom: 6px; background: #fff; border: 1px solid #EFEBE9; border-radius: 10px; cursor: pointer; transition: 0.2s; }
    .location-option:hover { border-color: var(--prim-color); transform: translateX(3px); }
    .location-option input { width: 18px; height: 18px; accent-color: var(--prim-color); margin-right: 12px; cursor: pointer; }
    .location-option label { cursor: pointer; font-weight: 600; color: var(--text-color); flex: 1; font-size: 0.95rem; }
    .btn-calculate { width: 100%; padding: 16px; font-size: 1.1rem; font-weight: 700; color: white; background: linear-gradient(135deg, #66BB6A 0%, #2E7D32 100%); border: none; border-radius: 12px; cursor: pointer; box-shadow: 0 8px 20px rgba(46, 125, 50, 0.25); transition: 0.3s; display: flex; align-items: center; justify-content: center; gap: 10px; }
    .btn-calculate:hover:not(:disabled) { transform: translateY(-3px); box-shadow: 0 12px 25px rgba(46, 125, 50, 0.35); }
    .btn-calculate:disabled { background: #BCAAA4; cursor: not-allowed; box-shadow: none; }

    /* RESULTS */
    .results-panel { flex: 1; background: var(--panel-bg); border-radius: var(--border-radius); box-shadow: var(--shadow-soft); padding: 40px; min-height: 600px; border: 1px solid rgba(78, 52, 46, 0.05); }
    .initial-message { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #BCAAA4; text-align: center; margin-top: 100px; }
    .initial-message i { font-size: 4rem; margin-bottom: 20px; color: #EFEBE9; }
    .optimal-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 30px; }
    .stat-card { background: #FAFAFA; border: 1px solid #EFEBE9; border-radius: 16px; padding: 20px; }
    .stat-label { font-size: 0.85rem; color: #8D6E63; text-transform: uppercase; display: block; margin-bottom: 5px; }
    .stat-value { font-size: 1.8rem; font-weight: 800; font-family: 'Quicksand', sans-serif; color: var(--text-color); }
    .stat-unit { font-size: 0.9rem; color: #BCAAA4; font-weight: 600; }
    .stat-card.highlight { background: #FFF3E0; border-color: #FFE082; }
    .stat-card.highlight .stat-value { color: #E65100; }
    .route-box { background: #F1F8E9; padding: 25px; border-radius: 16px; border-left: 5px solid var(--prim-color); margin-bottom: 30px; }
    .route-text { font-size: 1.1rem; font-weight: 700; color: #1B5E20; line-height: 1.6; }
    .charts-container { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 25px; }
    .chart-box { background: #fff; border: 1px solid #EFEBE9; border-radius: 16px; padding: 20px; height: 320px; }
    .edge-list { display: grid; gap: 10px; }
    .edge-item { background: #fff; border: 1px solid #EFEBE9; padding: 12px; border-radius: 10px; border-left: 4px solid var(--kruskal-color); font-size: 0.95rem; }

    @@media (max-width: 1024px) { .content-wrapper { flex-direction: column; } .selection-panel { width: 100%; position: static; } }
</style>

<div class="container">
    <div class="banner">
        <h1>Du Lịch Nội Tỉnh</h1>
        <p>Tìm đường đi ngắn nhất giữa các địa danh trong một tỉnh</p>
    </div>

    <div class="content-wrapper">
        <aside class="selection-panel">
            <div class="panel-header"><h2><i class="fas fa-map-pin"></i> Chọn Địa Điểm</h2></div>

            <div style="margin-bottom:15px">
                <label style="font-weight:700; color:#8D6E63; display:block; margin-bottom:5px">Tỉnh / Thành phố:</label>
                <select id="provinceSelect" class="custom-select">
                    <option value="">-- Đang tải... --</option>
                </select>
            </div>

            <div id="locationsContainer">
                <label style="font-weight:700; color:#8D6E63; display:block; margin-bottom:5px">Danh sách địa điểm:</label>
                <div class="locations-list" id="locationsList">
                    <div style="padding:20px; text-align:center; color:#BCAAA4">Vui lòng chọn tỉnh trước</div>
                </div>
            </div>

            <button id="calcBtn" class="btn-calculate" type="button" disabled>
                <i class="fas fa-calculator"></i> TÍNH TOÁN LỘ TRÌNH
            </button>
        </aside>

        <main class="results-panel">
            <div id="loadingSpinner" style="display:none; height:100%; flex-direction:column; align-items:center; justify-content:center;">
                <div style="font-size:3rem; color:var(--prim-color); margin-bottom:20px"><i class="fas fa-circle-notch fa-spin"></i></div>
                <p style="color:#8D6E63; font-weight:600">Đang tìm đường đi tối ưu...</p>
            </div>

            <div id="initialMessage" class="initial-message">
                <i class="fas fa-route"></i>
                <p>Chọn tỉnh và ít nhất 2 địa điểm để bắt đầu.</p>
            </div>

            <div id="resultsContent" style="display:none">
                <section>
                    <div style="margin-bottom:20px">
                        <h2 style="font-family:'Quicksand'; font-size:1.5rem; color:var(--text-color); margin-bottom:15px">
                            <i class="fas fa-star" style="color:#FBC02D"></i> Kết Quả Tối Ưu
                        </h2>
                    </div>

                    <div class="optimal-grid">
                        <div class="stat-card">
                            <span class="stat-label">Thuật Toán</span>
                            <span class="stat-value" id="optAlgo" style="color:var(--prim-color); font-size:1.4rem">-</span>
                        </div>
                        <div class="stat-card highlight">
                            <span class="stat-label">Tổng Chi Phí</span>
                            <span class="stat-value" id="optCost">-</span>
                            <span class="stat-unit">VNĐ</span>
                        </div>
                        <div class="stat-card">
                            <span class="stat-label">Tổng Quãng Đường</span>
                            <span class="stat-value" id="optDist">-</span>
                            <span class="stat-unit">Km</span>
                        </div>
                    </div>

                    <div class="route-box">
                        <div style="text-transform:uppercase; font-size:0.8rem; color:#558B2F; margin-bottom:8px;">Lộ trình gợi ý:</div>
                        <div class="route-text" id="optPath">-</div>
                    </div>
                </section>

                <section>
                    <h2 style="font-family:'Quicksand'; font-size:1.4rem; color:var(--text-color); margin-bottom:20px; border-bottom:2px dashed #EFEBE9; padding-bottom:10px">
                        <i class="fas fa-chart-pie" style="color:#8D6E63"></i> Thống Kê
                    </h2>
                    <div class="charts-container">
                        <div class="chart-box"><canvas id="costChart"></canvas></div>
                        <div class="chart-box"><canvas id="timeChart"></canvas></div>
                    </div>
                </section>

                <br>
                <section>
                    <h2 style="font-family:'Quicksand'; font-size:1.4rem; color:var(--text-color); margin-bottom:20px; border-bottom:2px dashed #EFEBE9; padding-bottom:10px">
                        <i class="fas fa-list-ul" style="color:#8D6E63"></i> Chi Tiết Các Chặng
                    </h2>
                    <div class="edge-list" id="edgeList"></div>
                </section>
            </div>
        </main>
    </div>
</div>

@section scripts {
    <script>
        let allProvinces = [];
        let allLocations = [];
        let charts = {};

        async function init() {
            await loadProvinces();
        }

        // 1. Load Tỉnh
        async function loadProvinces() {
            try {
                const res = await fetch('/UngDung/GetProvinces');
                const data = await res.json();
                const sel = document.getElementById('provinceSelect');
                sel.innerHTML = '<option value="">-- Chọn Tỉnh Thành --</option>';

                if (data.success) {
                    allProvinces = data.data;
                    allProvinces.forEach(p => {
                        sel.innerHTML += `<option value="${p.id}">${p.name}</option>`;
                    });
                }
            } catch (e) { console.error(e); }
        }

        // 2. Load Địa điểm
        document.getElementById('provinceSelect').addEventListener('change', async (e) => {
            const pid = e.target.value;
            const list = document.getElementById('locationsList');

            if (!pid) {
                list.innerHTML = '<div style="padding:20px; text-align:center; color:#BCAAA4">Vui lòng chọn tỉnh trước</div>';
                return;
            }

            list.innerHTML = '<div style="padding:20px; text-align:center; color:#8D6E63"><i class="fas fa-spinner fa-spin"></i> Đang tìm địa điểm (DB/API)...</div>';

            try {
                const res = await fetch(`/UngDung/GetLocationsByProvinceID_V2?provinceID=${pid}`);
                const data = await res.json();

                if (data.success && data.data.length > 0) {
                    allLocations = data.data;
                    renderLocations(allLocations);
                } else {
                    list.innerHTML = `<div style="padding:20px; text-align:center; color:#D84315">${data.message || 'Không tìm thấy địa điểm nào'}</div>`;
                }
            } catch (err) {
                // Mock data fallback
                const mockLocs = [
                    { Id: 1, Name: "Chợ Trung Tâm", Latitude: 10.1, Longitude: 105.1 },
                    { Id: 2, Name: "Bảo Tàng Tỉnh", Latitude: 10.2, Longitude: 105.2 },
                    { Id: 3, Name: "Công Viên Văn Hóa", Latitude: 10.15, Longitude: 105.15 },
                    { Id: 4, Name: "Nhà Thờ Lớn", Latitude: 10.12, Longitude: 105.18 }
                ];
                allLocations = mockLocs;
                renderLocations(mockLocs);
            }
        });

        function renderLocations(locs) {
            const list = document.getElementById('locationsList');
            list.innerHTML = locs.map(l => `
                <div class="location-option">
                    <input type="checkbox" class="loc-chk" value="${l.Id}" id="loc-${l.Id}">
                    <label for="loc-${l.Id}">${l.Name}</label>
                    <span class="location-source" style="font-size:0.7rem; color:#ccc"><i class="fas fa-database"></i></span>
                </div>
            `).join('');

            document.querySelectorAll('.loc-chk').forEach(cb => {
                cb.addEventListener('change', () => {
                    const count = document.querySelectorAll('.loc-chk:checked').length;
                    document.getElementById('calcBtn').disabled = count < 2;
                });
            });
        }

        // 3. Tính Toán
        document.getElementById('calcBtn').addEventListener('click', async (e) => {
            e.preventDefault(); // CHẶN SUBMIT FORM TUYỆT ĐỐI

            const selectedIds = Array.from(document.querySelectorAll('.loc-chk:checked')).map(c => parseInt(c.value));
            const selectedLocs = allLocations.filter(l => selectedIds.includes(l.Id));

            if (selectedLocs.length < 2) return alert('Chọn ít nhất 2 địa điểm!');

            // UI Loading
            document.getElementById('loadingSpinner').style.display = 'flex';
            document.getElementById('resultsContent').style.display = 'none';
            document.getElementById('initialMessage').style.display = 'none';

            try {
                const res = await fetch('/UngDung/CalculateNoiTinhRoute', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ selectedLocations: selectedLocs })
                });
                const data = await res.json();

                if (data.success) {
                    displayResult(data);
                    document.getElementById('resultsContent').style.display = 'block';
                } else {
                    alert(data.message);
                    document.getElementById('initialMessage').style.display = 'flex';
                }
            } catch (e) {
                alert('Lỗi kết nối server.');
            } finally {
                document.getElementById('loadingSpinner').style.display = 'none';
            }
        });

        function displayResult(data) {
            const opt = data.optimalRoute;
            const p = data.primResult;
            const k = data.kruskalResult;

            // Info
            document.getElementById('optAlgo').innerText = opt.algorithmName;
            document.getElementById('optCost').innerText = Math.round(opt.totalCost).toLocaleString();
            document.getElementById('optDist').innerText = opt.totalDistance.toFixed(2);
            document.getElementById('optPath').innerText = opt.routeNames.join(' ➝ ');

            // Edge List
            const list = document.getElementById('edgeList');
            list.innerHTML = opt.edges.map((e, i) => `
                <div class="edge-item">
                    <div style="font-weight:700; color:#4E342E; margin-bottom:5px">
                        <span style="color:#D84315">#${i + 1}</span> ${e.fromName} <i class="fas fa-arrows-alt-h" style="color:#BCAAA4; font-size:0.8rem"></i> ${e.toName}
                    </div>
                    <div style="font-size:0.85rem; color:#8D6E63">
                        Chi phí: <strong>${Math.round(e.cost).toLocaleString()}</strong> VNĐ • Dài: <strong>${e.distance.toFixed(2)}</strong> km
                    </div>
                </div>
            `).join('');

            // Charts
            drawCharts(p, k);
        }

        function drawCharts(p, k) {
            Object.values(charts).forEach(c => c?.destroy && c.destroy());
            charts = {};

            const createChart = (id, label, d1, d2) => {
                return new Chart(document.getElementById(id).getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: ['Prim', 'Kruskal'],
                        datasets: [{
                            label: label,
                            data: [d1, d2],
                            backgroundColor: ['#2E7D32', '#D84315'],
                            borderRadius: 8
                        }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
                });
            };

            charts.cost = createChart('costChart', 'Chi phí', p.totalCost, k.totalCost);
            charts.time = createChart('timeChart', 'Thời gian', p.executionTime, k.executionTime);
        }

        init();
    </script>
}