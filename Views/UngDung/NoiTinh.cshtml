@{
    ViewBag.Title = "Du Lịch Nội Tỉnh";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    /*
      UI NOTE: Đã re-theme (thiết kế lại) 100%
      - Xóa bỏ theme tím/trắng cũ.
      - Áp dụng theme Xanh xám đậm / Nâu / Đỏ từ _Layout.
    */

    /* Xóa 'body' và 'container', kế thừa từ _Layout */

    .banner {
        text-align: center;
        color: var(--text-on-light);
        margin-bottom: 30px;
        padding: 40px 20px;
        background: var(--bg-secondary); /* Dùng nền panel */
        border-radius: 15px;
        backdrop-filter: blur(10px);
        border: 1px solid var(--border-color);
    }

        .banner h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
            color: var(--text-on-light); /* Đảm bảo chữ trắng */
        }

        .banner p {
            font-size: 1.1em;
            opacity: 0.95;
            color: var(--text-muted); /* Dùng màu chữ mờ */
        }

    .content-wrapper {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .selection-panel {
        flex: 0 0 380px;
        background: var(--bg-secondary); /* Nền panel tối */
        color: var(--text-on-dark); /* Chữ sáng */
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
        padding: 25px;
        height: fit-content;
        position: sticky;
        top: 20px;
        border: 1px solid var(--border-color);
    }

    .panel-header h2 {
        font-size: 1.5em;
        color: var(--accent-primary); /* Nhấn màu Nâu */
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .hint-box {
        background: #4a4023; /* Nền vàng sậm */
        border: 2px solid #f59e0b; /* Viền vàng */
        border-radius: 8px;
        padding: 12px;
        margin-bottom: 15px;
        font-size: 0.9em;
        color: #ffe8a1; /* Chữ vàng nhạt */
    }

    .search-box {
        margin-bottom: 20px;
    }

    .search-input {
        width: 100%;
        padding: 12px;
        border: 2px solid var(--border-color);
        background: var(--bg-main); /* Nền input tối */
        color: var(--text-on-dark); /* Chữ sáng */
        border-radius: 8px;
        font-size: 1em;
        transition: border-color 0.3s;
    }

        .search-input:focus {
            outline: none;
            border-color: var(--accent-primary); /* Focus màu Nâu */
        }

    .search-box label {
        display: block;
        margin-bottom: 8px;
        font-weight: 500;
        color: var(--text-muted);
    }

    .provinces-list {
        max-height: 300px;
        overflow-y: auto;
        margin-bottom: 20px;
        padding: 8px;
        border: 1px solid var(--border-color);
        background: var(--bg-main); /* Nền list tối */
        border-radius: 8px;
    }

        .provinces-list::-webkit-scrollbar {
            width: 6px;
        }

        .provinces-list::-webkit-scrollbar-track {
            background: var(--bg-main);
            border-radius: 10px;
        }

        .provinces-list::-webkit-scrollbar-thumb {
            background: var(--accent-primary); /* Scrollbar Nâu */
            border-radius: 10px;
        }

    .province-option {
        display: flex;
        align-items: center;
        padding: 12px;
        margin: 4px 0;
        background: var(--bg-secondary); /* Nền item tối */
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s;
        border: 2px solid transparent;
    }

        .province-option:hover {
            background: var(--bg-secondary);
            border-color: var(--accent-primary); /* Hover Nâu */
        }

        .province-option input[type="checkbox"] {
            width: 20px;
            height: 20px;
            cursor: pointer;
            accent-color: var(--accent-primary); /* Checkbox Nâu */
        }

        .province-option label {
            flex: 1;
            margin-left: 12px;
            cursor: pointer;
            font-weight: 500;
            color: var(--text-on-dark); /* Chữ sáng */
        }

    .panel-actions {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
    }

    .btn {
        flex: 1;
        padding: 12px;
        border: none;
        border-radius: 8px;
        font-size: 0.95em;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .btn-clear {
        background: var(--accent-secondary); /* Dùng màu Đỏ */
        color: white;
    }

        .btn-clear:hover {
            background: #c1121f; /* Đỏ sậm hơn */
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(217, 91, 91, 0.3);
        }

    .btn-save {
        background: #10b981; /* Dùng màu Success (Xanh lá) */
        color: white;
    }

        .btn-save:hover {
            background: #0f9a6c;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
        }

    .btn-calculate {
        background: linear-gradient(135deg, var(--accent-primary), var(--dark-brown)); /* Gradient Nâu */
        color: white;
        width: 100%;
        font-size: 1.1em;
        padding: 14px;
        margin-top: 10px;
    }

        .btn-calculate:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(139, 112, 92, 0.4);
        }

        .btn-calculate:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .selected-info {
        background: var(--bg-main); /* Nền tối */
        padding: 15px;
        border-radius: 8px;
        border-left: 4px solid var(--accent-primary); /* Viền Nâu */
    }

        .selected-info h3 {
            color: var(--accent-primary); /* Chữ Nâu */
            margin-bottom: 12px;
            font-size: 1em;
        }

    .selected-list {
        list-style: none;
    }

    .selected-item {
        background: var(--bg-secondary); /* Nền tối */
        padding: 8px 12px;
        margin: 6px 0;
        border-radius: 6px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.9em;
        color: var(--text-on-dark); /* Chữ sáng */
        border-left: 3px solid var(--success); /* Viền Xanh lá */
    }

    .remove-vertex {
        background: var(--accent-secondary); /* Nút Đỏ */
        color: white;
        border: none;
        padding: 4px 8px;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.8em;
        transition: all 0.3s;
    }

        .remove-vertex:hover {
            background: #c1121f;
        }

    .results-panel {
        flex: 1;
        background: var(--bg-secondary); /* Nền panel tối */
        color: var(--text-on-dark); /* Chữ sáng */
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
        padding: 30px;
        min-height: 500px;
        overflow-y: auto;
        max-height: 90vh;
        border: 1px solid var(--border-color);
    }

    .initial-message {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 400px;
        color: var(--text-muted); /* Dùng màu chữ mờ */
        font-size: 1.2em;
        text-align: center;
    }

        .initial-message i {
            font-size: 3em;
            margin-bottom: 20px;
            color: var(--border-color); /* Dùng màu viền */
        }

    .loading-spinner {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 400px;
        color: var(--text-muted); /* Dùng màu chữ mờ */
    }

    .spinner {
        border: 4px solid var(--border-color);
        border-top: 4px solid var(--accent-primary); /* Spinner màu Nâu */
        border-radius: 50%;
        width: 50px;
        height: 50px;
        animation: spin 1s linear infinite;
        margin-bottom: 20px;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }


    .result-section {
        margin-bottom: 30px;
        padding-bottom: 30px;
        border-bottom: 2px solid var(--border-color);
    }

        .result-section:last-child {
            border-bottom: none;
        }

        .result-section h2 {
            color: var(--accent-primary); /* Tiêu đề Nâu */
            margin-bottom: 20px;
            font-size: 1.5em;
            display: flex;
            align-items: center;
            gap: 10px;
        }

    .optimal-info {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
        margin-bottom: 20px;
    }

    .info-box {
        background: linear-gradient(135deg, var(--accent-primary), var(--dark-brown)); /* Gradient Nâu */
        color: white;
        padding: 20px;
        border-radius: 10px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .info-box .label {
            font-size: 0.9em;
            opacity: 0.9;
        }

        .info-box .value {
            font-size: 1.6em;
            font-weight: bold;
        }

        .info-box .unit {
            font-size: 0.85em;
            opacity: 0.8;
        }

    .route-info {
        background: var(--bg-main); /* Nền tối */
        padding: 20px;
        border-radius: 10px;
        border-left: 4px solid var(--accent-primary); /* Viền Nâu */
        margin-bottom: 20px;
    }

        .route-info h3 {
            color: var(--accent-primary); /* Chữ Nâu */
            margin-bottom: 10px;
        }

    .route-path {
        font-family: 'Courier New', monospace;
        color: var(--text-on-dark); /* Chữ sáng */
        font-size: 1em;
        font-weight: 600;
        line-height: 1.6;
        word-wrap: break-word;
    }

    .comparison-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
        font-size: 0.95em;
    }

        .comparison-table thead {
            background: var(--bg-main); /* Nền tối */
        }

        .comparison-table th, .comparison-table td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid var(--border-color);
        }

        .comparison-table th {
            font-weight: 600;
            color: var(--accent-primary); /* Chữ Nâu */
        }

        .comparison-table tbody tr:hover {
            background: rgba(255,255,255,0.05); /* Hover sáng nhẹ */
        }

    .charts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .chart-container {
        background: var(--bg-main); /* Nền tối */
        padding: 20px;
        border-radius: 10px;
        border: 2px solid var(--border-color);
        height: 300px;
    }

        .chart-container h3 {
            color: var(--accent-primary); /* Chữ Nâu */
            margin-bottom: 15px;
            font-size: 1em;
        }

        /* Bảng màu Chart.js (sáng) trên nền tối */
        .chart-container h3,
        .comparison-table th, .comparison-table td {
            color: var(--text-on-dark); /* Đảm bảo chữ sáng */
        }

    .comparison-table th {
        color: var(--accent-primary); /* Tiêu đề bảng màu Nâu */
    }

    .chart-container h3 {
        color: var(--accent-primary); /* Tiêu đề chart màu Nâu */
    }


    .error-message {
        background: #4a2424; /* Nền đỏ sậm */
        color: #ff8a8a; /* Chữ đỏ nhạt */
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
        border-left: 4px solid var(--accent-secondary); /* Viền Đỏ */
        display: flex;
        gap: 10px;
        align-items: flex-start;
    }

    .success-message {
        background: #224a22; /* Nền xanh sậm */
        color: #8aff8a; /* Chữ xanh nhạt */
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
        border-left: 4px solid var(--success); /* Viền Xanh lá */
        display: flex;
        gap: 10px;
        align-items: flex-start;
    }

    .edge-list {
        margin-top: 15px;
        max-height: 200px;
        overflow-y: auto;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 10px;
        background: var(--bg-main); /* Nền tối */
    }

    .edge-item {
        padding: 8px;
        margin: 4px 0;
        background: var(--bg-secondary); /* Nền panel */
        border-radius: 6px;
        border-left: 3px solid var(--accent-primary); /* Viền Nâu */
        font-size: 0.9em;
        color: var(--text-on-dark); /* Chữ sáng */
    }

    @@media (max-width: 1024px) {
        .content-wrapper {
            flex-direction: column;
        }

        .selection-panel {
            flex: 1;
            position: static;
        }

        .banner h1 {
            font-size: 2em;
        }
    }
</style>

<div class="container">
    <div class="banner" data-aos="fade-down">
        <h1><i class="fas fa-city"></i> Du Lịch Nội Tỉnh Tối Ưu</h1>
        <p>Tìm tuyến đường ngắn nhất giữa các địa điểm trong tỉnh</p>
    </div>

    <div class="content-wrapper">
        <aside class="selection-panel" data-aos="fade-right" data-aos-delay="100">
            <div class="panel-header">
                <h2><i class="fas fa-map-marker-alt"></i> Chọn Tỉnh và Địa Điểm</h2>
            </div>

            <div class="search-box">
                <label for="provinceSelect">Chọn một tỉnh:</label>
                <select id="provinceSelect" class="search-input">
                    <option value="">-- Đang tải danh sách tỉnh --</option>
                </select>
            </div>

            <div class="hint-box">
                <i class="fas fa-lightbulb"></i> <strong>Gợi ý:</strong> Chọn tỉnh, sau đó chọn ít nhất 2 địa điểm và nhấn "Tính Toán".
            </div>

            <div class="provinces-list" id="locationsList">
                <div style="padding: 20px; text-align: center; color: var(--text-muted);">
                    Vui lòng chọn một tỉnh...
                </div>
            </div>

            <button id="calculateBtn" class="btn btn-calculate">
                <i class="fas fa-calculator"></i> Tính Toán Tuyến Đường
            </button>

        </aside>

        <main class="results-panel" data-aos="fade-left" data-aos-delay="200">
            <div id="initialMessage" class="initial-message" style="display: flex;">
                <i class="fas fa-info-circle"></i>
                <p>Chọn tỉnh và ít nhất 2 địa điểm, sau đó nhấn "Tính Toán Tuyến Đường"</p>
            </div>

            <div id="loadingSpinner" class="loading-spinner" style="display: none;">
                <div class="spinner"></div>
                <p>Đang tính toán tuyến đường tối ưu...</p>
            </div>

            <div id="resultsContent" style="display: none;">
                <section class="result-section optimal-result">
                    <h2><i class="fas fa-star"></i> Tuyến Đường Tối Ưu</h2>
                    <div id="messageBox"></div> <div class="optimal-info">
                        <div class="info-box">
                            <span class="label">Thuật Toán</span>
                            <span class="value" id="optimalAlgorithm">-</span>
                        </div>
                        <div class="info-box">
                            <span class="label">Chi Phí Tổng</span>
                            <span class="value" id="optimalCost">-</span>
                            <span class="unit">VNĐ</span>
                        </div>
                        <div class="info-box">
                            <span class="label">Khoảng Cách</span>
                            <span class="value" id="optimalDistance">-</span>
                            <span class="unit">Km</span>
                        </div>
                        <div class="info-box">
                            <span class="label">Thời Gian Thực Thi</span>
                            <span class="value" id="optimalTime">-</span>
                            <span class="unit">ms</span>
                        </div>
                    </div>
                    <div class="route-info">
                        <h3>Tuyến Đường Chi Tiết</h3>
                        <p id="routePath" class="route-path">-</p>
                    </div>
                </section>

                <section class="result-section comparison-table-section">
                    <h2><i class="fas fa-table"></i> Bảng So Sánh Thuật Toán</h2>
                    <table class="comparison-table">
                        <thead>
                            <tr>
                                <th>Chỉ Số</th>
                                <th>Prim</th>
                                <th>Kruskal</th>
                                <th>Chênh Lệch</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>Chi Phí (VNĐ)</strong></td>
                                <td><span id="primCostVal">-</span></td>
                                <td><span id="kruskalCostVal">-</span></td>
                                <td><span id="costDiff">-</span></td>
                            </tr>
                            <tr>
                                <td><strong>Thời Gian (ms)</strong></td>
                                <td><span id="primTimeVal">-</span></td>
                                <td><span id="kruskalTimeVal">-</span></td>
                                <td><span id="timeDiff">-</span></td>
                            </tr>
                            <tr>
                                <td><strong>Số Phép Toán</strong></td>
                                <td><span id="primOpsVal">-</span></td>
                                <td><span id="kruskalOpsVal">-</span></td>
                                <td><span id="opsDiff">-</span></td>
                            </tr>
                            <tr>
                                <td><strong>Số Cạnh (MST)</strong></td>
                                <td><span id="primEdgesVal">-</span></td>
                                <td><span id="kruskalEdgesVal">-</span></td>
                                <td>-</td>
                            </tr>
                            <tr>
                                <td><strong>Độ Phức Tạp</strong></td>
                                <td>O(V²)</td>
                                <td>O(E log E)</td>
                                <td>-</td>
                            </tr>
                        </tbody>
                    </table>
                </section>

                <section class="result-section charts-section">
                    <h2><i class="fas fa-chart-bar"></i> Biểu Đồ Thống Kê So Sánh</h2>
                    <div class="charts-grid">
                        <div class="chart-container">
                            <h3>Chi Phí So Sánh (VNĐ)</h3>
                            <canvas id="costChart"></canvas>
                        </div>
                        <div class="chart-container">
                            <h3>Thời Gian Thực Thi (ms)</h3>
                            <canvas id="timeChart"></canvas>
                        </div>
                        <div class="chart-container">
                            <h3>Số Phép Toán</h3>
                            <canvas id="operationsChart"></canvas>
                        </div>
                        <div class="chart-container">
                            <h3>Số Cạnh trong MST</h3>
                            <canvas id="edgesChart"></canvas>
                        </div>
                    </div>
                </section>

                <section class="result-section">
                    <h2><i class="fas fa-network-wired"></i> Danh Sách Cạnh Tuyến Tối Ưu</h2>
                    <div class="edge-list" id="edgesList"></div>
                </section>
            </div>
        </main>
    </div>
</div>

@section scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
    <script>
        let allProvinces = [];
        let allLocations = []; // Lưu danh sách địa điểm (full object)
        let charts = {}; // Cần để hàm displayResults chạy

        document.addEventListener('DOMContentLoaded', init);

        async function init() {
            await loadProvincesDropdown();
            setupEventListeners();
        }

        // Tải danh sách TỈNH vào dropdown
        async function loadProvincesDropdown() {
            try {
                const response = await fetch('/UngDung/GetProvinces');
                const result = await response.json();
                const selectEl = document.getElementById('provinceSelect');

                if (result.success) {
                    allProvinces = result.data;
                    selectEl.innerHTML = '<option value="">-- Chọn một tỉnh --</option>'; // Xóa "Đang tải"

                    allProvinces.forEach(province => {
                        selectEl.innerHTML += `<option value="${province.id}">${province.name}</option>`;
                    });
                } else {
                    selectEl.innerHTML = '<option value="">-- Lỗi tải tỉnh --</option>';
                }
            } catch (error) {
                console.error('Lỗi tải tỉnh:', error);
                document.getElementById('provinceSelect').innerHTML = '<option value="">-- Lỗi kết nối --</option>';
            }
        }
        function setupEventListeners() {
            // Khi người dùng CHỌN 1 TỈNH
            document.getElementById('provinceSelect').addEventListener('change', async (e) => {
                const provinceId = e.target.value;
                if (provinceId) {
                    await loadLocationForProvince(provinceId);
                } else {
                    document.getElementById('locationsList').innerHTML = '<div style="padding: 20px; text-align: center; color: var(--text-muted);">Vui lòng chọn một tỉnh...</div>';
                }
            });

            // Khi người dùng NHẤN NÚT TÍNH TOÁN
            document.getElementById('calculateBtn').addEventListener('click', calculateNoiTinhRoute);
        }

        // Tải danh sách ĐỊA ĐIỂM (Nội tỉnh)
        async function loadLocationForProvince(provinceId) {
            const listContainer = document.getElementById('locationsList');
            listContainer.innerHTML = '<div style="padding: 20px; text-align: center; color: var(--text-muted);"><i class="fas fa-spinner fa-spin"></i> Đang tải địa điểm...</div>';

            try {
                // Free plan: use Overpass with broad tag set to increase results
                let response = await fetch(`/UngDung/GetLocationsByProvinceID_V2?provinceID=${provinceId}&useOverpass=true&broad=true`);
                let result = await response.json();

                // If still empty, try once more without broad to handle odd servers
                if ((!result.success || !result.data || result.data.length === 0)) {
                    response = await fetch(`/UngDung/GetLocationsByProvinceID_V2?provinceID=${provinceId}&useOverpass=true`);
                    result = await response.json();
                }

                if (result.success && result.data.length > 0) {
                    allLocations = result.data; // Lưu lại để dùng khi tính toán

                    listContainer.innerHTML = allLocations.map(loc => `
                    <div class="province-option">
                        <input type="checkbox" class="location-checkbox" id="location-${loc.id}" value="${loc.id}">
                        <label for="location-${loc.id}">${loc.name}</label>
                    </div>
                `).join('');
                } else {
                    // Hiển thị lỗi (nếu có) từ server
                    const errorMessage = result.message || "Không tìm thấy địa điểm nào cho tỉnh này.";
                    listContainer.innerHTML = `<div style="padding: 20px; text-align: center; color: var(--text-muted);">${errorMessage}</div>`;
                }
            } catch (error) {
                console.error('Lỗi tải địa điểm:', error);
                listContainer.innerHTML = '<div style="padding: 20px; text-align: center; color: #ff8a8a;">Lỗi kết nối server.</div>';
            }
        }
        // GỌI API TÍNH TOÁN NỘI TỈNH
        async function calculateNoiTinhRoute() {
            const checkedBoxes = document.querySelectorAll('.location-checkbox:checked');

            if (checkedBoxes.length < 2) {
                showError("Vui lòng chọn ít nhất 2 địa điểm."); // Dùng hàm showError
                return;
            }

            // Lấy ra các object LocationDto đầy đủ
            const selectedLocationIds = Array.from(checkedBoxes).map(cb => parseInt(cb.value));
            const selectedLocations = allLocations.filter(loc => selectedLocationIds.includes(loc.id));

            // Hiển thị loading, ẩn kết quả cũ
            const loadingEl = document.getElementById('loadingSpinner');
            const resultsEl = document.getElementById('resultsContent');
            const initialEl = document.getElementById('initialMessage');
            if (loadingEl) loadingEl.style.display = 'flex';
            if (resultsEl) resultsEl.style.display = 'none';
            if (initialEl) initialEl.style.display = 'none';

            try {
                const response = await fetch('/UngDung/CalculateNoiTinhRoute', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json; charset=utf-8' },
                    body: JSON.stringify({ selectedLocations: selectedLocations }) // Gửi đi danh sách object
                });

                const result = await response.json();

                if (result.success) {
                    displayResults(result);
                    document.getElementById('resultsContent').style.display = 'block';
                } else {
                    showError('Lỗi tính toán: ' + result.message);
                    document.getElementById('initialMessage').style.display = 'flex';
                }
            } catch (error) {
                showError('Lỗi kết nối với server: ' + error.message);
                document.getElementById('initialMessage').style.display = 'flex';
            } finally {
                if (loadingEl) loadingEl.style.display = 'none';
            }
        }


        // HIỂN THỊ KẾT QUẢ
        function displayResults(data) {
            const prim = data.primResult || {};
            const kruskal = data.kruskalResult || {};
            const optimal = data.optimalRoute || {};
            const comp = data.comparison || {};

            // Cập nhật thông tin tối ưu
            document.getElementById('optimalAlgorithm').textContent = optimal.algorithmName || '-';
            document.getElementById('optimalCost').textContent = (optimal.totalCost || 0).toLocaleString('vi-VN');
            document.getElementById('optimalDistance').textContent = (optimal.totalDistance || 0).toLocaleString('vi-VN');
            document.getElementById('optimalTime').textContent = (optimal.executionTime || 0).toFixed(3);

            // Tuyến đường
            const routeNames = Array.isArray(optimal.routeNames) ? optimal.routeNames.join(' → ') : '-';
            document.getElementById('routePath').textContent = routeNames;

            // Cập nhật bảng so sánh
            document.getElementById('primCostVal').textContent = (prim.totalCost || 0).toLocaleString('vi-VN');
            document.getElementById('kruskalCostVal').textContent = (kruskal.totalCost || 0).toLocaleString('vi-VN');
            document.getElementById('costDiff').textContent = (comp.costDifference || 0).toLocaleString('vi-VN');

            document.getElementById('primTimeVal').textContent = (prim.executionTime || 0).toFixed(3);
            document.getElementById('kruskalTimeVal').textContent = (kruskal.executionTime || 0).toFixed(3);
            document.getElementById('timeDiff').textContent = (comp.timeDifference || 0).toFixed(3);

            document.getElementById('primOpsVal').textContent = prim.operationCount || 0;
            document.getElementById('kruskalOpsVal').textContent = kruskal.operationCount || 0;
            document.getElementById('opsDiff').textContent = comp.operationDifference || 0;

            document.getElementById('primEdgesVal').textContent = prim.edgeCount || 0;
            document.getElementById('kruskalEdgesVal').textContent = kruskal.edgeCount || 0;

            // Hiển thị thông báo
            const messageBox = document.getElementById('messageBox');
            messageBox.innerHTML = `
                            <div class="success-message">
                                <i class="fas fa-check-circle"></i>
                                <span>Tuyến tối ưu được tìm thấy bằng <strong>${optimal.algorithmName}</strong> với chi phí <strong>${(optimal.totalCost || 0).toLocaleString('vi-VN')}</strong> VNĐ</span>
                            </div>
                        `;

            // Hiển thị danh sách cạnh
            displayEdgesList(optimal.edges);

            // Vẽ biểu đồ
            drawCharts(prim, kruskal);
        }

        // HIỂN THỊ DANH SÁCH CẠNH
        function displayEdgesList(edges) {
            const edgesListEl = document.getElementById('edgesList');

            if (!edges || !Array.isArray(edges) || edges.length === 0) {
                edgesListEl.innerHTML = '<div style="color: var(--text-muted); padding: 10px;">Không có cạnh</div>';
                return;
            }

            edgesListEl.innerHTML = edges.map((edge, idx) => `
                            <div class="edge-item">
                                <strong>#${idx + 1}</strong> ${edge.fromName || 'N/A'} ↔ ${edge.toName || 'N/A'}
                                <br/>
                                <small>
                                    Khoảng cách: <strong>${(edge.distance || 0).toLocaleString('vi-VN')}</strong> km |
                                    Chi phí: <strong>${(edge.cost || 0).toLocaleString('vi-VN')}</strong> VNĐ
                                </small>
                            </div>
                        `).join('');
        }

        // VẼ BIỂU ĐỒ
        function drawCharts(prim, kruskal) {
            // Xóa các biểu đồ cũ
            Object.values(charts).forEach(chart => {
                if (chart && typeof chart.destroy === 'function') {
                    chart.destroy();
                }
            });
            charts = {};

            // UI NOTE: Cập nhật màu chart cho phù hợp theme Nâu / Đỏ
            const primColor = '#8B705C';     // --accent-primary (Nâu)
            const kruskalColor = '#D95B5B';  // --accent-secondary (Đỏ)

            // Cập nhật màu text của Chart.js cho nền tối
            Chart.defaults.color = 'var(--text-on-dark)';
            Chart.defaults.borderColor = 'var(--border-color)';

            // Biểu đồ Chi Phí
            const costCtx = document.getElementById('costChart');
            if (costCtx) {
                charts.costChart = new Chart(costCtx.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: ['Prim', 'Kruskal'],
                        datasets: [{
                            label: 'Chi phí (VNĐ)',
                            data: [prim.totalCost || 0, kruskal.totalCost || 0],
                            backgroundColor: [primColor, kruskalColor],
                            borderRadius: 8
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: v => v.toLocaleString('vi-VN'),
                                    color: 'var(--text-muted)' // Màu trục Y
                                }
                            },
                            x: { ticks: { color: 'var(--text-on-dark)' } } // Màu trục X
                        },
                        plugins: { legend: { display: false } }
                    }
                });
            }

            // Biểu đồ Thời Gian
            const timeCtx = document.getElementById('timeChart');
            if (timeCtx) {
                charts.timeChart = new Chart(timeCtx.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: ['Prim', 'Kruskal'],
                        datasets: [{

                            label: 'Thời gian (ms)',
                            data: [prim.executionTime || 0, kruskal.executionTime || 0],
                            backgroundColor: ['#10b981', '#f59e0b'], // Xanh lá / Vàng
                            borderRadius: 8
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: { beginAtZero: true, ticks: { color: 'var(--text-muted)' } },
                            x: { ticks: { color: 'var(--text-on-dark)' } }
                        },
                        plugins: { legend: { display: false } }
                    }
                });
            }

            // Biểu đồ Số Phép Toán
            const opsCtx = document.getElementById('operationsChart');
            if (opsCtx) {
                charts.operationsChart = new Chart(opsCtx.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: ['Prim', 'Kruskal'],
                        datasets: [{
                            label: 'Số phép toán',
                            data: [prim.operationCount || 0, kruskal.operationCount || 0],
                            backgroundColor: [primColor, kruskalColor],
                            borderRadius: 8
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: { beginAtZero: true, ticks: { color: 'var(--text-muted)' } },
                            x: { ticks: { color: 'var(--text-on-dark)' } }
                        },
                        plugins: { legend: { display: false } }
                    }
                });
            }

            // Biểu đồ Số Cạnh
            const edgesCtx = document.getElementById('edgesChart');
            if (edgesCtx) {
                charts.edgesChart = new Chart(edgesCtx.getContext('2d'), {
                    type: 'doughnut',
                    data: {
                        labels: ['Prim', 'Kruskal'],
                        datasets: [{
                            data: [prim.edgeCount || 0, kruskal.edgeCount || 0],
                            backgroundColor: [primColor, kruskalColor],
                            borderColor: 'var(--bg-main)', // Nền chart
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: { color: 'var(--text-on-dark)' } // Màu chữ legend
                            }
                        }
                    }
                });
            }
        }

        // HIỂN THỊ LỖI
        function showError(message) {
            const messageBox = document.getElementById('messageBox');
            if (messageBox) {
                messageBox.innerHTML = `
                                <div class="error-message">
                                    <i class="fas fa-exclamation-circle"></i>
                                    <span>${message}</span>
                                </div>
                            `;
            } else {
                alert(message);
            }
        }


        // Hàm init() đã được gọi ở đầu
    </script>
}